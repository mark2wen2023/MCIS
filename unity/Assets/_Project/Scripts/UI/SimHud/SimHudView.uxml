<?xml version="1.0" encoding="utf-8"?>
<ui:UXML
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ui="UnityEngine.UIElements"
    xmlns:hud="Mcis.UI.SimHud"
    xmlns:map="Mcis.UI.MiniMap"
    xsi:noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd">

    <Style src="../Common/ThemeVariables.uss" />
    <Style src="NavHud.uss" />
    <Style src="TimelineBar.uss" />
    <Style src="../MiniMap/MiniMap.uss" />
    <Style src="SimHudView.uss" />

    <ui:VisualElement name="sim-hud-screen" class="sim-hud-screen" picking-mode="Ignore">
        <!-- 顶部浮层：左/中 NavHud + 右侧 2D 小地图 -->
        <ui:VisualElement name="sim-hud-top-bar" class="sim-hud-top-bar" picking-mode="Ignore">
            <hud:NavHud name="nav-hud" class="sim-hud-nav-region" />

            <ui:VisualElement name="sim-hud-right-region" class="sim-hud-right-region">
                <ui:VisualElement name="minimap-box" class="minimap-box">
                    <ui:VisualElement class="minimap-header">
                        <ui:Label text="2D 全局航迹小地图 (MiniMap)" class="minimap-title" />
                        <ui:Label text="点击定位 · 滚轮缩放" class="minimap-hint mcis-mono" />
                    </ui:VisualElement>

                    <map:MiniMapElement name="minimap-canvas" class="minimap-canvas" />

                    <ui:VisualElement class="minimap-footer">
                        <ui:Label name="minimap-scale-label" text="比例尺: 自动适配" class="minimap-scale-label mcis-mono" />
                        <ui:Button name="btn-minimap-fit" text="⌖ 全景" class="mcis-btn minimap-fit-btn" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- 底部浮层：时间轴与倍速控制坞 -->
        <ui:VisualElement name="sim-hud-bottom-bar" class="sim-hud-bottom-bar">
            <hud:TimelineBar name="timeline-bar" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
