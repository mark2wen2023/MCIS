/* ==========================================================================
   MiniMap 样式表 (MiniMap.uss)
   ECDIS 风格 2D 矢量海图小地图面板与画布样式，对齐 prototype #sim
   ========================================================================== */

.minimap-box {
    width: 268px;
    background-color: var(--bg-glass);
    border-color: var(--border-glass);
    border-width: 1px;
    border-radius: var(--radius-md);
    padding: 8px 10px;
    flex-direction: column;
}

.minimap-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 6px;
}

.minimap-title {
    font-size: 11px;
    -unity-font-style: bold;
    color: var(--color-primary);
}

.minimap-hint {
    font-size: 10px;
    color: var(--text-sec);
}

.minimap-canvas {
    width: 100%;
    height: 172px;
    min-width: 180px;
    min-height: 140px;
    background-color: var(--bg-minimap);
    border-color: var(--border-glass);
    border-width: 1px;
    border-radius: var(--radius-sm);
    overflow: hidden;
}

.minimap-footer {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-top: 5px;
}

.minimap-scale-label {
    font-size: 10px;
    color: var(--text-sec);
}

.minimap-fit-btn {
    padding: 2px 6px;
    font-size: 10px;
}
