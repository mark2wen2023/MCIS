+        [Fact]
+        public void D08_DangerStages_ProgressWithoutSplittingLockedSituation()
+        {
+            // TCPA 700→10 s，DCPA=0；340 s 进入紧迫、640 s 进入紧迫危险。
+            var report = Analyze(Linear(0, 0, 0, 5, 690), Linear(0, 7000, 180, 5, 690));
