        /// <summary>一海里对应的米数（1852.0 m）。</summary>
        public const double MetersPerNm = 1852.0;

        /// <summary>一节对应的米每秒（1852.0 / 3600.0 m/s）。</summary>
        public const double MpsPerKnot = 1852.0 / 3600.0;

