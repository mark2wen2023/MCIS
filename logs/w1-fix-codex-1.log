using System;
using System.Collections.Generic;
using Mcis.Core;
using Mcis.Domain.Common;
using Mcis.Domain.Models;

namespace Mcis.Domain.Colreg
{
    /// <summary>按碰撞危险、互见条件与相对几何确定的会遇局面。</summary>
    public enum EncounterSituation
    {
        /// <summary>未达到碰撞危险判据。</summary>
        NoCollisionRisk,
        /// <summary>对遇。</summary>
        HeadOn,
        /// <summary>交叉。</summary>
        Crossing,
        /// <summary>追越。</summary>
        Overtaking,
        /// <summary>能见度不良或未互见。</summary>
        RestrictedVisibility,
        /// <summary>狭水道；返修 API 骨架，尚未接入判定。</summary>
        NarrowChannel,
        /// <summary>适配层可将 DangerStages 中紧迫危险时段映射为此契约局面；会遇时间带保留原会遇类型。</summary>
        ImmediateDanger,
        /// <summary>碰撞后；返修 API 骨架。</summary>
        PostCollision,
        /// <summary>无法确定；返修 API 骨架。</summary>
        Undetermined
    }

    /// <summary>本次技术分析中的行动角色。</summary>
    public enum TrafficRole
    {
        /// <summary>本时段无让路或直航划分。</summary>
        None,
        /// <summary>让路船。</summary>
        GiveWay,
        /// <summary>直航船。</summary>
        StandOn,
        /// <summary>双方均有行动义务。</summary>
        BothActionRequired
    }

    /// <summary>逐条核查状态。</summary>
    public enum RuleCheckStatus
    {
        /// <summary>满足本项确定性技术判据。</summary>
        Satisfied,
        /// <summary>不满足本项确定性技术判据。</summary>
        NotSatisfied,
        /// <summary>不适用或缺少判断所需资料。</summary>
        NotApplicable,
        /// <summary>仅有部分条件得到满足或证实。</summary>
        Partial,
        /// <summary>需结合补充资料人工研判；返修 API 骨架。</summary>
        NeedsReview,
        /// <summary>现有资料不能评估；返修 API 骨架。</summary>
        NotAssessable
    }

    /// <summary>本阶段规则标识。</summary>
    public enum ColregRuleId
    {
        /// <summary>避免碰撞的行动。</summary>
        R8,
        /// <summary>狭水道。</summary>
        R9,
        /// <summary>追越。</summary>
        R13,
        /// <summary>对遇。</summary>
        R14,
        /// <summary>交叉相遇。</summary>
        R15,
        /// <summary>让路船的行动。</summary>
        R16,
        /// <summary>直航船的行动。</summary>
        R17,
        /// <summary>能见度不良时的行动。</summary>
        R19,
        /// <summary>瞭望；返修 API 骨架，尚未加入规则目录和判定。</summary>
        R5,
        /// <summary>安全航速；返修 API 骨架。</summary>
        R6,
        /// <summary>碰撞危险判断；返修 API 骨架。</summary>
        R7,
        /// <summary>操纵、警告和能见度不良声号；返修 API 骨架。</summary>
        R34_35
    }

    /// <summary>危险阶段；阶段一仅声明 API，尚未接入计算。</summary>
    public enum ColregDangerStage
    {
        None,
        CollisionRisk,
        CloseQuarters,
        ImmediateDanger
    }

    /// <summary>核查项人工确认状态；默认值为草稿。</summary>
    public enum ColregReviewStatus
    {
        Draft,
        Confirmed,
        Rejected,
        Modified
    }

    /// <summary>显式互见状态样本；阶段一只持有数据，尚未接入阶梯保持和时间带切分。</summary>
