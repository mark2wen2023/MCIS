            "incidentTimeUtc": "2026-05-18T06:24:00Z", "incidentLocation": {"latDeg": 21.7, "lonDeg": 113.7}, "accidentType": "Collision"}
    vessels = [{"vesselId": "lily", "name": "Lily", "imoNumber": "IMO 9074729", "displacementTons": 24500}]
