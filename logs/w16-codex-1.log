openapi: 3.1.0
info:
  title: MCIS 调查业务服务 REST 接口
  version: 0.1.0
  description: |
    模块③（Python 服务）对 ②Unity 与 ④网页工作台提供的本地接口。只监听 127.0.0.1:8765。
    - 数据结构见 schemas/*.schema.json（JSON Schema 2020-12），字段与 C# 计算核心对齐（camelCase）。
    - 角色与操作者：请求头 X-MCIS-Role（默认 Investigator）、X-MCIS-Operator（URL 编码）。脱敏网关按角色在出口处理。
    - 所有写操作写只追加审计（GET /cases/{caseId}/audit）；例外：PUT /sim/state 是瞬态遥测，不入审计。
    - 错误体统一为 {code, message, detail?}（schemas/common.schema.json#/$defs/problem）。
    - 冒号路径（如 /evidence:verify-all）是“自定义动作”，与资源路径并列，不是路径参数。
servers:
  - url: http://127.0.0.1:8765
security: []
tags:
  - { name: unity, description: Unity 主仿真需要的接口（取案件、取时间线/航迹、推送 SimTime、取跳转命令） }
  - { name: cases }
  - { name: evidence }
  - { name: timeline }
  - { name: interviews }
  - { name: recommendations }
  - { name: colreg }
  - { name: audit }
  - { name: redaction }
  - { name: agents }
  - { name: sim }
  - { name: package }

components:
  parameters:
    caseId: { name: caseId, in: path, required: true, schema: { type: string }, example: CASE-2026-DEMO-LILY-MARY }
    evidenceId: { name: evidenceId, in: path, required: true, schema: { type: string, pattern: '^EV-[0-9]{3,}$' } }
    recordId: { name: recordId, in: path, required: true, schema: { type: string, pattern: '^IR-[0-9]{2,}$' } }
    statementId: { name: statementId, in: path, required: true, schema: { type: string } }
    recId: { name: recId, in: path, required: true, schema: { type: string, pattern: '^SR-[0-9]{4}-[0-9]{2,}$' } }
    roundNo: { name: roundNo, in: path, required: true, schema: { type: integer, minimum: 1 } }
    role: { name: X-MCIS-Role, in: header, required: false, schema: { $ref: 'schemas/common.schema.json#/$defs/role' } }
    operator: { name: X-MCIS-Operator, in: header, required: false, schema: { type: string } }
  responses:
    Problem:
      description: 错误（400/403/404/409/422/501/502/503）
      content: { application/json: { schema: { $ref: 'schemas/common.schema.json#/$defs/problem' } } }
  schemas:
    Case: { $ref: 'schemas/case.schema.json' }
    Vessel: { $ref: 'schemas/vessel.schema.json' }
    TrackPoint: { $ref: 'schemas/track-point.schema.json' }
    EvidenceItem: { $ref: 'schemas/evidence-item.schema.json' }
    CustodyEvent: { $ref: 'schemas/custody-event.schema.json' }
    TimelineEvent: { $ref: 'schemas/timeline-event.schema.json' }
    Conflict: { $ref: 'schemas/conflict.schema.json' }
    Interview: { $ref: 'schemas/interview.schema.json' }
    Colreg: { $ref: 'schemas/colreg.schema.json' }
    Recommendation: { $ref: 'schemas/recommendation.schema.json' }
    ConsultationRound: { $ref: 'schemas/consultation-round.schema.json' }
    AuditEvent: { $ref: 'schemas/audit-event.schema.json' }
    AgentDraft: { $ref: 'schemas/agent-draft.schema.json' }
    AccessPolicy: { $ref: 'schemas/access-policy.schema.json' }
    SimState: { $ref: 'schemas/sim-state.schema.json#/$defs/state' }
    SimCommand: { $ref: 'schemas/sim-state.schema.json#/$defs/command' }
    CpaRequest: { $ref: 'schemas/core-cpa.schema.json#/$defs/request' }
    CpaResult: { $ref: 'schemas/core-cpa.schema.json#/$defs/result' }
    IntegrityReport:
      type: object
      description: 与 C# IntegrityCheckReport 对应
      properties:
        isValid: { type: boolean }
        tamperedFiles: { type: array, items: { type: string } }
        missingFiles: { type: array, items: { type: string } }
        extraFiles: { type: array, items: { type: string } }

paths:
  /api/v1/health:
    get: { tags: [cases], summary: 健康检查, responses: { '200': { description: ok } } }

  /api/v1/cases:
    get:
      tags: [cases, unity]
      summary: 案件列表（大厅卡片）
      responses: { '200': { description: 摘要列表 } }
    post:
      tags: [cases]
      summary: 新建案件（审计 case.create）
      requestBody: { required: true, content: { application/json: { schema: { $ref: '#/components/schemas/Case' } } } }
      responses: { '201': { description: 已创建 }, '409': { $ref: '#/components/responses/Problem' } }
  /api/v1/cases/{caseId}:
    parameters: [{ $ref: '#/components/parameters/caseId' }]
    get:
      tags: [cases, unity]
      summary: 取案件（Unity 启动时调用；caseEpochUtc 决定 SimTime 0 点）
      responses: { '200': { description: 案件, content: { application/json: { schema: { $ref: '#/components/schemas/Case' } } } } }
  /api/v1/cases/{caseId}/overview:
    parameters: [{ $ref: '#/components/parameters/caseId' }]
    get: { tags: [cases], summary: 案件概览计数, responses: { '200': { description: ok } } }
  /api/v1/cases/{caseId}/vessels:
    parameters: [{ $ref: '#/components/parameters/caseId' }]
    get:
      tags: [cases, unity]
      summary: 船舶静态参数
      responses: { '200': { description: ok, content: { application/json: { schema: { type: array, items: { $ref: '#/components/schemas/Vessel' } } } } } }
  /api/v1/cases/{caseId}/tracks:
      responses:
        '200': { description: ok }
        '422': { $ref: '#/components/responses/Problem' }

  /api/v1/cases/{caseId}/audit:
    parameters:
      - { $ref: '#/components/parameters/caseId' }
      - { name: category, in: query, schema: { type: string } }
      - { name: entityId, in: query, schema: { type: string } }
      - { name: action, in: query, schema: { type: string }, description: "如 custody.access / safetyrec.transition" }
      - { name: entityType, in: query, schema: { type: string } }
      - { name: afterSeq, in: query, schema: { type: integer, default: 0 } }
      - { name: limit, in: query, schema: { type: integer, default: 200 } }
      - { name: order, in: query, schema: { type: string, enum: [asc, desc] } }
    get:
      tags: [audit]
      summary: 审计流（只追加）
      responses: { '200': { description: ok, content: { application/json: { schema: { type: array, items: { $ref: '#/components/schemas/AuditEvent' } } } } } }
  /api/v1/cases/{caseId}/audit:verify:
    parameters: [{ $ref: '#/components/parameters/caseId' }]
    get: { tags: [audit], summary: 校验审计 prev 哈希链, responses: { '200': { description: '{valid, count, brokenAt}' } } }

  /api/v1/cases/{caseId}/access-policy:
    parameters: [{ $ref: '#/components/parameters/caseId' }]
    get:
      tags: [redaction]
      summary: 权限矩阵与字段脱敏规则
      responses: { '200': { description: ok, content: { application/json: { schema: { $ref: '#/components/schemas/AccessPolicy' } } } } }
    put: { tags: [redaction], summary: 修改策略（仅首席调查官，审计）, responses: { '200': { description: ok } } }
  /api/v1/cases/{caseId}/redaction/preview:
    parameters: [{ $ref: '#/components/parameters/caseId' }]
    post: { tags: [redaction], summary: 导出预览：某笔录在指定角色下的脱敏结果, responses: { '200': { description: ok } } }

  /api/v1/agents:
    get: { tags: [agents], summary: 六个智能体登记表（骨架：status=not_connected）, responses: { '200': { description: ok } } }
  /api/v1/cases/{caseId}/agents/drafts:
    parameters: [{ $ref: '#/components/parameters/caseId' }, { name: status, in: query, schema: { type: string } }]
    get:
      tags: [agents]
      summary: 人工确认队列
      responses: { '200': { description: ok, content: { application/json: { schema: { type: array, items: { $ref: '#/components/schemas/AgentDraft' } } } } } }
    post: { tags: [agents], summary: 智能体提交草稿（必须带 citations）, responses: { '201': { description: ok } } }
  /api/v1/cases/{caseId}/agents/drafts/{draftId}/review:
    parameters: [{ $ref: '#/components/parameters/caseId' }, { name: draftId, in: path, required: true, schema: { type: string } }]
    post: { tags: [agents], summary: 调查员确认/修改/驳回（确认后写回目标实体）, responses: { '200': { description: ok } } }
  /api/v1/cases/{caseId}/agents/inputs/interviews/{recordId}:
    parameters: [{ $ref: '#/components/parameters/caseId' }, { $ref: '#/components/parameters/recordId' }]
    get: { tags: [agents], summary: 智能体可见的笔录（强制按 AgentService 脱敏）, responses: { '200': { description: ok } } }

  /api/v1/cases/{caseId}/sim/state:
    parameters: [{ $ref: '#/components/parameters/caseId' }]
    get:
      tags: [sim, unity]
      summary: 当前回放状态（网页读）
      responses: { '200': { description: ok, content: { application/json: { schema: { $ref: '#/components/schemas/SimState' } } } } }
    put:
      tags: [sim, unity]
      summary: Unity 推送当前 SimTime（≤10 Hz，瞬态，不入审计）
      requestBody: { required: true, content: { application/json: { schema: { type: object, required: [simTimeSec], properties: { simTimeSec: { type: number }, playing: { type: boolean }, rate: { type: number }, source: { type: string } } } } } }
      responses: { '200': { description: SimState } }
  /api/v1/cases/{caseId}/sim/seek:
    parameters: [{ $ref: '#/components/parameters/caseId' }]
    post:
      tags: [sim, unity]
      summary: 请求跳转到时刻（网页→Unity；入审计）
      requestBody: { required: true, content: { application/json: { schema: { type: object, required: [simTimeSec], properties: { simTimeSec: { type: number }, reason: { type: string } } } } } }
      responses: { '201': { description: SimCommand } }
  /api/v1/cases/{caseId}/sim/commands:
    parameters: [{ $ref: '#/components/parameters/caseId' }, { name: afterSeq, in: query, schema: { type: integer, default: 0 } }]
    get:
      tags: [sim, unity]
      summary: Unity 轮询回放命令（seek/play/pause/setRate/focusVessel）
      responses: { '200': { description: '{commands: SimCommand[], lastSeq}' } }
    post: { tags: [sim], summary: 发出通用回放命令, responses: { '201': { description: SimCommand } } }

  /api/v1/cases/{caseId}/export:
    parameters: [{ $ref: '#/components/parameters/caseId' }]
    get: { tags: [package, unity], summary: 导出 .mcase（ZIP + manifest SHA-256；审计 package.export）, responses: { '200': { description: application/zip } } }
  /api/v1/cases:import:
    post:
      tags: [package, unity]
      summary: 导入 .mcase（application/zip 原始字节或 multipart file；校验 manifest 与哈希链）
      responses: { '201': { description: '{caseId, integrity, imported}' }, '409': { $ref: '#/components/responses/Problem' }, '422': { $ref: '#/components/responses/Problem' } }
  /api/v1/packages:verify:
    post: { tags: [package], summary: 只校验不导入, responses: { '200': { description: ok, content: { application/json: { schema: { $ref: '#/components/schemas/IntegrityReport' } } } } } }

