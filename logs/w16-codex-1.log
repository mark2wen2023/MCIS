function html(extra: Partial<Parameters<typeof ColregView>[0]> = {}) {
  return renderToStaticMarkup(createElement(ColregView, {
    caseDef, vessels, analysis, evidence, audit: [],
    selectedId: 'CK-01', onSelect: () => {}, onReview: () => {},
    cases: [
