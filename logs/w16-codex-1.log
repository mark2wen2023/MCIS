@router.patch("/cases/{case_id}/colreg/checks/{check_id}")
def review_check(case_id: str, check_id: str, body: CheckReview, runId: str | None = None,
                 ctx: Ctx = CtxDep) -> dict[str, Any]:
    """确认 / 驳回 / 修改核查项（默认当前版本，可用 runId 指定）；每一步写审计（操作人、时间、原值、新值、理由全文）。"""
    label = review_util.ACTION_LABEL[body.action]
    with ctx.db.session() as s:
        cases.load_case(s, case_id)
        require(ctx, s, case_id, "colreg", write=True)
        idx, run = runs.get_run(s, case_id, runId)
        chk = next((c for c in run["analysis"].get("checks", []) if c["checkId"] == check_id), None)
        if chk is None:
            raise problem(404, "NOT_FOUND", f"核查项不存在：{check_id}")
        review_util.validate(body, chk)
        ev_ids = evidence_refs.require_registered(s, case_id, body.evidenceIds)
        before = review_util.snapshot(chk)
        ann = run.setdefault("annotations", {}).setdefault("checks", {}).setdefault(check_id, {})
        utc = iso(now_utc())
        entry = review_util.apply(chk, ann, body, operator=ctx.operator, utc=utc, evidence_ids=ev_ids)
        contracts.validate("colreg", run["analysis"])
        row = audit.append(s, case_id=case_id, operator=ctx.operator, role=ctx.role, action="colreg.review", category="Colreg",
                           command=f"{label}规则核查项 {check_id}（{chk['rule']}）· 版本 {run['runId']}", before=before,
                           after=review_util.after_summary(chk, body.clean_reason),
                           entity_type="colregCheck", entity_id=check_id, utc=utc, reason=body.clean_reason)
        entry["auditSeq"] = row.seq
        entry["runId"] = run["runId"]
        runs.save_run(s, case_id, idx, run)
        return chk


@router.get("/cases/{case_id}/colreg/checks/{check_id}/reviews", **EXT)
def check_reviews(case_id: str, check_id: str, runId: str | None = None, ctx: Ctx = CtxDep) -> dict[str, Any]:
    """某版本某核查项的复核历史（理由全文，不截断）。"""
    with ctx.db.session() as s:
        cases.load_case(s, case_id)
        require(ctx, s, case_id, "colreg")
        _, run = runs.get_run(s, case_id, runId)
        if not any(c["checkId"] == check_id for c in run["analysis"].get("checks", [])):
            raise problem(404, "NOT_FOUND", f"核查项不存在：{check_id}")
        ann = (run.get("annotations") or {}).get("checks", {}).get(check_id) or {}
        return {"caseId": case_id, "runId": run["runId"], "checkId": check_id,
                "engineVerdict": ann.get("engineVerdict"), "reviewedBy": ann.get("reviewedBy"),
                "reviewedAt": ann.get("reviewedAt"), "history": ann.get("history") or []}
"""核查项人工复核（W6.1 裁定 2/3/4/5/7）。

请求体按 openapi：{action: confirm|dismiss|modify, verdict?, reason?, evidenceIds?}。
兼容 W6 旧写法 {reviewStatus: Confirmed|Rejected|Modified, note?}（映射到 action/reason，规则相同）。

- confirm/dismiss 带 verdict → 422 colreg_review_verdict_not_allowed（不静默忽略）
- dismiss/modify 理由必填（空白、全角空格都算空）→ 422 colreg_review_reason_required
- modify 缺 verdict → 422 colreg_review_verdict_required；与当前判定相同 → 422 colreg_review_no_change
- modify 可改成 Undetermined（须填理由）
- confirm：source 不变，只记 reviewStatus=Confirmed、reviewedBy、reviewedAt
- modify：source=Investigator，注解里保留 engineVerdict（第一次修改前的原判定）
- 理由全文保存在版本注解与审计行的 reason 扩展键里，不截断；审计 after 只是显示用摘要
"""
from __future__ import annotations

from typing import Any, Literal

from pydantic import BaseModel, model_validator

from ..common.context import problem

Verdict = Literal["Complies", "Partial", "NotComplied", "NotApplicable", "NeedsReview", "NotAssessable", "Undetermined"]
ACTION_STATUS = {"confirm": "Confirmed", "dismiss": "Rejected", "modify": "Modified"}
STATUS_ACTION = {v: k for k, v in ACTION_STATUS.items()}
ACTION_LABEL = {"confirm": "确认", "dismiss": "驳回", "modify": "修改"}


class CheckReview(BaseModel):
    action: Literal["confirm", "dismiss", "modify"] | None = None
    verdict: Verdict | None = None
    reason: str | None = None
    evidenceIds: list[str] | None = None
    # W6 旧写法（已废弃，保留兼容）
    reviewStatus: Literal["Confirmed", "Rejected", "Modified"] | None = None
    note: str | None = None

    @model_validator(mode="after")
    def _normalize(self) -> "CheckReview":
        if self.action is None and self.reviewStatus is None:
            raise ValueError("需要 action（confirm / dismiss / modify）")
        if self.action and self.reviewStatus and STATUS_ACTION[self.reviewStatus] != self.action:
            raise ValueError("action 与 reviewStatus 不一致")
        if self.action is None:
            self.action = STATUS_ACTION[self.reviewStatus]  # type: ignore[index]
        if self.reason is None and self.note is not None:
            self.reason = self.note
        elif self.reason is not None and self.note is not None and self.reason != self.note:
            raise ValueError("reason 与 note 不一致（note 为旧字段名）")
        return self

    @property
    def status(self) -> str:
        return ACTION_STATUS[self.action]  # type: ignore[index]

    @property
    def clean_reason(self) -> str:
        # str.strip() 已涵盖 \t \n 与全角空格 \u3000
        return (self.reason or "").strip()


def validate(body: CheckReview, chk: dict[str, Any]) -> None:
    """只做与数据相关的校验；不改任何东西。证据登记由调用方用 evidence_refs 校验。"""
    act = body.action
    if act in ("confirm", "dismiss") and body.verdict is not None:
        raise problem(422, "colreg_review_verdict_not_allowed", f"{ACTION_LABEL[act]}时不能传 verdict；要改判定请用 modify")
    if act in ("dismiss", "modify") and not body.clean_reason:
        raise problem(422, "colreg_review_reason_required", "驳回或修改须填写理由")
    if act == "modify":
        if body.verdict is None:
            raise problem(422, "colreg_review_verdict_required", "修改须给出新的判定")
        if body.verdict == chk.get("verdict"):
            raise problem(422, "colreg_review_no_change", f"新判定与当前判定相同（{body.verdict}），不构成修改")


def snapshot(chk: dict[str, Any]) -> str:
    return f"verdict={chk.get('verdict')}; reviewStatus={chk.get('reviewStatus') or 'Draft'}; source={chk.get('source') or ''}"


def after_summary(chk: dict[str, Any], reason: str) -> str:
    """显示用摘要（审计层可能截断到 400 字）；理由全文另存 reason 扩展键。"""
    base = snapshot(chk)
    return f"{base}; reason={reason}" if reason else base


def apply(chk: dict[str, Any], ann: dict[str, Any], body: CheckReview, *, operator: str, utc: str,
          evidence_ids: list[str]) -> dict[str, Any]:
    """改核查项（colreg.schema 内字段）与版本注解（schema 外字段）。返回本次历史记录。"""
    before_verdict = chk.get("verdict")
    before_source = chk.get("source")
    act = body.action
    chk["reviewStatus"] = body.status
    if act == "modify":
        ann.setdefault("engineVerdict", before_verdict)
        ann.setdefault("engineSource", before_source)
        chk["verdict"] = body.verdict
        chk["source"] = "Investigator"
        if body.evidenceIds is not None:
            chk["evidenceIds"] = list(evidence_ids)
    ann["reviewedBy"] = operator
    ann["reviewedAt"] = utc
    ann["lastAction"] = act
    ann["reason"] = body.clean_reason
    if act != "modify" and evidence_ids:
        ann["reviewEvidenceIds"] = list(evidence_ids)
    entry = {"action": act, "reviewStatus": body.status, "verdictBefore": before_verdict, "verdictAfter": chk.get("verdict"),
             "sourceBefore": before_source, "sourceAfter": chk.get("source"), "reason": body.clean_reason,
             "evidenceIds": list(evidence_ids), "operator": operator, "utc": utc}
    ann.setdefault("history", []).append(entry)
    return entry
"""证据编号校验：格式按共享 common.schema.json#/$defs/evidenceRef，登记状态按案件证据库（evidence.service）。

W6.1 裁定 5：未登记返回 422 evidence_not_registered。
"""
from __future__ import annotations

from typing import Any, Iterable

from sqlalchemy.orm import Session

from ..common import contracts
from ..common.context import problem
from ..evidence import service as ev


def registered_ids(s: Session, case_id: str) -> set[str]:
    return {e["evidenceId"] for e in ev.list_items(s, case_id)}


def require_registered(s: Session, case_id: str, ids: Iterable[str] | None, *, field: str = "evidenceIds") -> list[str]:
    """返回去重后保持顺序的编号列表；格式不对或未登记一律 422 evidence_not_registered。"""
    out: list[str] = []
    for x in ids or []:
        if x not in out:
            out.append(x)
    if not out:
        return out
    bad_format = [x for x in out if not isinstance(x, str) or contracts.errors("common#/$defs/evidenceRef", x)]
    known = registered_ids(s, case_id)
    missing = [x for x in out if x not in known and x not in bad_format]
    if bad_format or missing:
        raise problem(422, "evidence_not_registered", "证据编号未在本案件登记：" + "、".join(map(str, bad_format + missing)),
                      {"field": field, "unregistered": missing, "badFormat": bad_format})
    return out


def dangling(ids: Iterable[str] | None, known: set[str]) -> list[str]:
    return [x for x in ids or [] if x not in known]


def annotate_links(ids: Iterable[str] | None, known: set[str]) -> list[dict[str, Any]]:
    return [{"evidenceId": x, "registered": x in known} for x in ids or []]
from ..db import Base, DocMixin, table_args


class ColregAnalysisRow(DocMixin, Base):
    """key = 'current'：最近一次被采纳的 COLREG 分析（analysis/colreg.json）。"""

    __tablename__ = "colreg_analyses"
    __table_args__ = table_args("colreg_analyses")
"""COLREG 分析版本化（W6.1 裁定 9）。

存储（colreg_analyses 表，按 key 区分）：
- ``runs``           版本索引 {activeRunId, currentSha, runs:[meta…]}
- ``run:R-0001``     单个版本 {meta…, analysis: <colreg.schema 文档>, annotations: {bands, checks}}
- ``current``        当前激活版本的 analysis 镜像（GET /colreg、.mcase 导出读这里）

规则：每次 evaluate 新建一个版本并激活；旧版本（含种子与已做的复核）原样保留，可切换、可对比，永不覆盖。
首次访问时把已有的 ``current`` 收编为第 1 版（种子或初始）。``current`` 被外部（如 .mcase 导入）改写时，
按内容哈希发现并另存为新版本，而不是丢弃。
"""
from __future__ import annotations

import copy
import hashlib
import json
from typing import Any

from sqlalchemy.orm import Session

from ..common.context import problem
from ..common.timeutil import iso, now_utc
from ..db import get_doc, put_doc
from .models import ColregAnalysisRow
from .seed_annotations import seed_band_evidence

INDEX_KEY = "runs"
CURRENT_KEY = "current"
KIND_LABEL = {"Seed": "种子（报告整理）", "Initial": "初始", "RuleEngine": "规则引擎", "External": "外部导入"}


def _sha(doc: dict[str, Any] | None) -> str:
    return hashlib.sha256(json.dumps(doc or {}, ensure_ascii=False, sort_keys=True).encode("utf-8")).hexdigest()


def run_key(run_id: str) -> str:
    return f"run:{run_id}"


def _new_id(idx: dict[str, Any]) -> tuple[str, int]:
    n = max([r["version"] for r in idx["runs"]] or [0]) + 1
    return f"R-{n:04d}", n


def _kind_of(analysis: dict[str, Any]) -> str:
    checks = analysis.get("checks") or []
    if checks and all(c.get("source") == "Seed" for c in checks):
        return "Seed"
    if checks and any(c.get("source") == "RuleEngine" for c in checks):
        return "RuleEngine"
    return "Initial"


def _summary(analysis: dict[str, Any]) -> dict[str, Any]:
    checks = analysis.get("checks") or []
    reviewed = sum(1 for c in checks if (c.get("reviewStatus") or "Draft") != "Draft")
    return {"bandCount": len(analysis.get("bands") or []), "checkCount": len(checks), "reviewedCount": reviewed}


def _create(s: Session, case_id: str, idx: dict[str, Any], analysis: dict[str, Any], *, kind: str, created_by: str,
            band_evidence: dict[str, list[str]] | None = None, note: str = "", activate: bool = True) -> dict[str, Any]:
    run_id, version = _new_id(idx)
    meta = {"runId": run_id, "version": version, "kind": kind,
            "label": f"v{version} · {KIND_LABEL.get(kind, kind)}", "createdUtc": iso(now_utc()), "createdBy": created_by,
            "parentRunId": idx.get("activeRunId"), "engineVersion": analysis.get("engineVersion") or "", "note": note}
    bands = {b["bandId"]: {"evidenceIds": list((band_evidence or {}).get(b["bandId"], []))}
             for b in analysis.get("bands") or []}
    run = {**meta, "analysis": analysis, "annotations": {"bands": bands, "checks": {}}}
    put_doc(s, ColregAnalysisRow, case_id, run_key(run_id), run)
    idx["runs"].append(meta)
    if activate:
        idx["activeRunId"] = run_id
        put_doc(s, ColregAnalysisRow, case_id, CURRENT_KEY, analysis)
        idx["currentSha"] = _sha(analysis)
    put_doc(s, ColregAnalysisRow, case_id, INDEX_KEY, idx)
    return run


def ensure(s: Session, case_id: str, operator: str = "系统（版本收编）") -> dict[str, Any]:
    """返回版本索引；必要时收编现有 current。幂等。"""
    idx = get_doc(s, ColregAnalysisRow, case_id, INDEX_KEY)
    cur = get_doc(s, ColregAnalysisRow, case_id, CURRENT_KEY)
    if idx is None:
        idx = {"caseId": case_id, "activeRunId": None, "currentSha": None, "runs": []}
        if cur is None:
            put_doc(s, ColregAnalysisRow, case_id, INDEX_KEY, idx)
            return idx
        kind = _kind_of(cur)
        _create(s, case_id, idx, copy.deepcopy(cur), kind=kind, created_by=operator,
                band_evidence=seed_band_evidence(case_id) if kind == "Seed" else None,
                note="首次访问时由已有 current 收编")
        return idx
    if cur is not None and idx.get("currentSha") != _sha(cur):
        # current 被外部改写（如 .mcase 导入）：另存为新版本，不丢弃旧版本
        _create(s, case_id, idx, copy.deepcopy(cur), kind="External", created_by=operator,
                note="current 被外部改写，按内容另存")
    return idx


def get_run(s: Session, case_id: str, run_id: str | None) -> tuple[dict[str, Any], dict[str, Any]]:
    idx = ensure(s, case_id)
    rid = idx.get("activeRunId") if run_id in (None, "", "active") else run_id
    if not rid:
        raise problem(404, "colreg_run_not_found", "本案件还没有 COLREG 分析版本")
    run = get_doc(s, ColregAnalysisRow, case_id, run_key(rid))
    if run is None:
        raise problem(404, "colreg_run_not_found", f"COLREG 分析版本不存在：{rid}")
    return idx, run


def save_run(s: Session, case_id: str, idx: dict[str, Any], run: dict[str, Any]) -> None:
    """保存版本；若是激活版本，同时刷新 current 镜像。"""
    put_doc(s, ColregAnalysisRow, case_id, run_key(run["runId"]), run)
    if idx.get("activeRunId") == run["runId"]:
        put_doc(s, ColregAnalysisRow, case_id, CURRENT_KEY, run["analysis"])
        idx["currentSha"] = _sha(run["analysis"])
        put_doc(s, ColregAnalysisRow, case_id, INDEX_KEY, idx)


def add_engine_run(s: Session, case_id: str, analysis: dict[str, Any], *, created_by: str,
                   band_evidence_ids: list[str]) -> dict[str, Any]:
    idx = ensure(s, case_id)
    be = {b["bandId"]: list(band_evidence_ids) for b in analysis.get("bands") or []}
    return _create(s, case_id, idx, analysis, kind="RuleEngine", created_by=created_by, band_evidence=be,
                   note="规则引擎结果（Draft，需逐条复核）")


def activate(s: Session, case_id: str, run_id: str) -> tuple[dict[str, Any], dict[str, Any], str | None]:
    idx, run = get_run(s, case_id, run_id)
    prev = idx.get("activeRunId")
    idx["activeRunId"] = run["runId"]
    put_doc(s, ColregAnalysisRow, case_id, CURRENT_KEY, run["analysis"])
    idx["currentSha"] = _sha(run["analysis"])
    put_doc(s, ColregAnalysisRow, case_id, INDEX_KEY, idx)
    return idx, run, prev


def list_runs(s: Session, case_id: str) -> dict[str, Any]:
    idx = ensure(s, case_id)
    out = []
    for meta in idx["runs"]:
        run = get_doc(s, ColregAnalysisRow, case_id, run_key(meta["runId"])) or {}
        out.append({**meta, **_summary(run.get("analysis") or {}), "active": meta["runId"] == idx.get("activeRunId")})
    return {"caseId": case_id, "activeRunId": idx.get("activeRunId"), "runs": out}


def _match_key(c: dict[str, Any]) -> tuple[str, str]:
    return (str(c.get("rule")), str(c.get("vesselId")))


def compare(base: dict[str, Any], other: dict[str, Any]) -> dict[str, Any]:
    """按（规则, 船）+ 出现顺序配对两个版本的核查项；时间带按序号对齐。"""
    def grouped(run: dict[str, Any]) -> dict[tuple[str, str], list[dict[str, Any]]]:
        g: dict[tuple[str, str], list[dict[str, Any]]] = {}
        for c in run["analysis"].get("checks") or []:
            g.setdefault(_match_key(c), []).append(c)
        return g

    def brief(c: dict[str, Any] | None) -> dict[str, Any] | None:
        if c is None:
            return None
        return {"checkId": c["checkId"], "verdict": c["verdict"], "reviewStatus": c.get("reviewStatus") or "Draft",
                "source": c.get("source"), "title": c.get("title") or ""}

    ga, gb = grouped(base), grouped(other)
    keys = list(dict.fromkeys([*ga.keys(), *gb.keys()]))
    rows = []
    for k in keys:
        la, lb = ga.get(k, []), gb.get(k, [])
        for i in range(max(len(la), len(lb))):
            a = la[i] if i < len(la) else None
            b = lb[i] if i < len(lb) else None
            changed = a is None or b is None or a["verdict"] != b["verdict"]
            rows.append({"rule": k[0], "vesselId": k[1], "base": brief(a), "other": brief(b), "verdictChanged": changed})
    bands = []
    ba, bb = base["analysis"].get("bands") or [], other["analysis"].get("bands") or []
    for i in range(max(len(ba), len(bb))):
        a = ba[i] if i < len(ba) else None
        b = bb[i] if i < len(bb) else None
        pick = lambda x: None if x is None else {k: x.get(k) for k in ("bandId", "startTimeSec", "endTimeSec", "situation", "dangerStage", "giveWayVesselId", "standOnVesselId")}  # noqa: E731
        bands.append({"base": pick(a), "other": pick(b),
                      "changed": a is None or b is None or pick(a)["situation"] != pick(b)["situation"]
                      or pick(a)["dangerStage"] != pick(b)["dangerStage"]})
    return {"baseRunId": base["runId"], "otherRunId": other["runId"],
            "checks": rows, "bands": bands,
            "changedCheckCount": sum(1 for r in rows if r["verdictChanged"]),
            "changedBandCount": sum(1 for b in bands if b["changed"])}

