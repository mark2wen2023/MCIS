import { SERVICE_URL } from '../config'
import type { ColregDraftResult, GisisDocument, GisisValidation, Report, ReportAudit, ReportLanguage, ReportList, ReportSection, ReportTemplateId, ReportTemplateList, ReviewPayload } from './types'

/** 请求在调用时取身份，SSR 渲染纯展示组件时不访问 localStorage。 */
function identityHeaders(): Record<string, string> {
  let role = 'Investigator'
  let operator = '调查员 A'
  try {
    role = localStorage.getItem('mcis.role') || role
    operator = localStorage.getItem('mcis.operator') || operator
  } catch { /* 无浏览器存储时使用现有服务的演示身份。 */ }
  return { 'X-MCIS-Role': role, 'X-MCIS-Operator': encodeURIComponent(operator) }
}

export class ReportApiError extends Error {
  readonly status: number
  readonly code: string
  readonly detail: unknown
  constructor(status: number, code: string, message: string, detail: unknown) {
    super(`${code}：${message}`)
    this.status = status; this.code = code; this.detail = detail
  }
}

async function fetchReport(method: string, path: string, body?: unknown, signal?: AbortSignal): Promise<Response> {
  const headers = identityHeaders()
  if (body !== undefined) headers['Content-Type'] = 'application/json'
  const res = await fetch(`${SERVICE_URL.replace(/\/+$/, '')}/api/v1${path}`, { method, headers, body: body === undefined ? undefined : JSON.stringify(body), signal })
  if (!res.ok) {
    const data = await res.json().catch(() => ({})) as { code?: string; message?: string; detail?: unknown }
    throw new ReportApiError(res.status, data.code || `HTTP_${res.status}`, data.message || res.statusText, data.detail)
  }
  return res
}

async function request<T>(method: string, path: string, body?: unknown, signal?: AbortSignal): Promise<T> {
  return (await fetchReport(method, path, body, signal)).json() as Promise<T>
}

function casePath(caseId: string, path: string) { return `/cases/${encodeURIComponent(caseId)}${path}` }
function reportPath(caseId: string, reportId: string) { return casePath(caseId, `/reports/${encodeURIComponent(reportId)}`) }

export async function saveReportDownload(response: Response, fallback: string) {
  const disposition = response.headers.get('Content-Disposition') || ''
  const encoded = /filename\*=UTF-8''([^;]+)/i.exec(disposition)?.[1]
  const filename = encoded ? decodeURIComponent(encoded) : /filename="?([^";]+)"?/i.exec(disposition)?.[1] || fallback
  const url = URL.createObjectURL(await response.blob())
  const anchor = document.createElement('a')
  anchor.href = url; anchor.download = filename; anchor.click()
  window.setTimeout(() => URL.revokeObjectURL(url), 1000)
  return { filename, sha256: response.headers.get('X-Sha256') }
}

export const reportApi = {
  templates: (caseId: string, signal?: AbortSignal) => request<ReportTemplateList>('GET', `/report-templates?caseId=${encodeURIComponent(caseId)}`, undefined, signal),
  list: (caseId: string, signal?: AbortSignal) => request<ReportList>('GET', casePath(caseId, '/reports'), undefined, signal),
  get: (caseId: string, reportId: string, signal?: AbortSignal) => request<Report>('GET', reportPath(caseId, reportId), undefined, signal),
  create: (caseId: string, templateId: ReportTemplateId, lang: ReportLanguage) => request<Report>('POST', casePath(caseId, '/reports'), { templateId, lang }),
  regenerate: (caseId: string, reportId: string) => request<Report>('POST', `${reportPath(caseId, reportId)}:generate`, {}),
  review: (caseId: string, reportId: string, sectionId: string, body: ReviewPayload) => request<ReportSection>('PATCH', `${reportPath(caseId, reportId)}/sections/${encodeURIComponent(sectionId)}`, body),
  audit: (caseId: string, reportId: string, signal?: AbortSignal) => request<ReportAudit[]>('GET', `${reportPath(caseId, reportId)}/audit`, undefined, signal),
  export: async (caseId: string, reportId: string, format: 'pdf' | 'docx', lang: ReportLanguage) => saveReportDownload(await fetchReport('GET', `${reportPath(caseId, reportId)}/export?format=${format}&lang=${lang}`), `report.${format}`),
  glossary: async () => saveReportDownload(await fetchReport('GET', '/report-glossary'), 'report-glossary.json'),
  gisis: (caseId: string, signal?: AbortSignal) => request<GisisDocument>('GET', casePath(caseId, '/gisis'), undefined, signal),
  gisisExport: async (caseId: string, format: 'json' | 'csv') => saveReportDownload(await fetchReport('GET', casePath(caseId, `/gisis/export?format=${format}`)), `gisis.${format}`),
  gisisValidate: (caseId: string, values: Record<string, unknown>) => request<GisisValidation>('POST', casePath(caseId, '/gisis:validate'), { values }),
  gisisValidateExport: async (caseId: string, values: Record<string, unknown>, format: 'json' | 'csv' = 'json') => saveReportDownload(await fetchReport('POST', casePath(caseId, '/gisis:validate'), { values, export: true, format }), `gisis.${format}`),
  colregDraft: (caseId: string) => request<ColregDraftResult>('POST', casePath(caseId, '/reports/sections/colreg:draft'), {}),
}
/** W16 独立合同类型，避免与并发开发的 COLREG 类型互相覆盖。 */
export type ReportLanguage = 'zh' | 'en' | 'bilingual'
export type ReportTemplateId = 'imo-cic' | 'maib' | 'cn-msa'
export type ReportStatus = 'Draft' | 'Confirmed' | 'Modified' | 'Dismissed'
export type RealDataStatus = 'fictional' | 'pending-confirmation'
export type ReviewAction = 'confirm' | 'dismiss' | 'modify'
export interface BilingualText { textZh: string; textEn: string }
export interface Citation {
  kind: 'evidence' | 'colreg-check' | 'recommendation' | 'interview-crosscheck' | 'whatif' | 'systemic'
  id: string; href: string; registration: 'registered' | 'unregistered' | 'missing'; unregistered: boolean
  sourceRef?: string; needsReview?: boolean
}
export interface ReviewRecord {
  action: ReviewAction; operator: string; utc: string; reason: string
  beforeValue: Record<string, unknown>; afterValue: Record<string, unknown>; auditSeq: number
}
export interface ReportSentence extends BilingualText {
  sentenceId: string; status: ReportStatus; source: 'Generated' | 'Investigator'; generatedText: BilingualText
  reviewedBy: string | null; reviewedAt: string | null; reviews: ReviewRecord[]; missing: boolean
  citations: Citation[]; sourceStatus?: string
}
export interface ReportSection extends BilingualText {
  sectionId: string; titleZh: string; titleEn: string; dataSources: string[]; status: ReportStatus
  source: 'Generated' | 'Investigator'; generatedText: BilingualText; reviewedBy: string | null
  reviewedAt: string | null; reviews: ReviewRecord[]; missing: boolean; sentences: ReportSentence[]
}
export interface Report {
  reportId: string; familyId: string; parentReportId: string | null; caseId: string
  templateId: ReportTemplateId; lang: ReportLanguage; version: number; status: ReportStatus
  isFictionalDemo: boolean; realDataStatus: RealDataStatus; createdBy: string; createdUtc: string
  sections: ReportSection[]; disclaimerZh: string; disclaimerEn: string; reportHref: string
}
export interface ReportTemplate {
  templateId: ReportTemplateId; titleZh: string; titleEn: string
  sections: { sectionId: string; titleZh: string; titleEn: string; dataSources: string[] }[]
}
export interface ReportTemplateList { templates: ReportTemplate[]; realDataStatus: RealDataStatus; caseId?: string }
export interface ReportList { reports: Report[]; realDataStatus: RealDataStatus; caseId: string }
export interface ReportAudit {
  auditEvent: { seq: number; utc: string; operator: string; action: string; category: string; command: string; before: string; after: string }
  reportId: string | null; sectionId: string | null; sentenceId: string | null; reason: string
  beforeValue: Record<string, unknown> | null; afterValue: Record<string, unknown> | null; summary: string
}
export interface GisisField {
  id: string; labelZh: string; labelEn: string; required: boolean; sourceRefs: string[]
  rules: Record<string, unknown>; value: unknown; missing: boolean; missingLabel: string | null; vesselId: string | null
}
export interface GisisDocument { caseId: string; isFictionalDemo: boolean; realDataStatus: RealDataStatus; fields: GisisField[]; notice: string }
export interface GisisValidation { valid: boolean; errors: { field?: string; fieldId?: string; id?: string; code?: string; message: string }[]; fields: GisisField[] }
export interface ReviewTarget extends BilingualText { sectionId: string; sentenceId?: string; title: string }
export interface ReviewPayload { action: ReviewAction; reason?: string; textZh?: string; textEn?: string; sentenceId?: string }
export interface ColregDraftResult { section: ReportSection; reportId: string; reportHref: string; report: Report }

export const DEMO_CASE_ID = 'CASE-2026-DEMO-LILY-MARY'
export const HAILI_CASE_ID = 'CASE-2025-HAILI5-WANA17'
/** 尚无已登记编号时使用合同明确的占位符，不读取真实报告。 */
export const YANGZE_CASE_ID = 'CASE-REAL-YANGZE22'
export const REPORT_CASES = [
  { caseId: DEMO_CASE_ID, label: 'Lily / Mary（虚构）' },
  { caseId: HAILI_CASE_ID, label: '海力5（真实 · 待确认）' },
  { caseId: YANGZE_CASE_ID, label: 'YANGZE 22（真实 · 待确认）' },
]
import { useEffect, useRef, useState } from 'react'
import { useSearchParams } from 'react-router-dom'
import { ReportApiError, reportApi } from '../reports/api'
import { ReportView, ReviewDialog } from '../reports/ReportView'
import { DEMO_CASE_ID } from '../reports/types'
import type { GisisDocument, GisisValidation, RealDataStatus, Report, ReportAudit, ReportLanguage, ReportTemplate, ReportTemplateId, ReviewAction, ReviewPayload, ReviewTarget } from '../reports/types'

/** W16 数据与动作入口；纯展示组件可脱离浏览器和后端独立测试。 */
export function ReportPage() {
  const [params, setParams] = useSearchParams()
  const caseId = params.get('case') || DEMO_CASE_ID
  const requestedReport = params.get('report') || params.get('reportId')
  const requestedTemplate = (['imo-cic', 'maib', 'cn-msa'].includes(params.get('template') || '') ? params.get('template') : 'imo-cic') as ReportTemplateId
  const requestedLanguage = (['zh', 'en', 'bilingual'].includes(params.get('lang') || '') ? params.get('lang') : 'bilingual') as ReportLanguage
  const [templates, setTemplates] = useState<ReportTemplate[]>([])
  const [reports, setReports] = useState<Report[]>([])
  const [report, setReport] = useState<Report | null>(null)
  const [gisis, setGisis] = useState<GisisDocument | null>(null)
  const [audit, setAudit] = useState<ReportAudit[]>([])
  const [realDataStatus, setRealDataStatus] = useState<RealDataStatus>('fictional')
  const [selectedSection, setSelectedSection] = useState<string | null>(null)
  const [review, setReview] = useState<{ action: ReviewAction; target: ReviewTarget } | null>(null)
  const [loading, setLoading] = useState(false)
  const [saving, setSaving] = useState(false)
  const [error, setError] = useState<string | null>(null)
  const [notice, setNotice] = useState<string | null>(null)
  const [validation, setValidation] = useState<GisisValidation | null>(null)
  const [revision, setRevision] = useState(0)
  const activeCase = useRef(caseId)
  activeCase.current = caseId
  const templateId = report?.templateId ?? requestedTemplate
  const lang = report?.lang ?? requestedLanguage
  const refresh = () => setRevision((v) => v + 1)

  useEffect(() => {
    const controller = new AbortController()
    const { signal } = controller
    setLoading(true); setError(null); setReport(null); setAudit([]); setGisis(null); setReview(null); setValidation(null)
    setRealDataStatus(caseId === DEMO_CASE_ID ? 'fictional' : 'pending-confirmation')
    void (async () => {
      try {
        // 模板、报告列表和 GISIS 没有数据依赖，合并等待以缩短切换时间。
        const [tpl, list, fields] = await Promise.all([reportApi.templates(caseId, signal), reportApi.list(caseId, signal), reportApi.gisis(caseId, signal)])
        if (signal.aborted) return
        setTemplates(tpl.templates); setReports(list.reports); setGisis(fields); setRealDataStatus(list.realDataStatus)
        const chosen = requestedReport || [...list.reports].sort((a, b) => b.createdUtc.localeCompare(a.createdUtc) || b.version - a.version).find((r) => r.templateId === requestedTemplate && r.lang === requestedLanguage)?.reportId
        if (chosen && list.realDataStatus !== 'pending-confirmation') {
          const [document, events] = await Promise.all([reportApi.get(caseId, chosen, signal), reportApi.audit(caseId, chosen, signal)])
          if (signal.aborted) return
          setReport(document); setAudit(events)
          setSelectedSection((old) => document.sections.some((s) => s.sectionId === old) ? old : document.sections[0]?.sectionId ?? null)
        }
      } catch (e) { if (!signal.aborted) setError((e as Error).message) }
      finally { if (!signal.aborted) setLoading(false) }
    })()
    return () => controller.abort()
  }, [caseId, requestedReport, requestedTemplate, requestedLanguage, revision])

  async function perform(work: () => Promise<void>, message?: string) {
    setSaving(true); setError(null); setNotice(null)
    try { await work(); if (activeCase.current === caseId && message) setNotice(message) }
    catch (e) {
      if (activeCase.current === caseId) {
        setError((e as Error).message)
        if (e instanceof ReportApiError && e.code === 'report_gisis_validation_failed') {
          const detail = e.detail as { errors?: GisisValidation['errors']; fields?: GisisValidation['fields'] } | null
          if (detail?.errors) setValidation({ valid: false, errors: detail.errors, fields: detail.fields ?? [] })
        }
      }
      throw e
    } finally { setSaving(false) }
  }

  function navigateReport(next: Report) {
    if (activeCase.current !== caseId) return
    setParams({ case: caseId, report: next.reportId, template: next.templateId, lang: next.lang })
    setSelectedSection(next.sections[0]?.sectionId ?? null)
  }
  function changeOptions(nextTemplate: ReportTemplateId, nextLang: ReportLanguage) {
    setNotice(null); setParams({ case: caseId, template: nextTemplate, lang: nextLang })
  }
  async function submitReview(body: ReviewPayload) {
    if (!report || !review) return
    try {
      await perform(async () => {
        const section = await reportApi.review(caseId, report.reportId, review.target.sectionId, body)
        if (activeCase.current !== caseId) return
        setReport((current) => current ? { ...current, sections: current.sections.map((s) => s.sectionId === section.sectionId ? section : s) } : null)
        setReview(null); refresh()
      }, '复核已保存，理由、原值和新值已写入审计。')
    } catch { /* 保留对话框内的输入，后端错误显示于页面。 */ }
  }

  return <>
    <ReportView caseId={caseId} templates={templates} templateId={templateId} lang={lang} report={report} reports={reports} gisis={gisis} audit={audit} realDataStatus={realDataStatus} selectedSectionId={selectedSection} busy={loading || saving} error={error} notice={notice || (loading ? '正在载入报告数据…' : null)} validation={validation}
      onSelectSection={setSelectedSection} onSwitchCase={(id) => { setNotice(null); setSelectedSection(null); setParams({ case: id, template: templateId, lang }) }}
      onTemplate={(id) => changeOptions(id, lang)} onLang={(next) => changeOptions(templateId, next)} onSelectReport={(id) => setParams({ case: caseId, report: id })}
      onCreate={() => { void perform(async () => navigateReport(await reportApi.create(caseId, templateId, lang)), '已生成 Draft 报告。').catch(() => {}) }}
      onRegenerate={() => { if (report) void perform(async () => navigateReport(await reportApi.regenerate(caseId, report.reportId)), '已生成新版本；旧版本及复核记录保留。').catch(() => {}) }}
      onReview={(action, target) => setReview({ action, target })}
      onExport={(format, exportLang) => { if (report) void perform(async () => { const file = await reportApi.export(caseId, report.reportId, format, exportLang); setNotice(`已导出 ${file.filename}${file.sha256 ? ` · SHA-256 ${file.sha256}` : ''}`); refresh() }).catch(() => {}) }}
      onGlossary={() => { void perform(async () => { await reportApi.glossary() }, '已下载 IMO 标准航海用语术语表（中文为项目译文）。').catch(() => {}) }}
      onGisisExport={(format) => { void perform(async () => { await reportApi.gisisExport(caseId, format); refresh() }, `已导出 GISIS ${format.toUpperCase()} 本地草稿字段。`).catch(() => {}) }}
      onGisisValidate={(values, exportFile) => { void perform(async () => {
        if (exportFile) { await reportApi.gisisValidateExport(caseId, values); setValidation(null); setNotice('GISIS 字段校验通过并已导出。') }
        else setValidation(await reportApi.gisisValidate(caseId, values))
        if (report) setAudit(await reportApi.audit(caseId, report.reportId))
      }).catch(() => {}) }} onRefresh={refresh} />
    {review && <ReviewDialog key={`${report?.reportId}:${review.target.sectionId}:${review.target.sentenceId || ''}:${review.action}`} action={review.action} target={review.target} busy={saving} onCancel={() => setReview(null)} onSubmit={submitReview} />}
  </>
}

