def case_doc() -> dict[str, Any]:
    return {
        "caseId": CASE_ID, "schemaVersion": "1.0.0", "title": FICTION + "星屿港 Lily 轮与 Mary 轮碰撞事故",
        "accidentCode": "DEMO-2026-0518", "accidentType": "Collision", "accidentGrade": "VerySerious",
        "incidentTimeUtc": sim_to_utc(EPOCH, COLLISION_T), "caseEpochUtc": EPOCH, "displayTimeZoneOffsetMinutes": 480,
        "incidentLocation": {"lonDeg": P_LON, "latDeg": P_LAT, "heightM": 0.0}, "seaLevelOffsetM": 0.0,
        "leadInvestigator": "首席调查官（虚构）", "agencyName": "星屿海事局（虚构）", "isFictionalDemo": True,
        "summaryNotes": "虚构演示数据：雾中窄航道对遇，Mary 轮违规左转，14:24:00 球鼻艏撞击 Lily 轮左舷 1# 货舱，Lily 轮进水坐沉。不代表任何真实事故。",
        "durationSec": DURATION, "placeName": "星屿港 3#–4# 浮标窄航道（虚构）",
    }


def seed(s: Session, blob_root: Path) -> bool:
    if s.query(CaseRow).filter_by(case_id=CASE_ID).first():
        return False
    case = case_doc()
    put_doc(s, CaseRow, CASE_ID, CASE_ID, case)
    audit.append(s, case_id=CASE_ID, operator=SEED_OP, role="LeadInvestigator", action="case.create", category="Case",
                 command=f"创建案件 {CASE_ID}（虚构演示）", after=case["title"], entity_type="case", entity_id=CASE_ID,
                 utc=L("16:30", 18))
    put_doc(s, VesselRow, CASE_ID, "vessel_lily", {
        "vesselId": "vessel_lily", "caseId": CASE_ID, "name": "Lily", "nameCn": "莉莉轮", "mmsi": "413990101",
        "imoNumber": "IMO 9900101", "callSign": "BXXX1", "flagState": "船旗国 A（虚构）", "vesselTypeCode": "BulkCarrier",
        "loaM": 189.9, "beamM": 32.26, "draftForeM": 5.2, "draftAftM": 6.8, "displacementTons": 24500,
        "loadingCondition": "Ballast", "colorHex": "#3be3ff"})
    put_doc(s, VesselRow, CASE_ID, "vessel_mary", {
        "vesselId": "vessel_mary", "caseId": CASE_ID, "name": "Mary", "nameCn": "玛丽轮", "mmsi": "351990202",
        "imoNumber": "IMO 9900202", "callSign": "3FXX2", "flagState": "船旗国 B（虚构）", "vesselTypeCode": "ContainerShip",
        "loaM": 225.0, "beamM": 32.2, "draftForeM": 12.4, "draftAftM": 12.8, "displacementTons": 58200,
        "loadingCondition": "FullLoad", "colorHex": "#f97316"})
    for p in track_points():
        s.add(TrackPointRow(case_id=CASE_ID, vessel_id=p["vesselId"], time_sec=p["timeSec"], doc=p))
    seed_evidence(s, blob_root)
    seed_timeline(s)
    seed_interviews(s)
    seed_colreg(s)
    seed_recommendations(s)
    seed_agent_drafts(s)
    put_doc(s, AccessPolicyRow, CASE_ID, "policy", default_policy())
    audit.append(s, case_id=CASE_ID, operator=SEED_OP, role="LeadInvestigator", action="seed.load", category="Case",
                 command="载入虚构演示数据（Lily/Mary）", after="证据 6 / 时间线 12 / 冲突 4 / 笔录 6 / 建议 7 / 草稿 2",
                 entity_type="case", entity_id=CASE_ID, utc=L("10:00", 28))
    return True
import { useState, type DragEvent } from 'react'
import { api, casePath } from '../api'
import { Metric, Panel } from '../components/Panel'
import { useToast } from '../components/Toast'
import { daysUntil, toLocal } from '../format'
import { useLoad } from '../hooks'
import type { AuditEvent, Board, ConsultationRound, PartyStatus, Recommendation, RecStatus } from '../types'

const STATUS_LABEL: Record<RecStatus, string> = {
  Draft: '草拟', Issued: '已发布', Responded: '已回复·落实中', Implemented: '已落实', NotAdopted: '未采纳', Closed: '已关闭',
}
const STATUS_ST: Record<RecStatus, string> = {
  Draft: 'st-mute', Issued: 'st-warn', Responded: 'st-pur', Implemented: 'st-ok', NotAdopted: 'st-bad', Closed: 'st-info',
}
const PARTY_ST: Record<PartyStatus['status'], [string, string]> = {
  Pending: ['st-mute', '待回复'], Replied: ['st-ok', '已回'], RepliedLate: ['st-warn', '逾期回'], Overdue: ['st-bad', '逾期'], Waived: ['st-info', '放弃'],
}
// 看板列 → 拖入时默认的目标状态
const COLUMN_TARGET: Record<string, RecStatus> = { Draft: 'Draft', Issued: 'Issued', InProgress: 'Responded', Closed: 'Implemented' }

async function loadAudit(): Promise<AuditEvent[]> {
  const [a, b] = await Promise.all([
    api.get<AuditEvent[]>(casePath('/audit?category=SafetyRec&order=desc&limit=14')),
    api.get<AuditEvent[]>(casePath('/audit?category=Consultation&order=desc&limit=6')),
  ])
  return [...a, ...b].sort((x, y) => y.seq - x.seq).slice(0, 14)
}

export function RecommendationsPage() {
  const { run, show } = useToast()
  const board = useLoad(() => api.get<Board>(casePath('/recommendations:board')))
  const rounds = useLoad(() => api.get<ConsultationRound[]>(casePath('/consultation/rounds')))
  const audit = useLoad(loadAudit)
  const [selId, setSelId] = useState<string>('SR-2026-03')
  const [dropCol, setDropCol] = useState<string | null>(null)
  const [pending, setPending] = useState<{ id: string; to: RecStatus } | null>(null)
  const [creating, setCreating] = useState(false)

  const all = (board.data?.columns ?? []).flatMap((c) => c.items)
  const sel = all.find((r) => r.id === selId)
  const refresh = () => { board.reload(); audit.reload() }

  const transition = (id: string, to: RecStatus, note = '') =>
    run(async () => { const r = await api.post<Recommendation>(casePath(`/recommendations/${id}:transition`), { to, note }); refresh(); setPending(null); return r },
      `${id} → ${STATUS_LABEL[to]}（已写审计 safetyrec.transition）`)

  const onDrop = (colKey: string, e: DragEvent) => {
    e.preventDefault()
    setDropCol(null)
    const id = e.dataTransfer.getData('text/plain')
    const rec = all.find((r) => r.id === id)
    if (!rec || !board.data) return
    const target = COLUMN_TARGET[colKey]
    if (rec.column === colKey) return
    setSelId(id)
    if (target === 'Issued' && board.data.allowed[rec.status].includes('Issued')) { void transition(id, 'Issued'); return }
    if (target === 'Responded' && rec.status === 'Issued') { setPending({ id, to: 'Responded' }); return }
    if (target === 'Implemented' && board.data.allowed[rec.status].some((s) => ['Implemented', 'NotAdopted', 'Closed'].includes(s))) {
      setPending({ id, to: board.data.allowed[rec.status].includes('Implemented') ? 'Implemented' : 'Closed' }); return
    }
    show(`非法状态转换：${STATUS_LABEL[rec.status]} → ${colKey}（允许：${board.data.allowed[rec.status].map((s) => STATUS_LABEL[s]).join('、') || '无'}）`, 'err')
  }

  const totals = {
    total: all.length,
    awaiting: all.filter((r) => r.status === 'Issued').length,
    inProgress: all.filter((r) => r.status === 'Responded'),
    overdue: all.filter((r) => r.isOverdue).length,
    closed: all.filter((r) => r.column === 'Closed').length,
  }
  const avg = totals.inProgress.length ? Math.round(totals.inProgress.reduce((s, r) => s + r.progressPct, 0) / totals.inProgress.length) : 0
  const cur = rounds.data?.find((r) => !r.isClosed) ?? rounds.data?.[rounds.data.length - 1]

  return (
    <div>
      <div className="page-head">
        <div>
          <div className="page-title">安全建议跟踪 · 报告草案征求意见 <span className="p6-tag">示例数据（虚构）</span><span className="p6-tag cyan">LIVE · 127.0.0.1:8765</span></div>
          <div className="page-sub">
            状态机与 C# SafetyRecommendationBoard 一致：草拟 → 已发布 → 已回复（只能经登记回复）→ 已落实 / 未采纳（须理由）/ 已关闭。
            拖动卡片或在详情中操作；每次变更写入不可改的审计链（audit/audit.jsonl）。
          </div>
        </div>
        <div className="page-actions">
          <button className="btn btn-primary" onClick={() => setCreating((v) => !v)}>＋ 新建安全建议</button>
        </div>
      </div>

      {board.error && <div className="p6-card" style={{ borderColor: 'var(--red)', marginBottom: 12 }}>后端错误：{board.error}</div>}
      {creating && <CreateForm onDone={(id) => { setCreating(false); if (id) { setSelId(id); refresh() } }} />}

      <div className="grid" style={{ gridTemplateColumns: 'repeat(5, 1fr)', marginBottom: 12 }}>
        <Metric label="安全建议" value={totals.total} unit="条" />
        <Metric label="已发布 · 待回复" value={totals.awaiting} unit="条" tone="amber" />
        <Metric label="落实中 · 平均进度" value={avg} unit={`% · ${totals.inProgress.length} 条`} tone="pur" />
        <Metric label="逾期（已发布/落实中）" value={totals.overdue} unit="条" tone={totals.overdue ? 'red' : 'green'} />
        <Metric label="已关闭" value={totals.closed} unit="条" tone="green" />
      </div>

      <Panel title={`安全建议看板（${totals.total} 条）`} meta={<span>拖动卡片改变状态 · 已关闭 = 已落实 / 未采纳 / 已关闭</span>} style={{ marginBottom: 12 }}>
        <div className="kanban">
          {(board.data?.columns ?? []).map((col) => (
            <div key={col.key} className={`kb-col ${dropCol === col.key ? 'drop' : ''}`}
              onDragOver={(e) => { e.preventDefault(); setDropCol(col.key) }} onDragLeave={() => setDropCol(null)} onDrop={(e) => onDrop(col.key, e)}>
              <div className="kb-col-h"><span>{col.title}</span><span className="cnt">{col.items.length}</span></div>
              {col.items.map((r) => <Card key={r.id} rec={r} selected={r.id === selId} onClick={() => setSelId(r.id)} />)}
            </div>
          ))}
        </div>
      </Panel>

      <div className="grid" style={{ gridTemplateColumns: '5fr 4fr 4fr' }}>
        {sel ? (
          <Detail rec={sel} allowed={board.data?.allowed[sel.status] ?? []} pending={pending?.id === sel.id ? pending.to : null}
            onTransition={transition} onChanged={refresh} onCancel={() => setPending(null)} />
        ) : <Panel title="建议详情"><div className="empty">选择一张卡片</div></Panel>}
        <Panel title="报告草案征求意见" meta={cur && <span>第 {cur.roundNo} 轮 · {cur.isClosed ? '已关闭' : `剩余 ${cur.daysRemaining} 天`}</span>} bodyStyle={{ padding: 0 }}>
          <ConsultationTable rounds={rounds.data ?? []} />
        </Panel>
        <Panel title="审计记录（安全建议 / 征求意见）" meta={<span>append-only · SHA-256 链</span>} bodyStyle={{ padding: 0, maxHeight: 330 }}>
          <table className="p6-table">
            <thead><tr><th>时间 · #</th><th>操作 / 变更</th></tr></thead>
            <tbody>
              {(audit.data ?? []).map((a) => (
                <tr key={a.seq} title={a.line ?? ''}>
                  <td className="mono" style={{ verticalAlign: 'top' }}>{toLocal(a.utc)}<div className="p6-muted">#{a.seq}</div></td>
                  <td>
                    <div><b style={{ fontWeight: 600 }}>{a.command}</b> <span className="p6-muted" style={{ fontSize: 9.5 }}>{a.operator} · {a.action}</span></div>
                    <div style={{ fontSize: 10.5, color: 'var(--text-sec)', whiteSpace: 'nowrap', overflow: 'hidden', textOverflow: 'ellipsis', maxWidth: 300 }}>
                      {a.before && <span className="p6-muted">{a.before} → </span>}{a.after}
                    </div>
                  </td>
                </tr>
              ))}
              {audit.error && <tr><td colSpan={2} className="empty">当前角色无审计查看权限</td></tr>}
            </tbody>
          </table>
        </Panel>
      </div>
    </div>
  )
}

function Card({ rec, selected, onClick }: { rec: Recommendation; selected: boolean; onClick: () => void }) {
  const due = daysUntil(rec.dueUtc)
  return (
    <div className={`kb-card c-${rec.column} ${selected ? 'sel' : ''}`} draggable onDragStart={(e) => e.dataTransfer.setData('text/plain', rec.id)} onClick={onClick}>
      <div className="id"><span>{rec.id}{rec.isInterim && ' · 临时措施'}</span><span className={`st ${STATUS_ST[rec.status]}`}>{STATUS_LABEL[rec.status]}</span></div>
      <div className="t">{rec.title}</div>
      <div className="links">{rec.causeNodeIds.map((c) => <span key={c}>{c}</span>)}</div>
      <div className="m">
        <span>→ {rec.addressee}</span>
        <span style={{ color: rec.isOverdue ? 'var(--red)' : undefined }}>{rec.isOverdue ? `逾期 ${-due} 天` : toLocal(rec.dueUtc).slice(0, 5)}</span>
      </div>
      {rec.status === 'Responded' && <div className="bar"><i style={{ width: `${rec.progressPct}%` }} /></div>}
      {rec.status === 'Responded' && <div className="m" style={{ marginTop: 2 }}><span>进度 {rec.progressPct}%</span><span>{rec.responseSummary.slice(0, 14)}</span></div>}
    </div>
  )
}

function Detail(props: { rec: Recommendation; allowed: RecStatus[]; pending: RecStatus | null; onTransition: (id: string, to: RecStatus, note?: string) => Promise<unknown>; onChanged: () => void; onCancel: () => void }) {
  const { rec, allowed } = props
  const { run } = useToast()
  const [note, setNote] = useState('')
  const [party, setParty] = useState(rec.addressee)
  const [text, setText] = useState('')
  const [pct, setPct] = useState(rec.progressPct)
  const [lastId, setLastId] = useState(rec.id)
  if (lastId !== rec.id) { setLastId(rec.id); setPct(rec.progressPct); setParty(rec.addressee); setNote(''); setText('') }

  const respond = () => run(async () => {
    const r = await api.post(casePath(`/recommendations/${rec.id}/responses`), { party, text })
    setText(''); props.onChanged(); props.onCancel(); return r
  }, `${rec.id} 已登记回复${rec.status === 'Issued' ? '，状态 → 已回复' : ''}`)
  const saveProgress = () => run(async () => {
    const r = await api.patch(casePath(`/recommendations/${rec.id}`), { progressPct: pct, note }); setNote(''); props.onChanged(); return r
  }, `${rec.id} 落实进度 → ${pct}%（审计 safetyrec.progress）`)
  const closeTargets = allowed.filter((s) => s !== 'Responded')
  const showResponse = rec.status === 'Issued' || rec.status === 'Responded'

  return (
    <Panel title={`建议详情 · ${rec.id}`} meta={<span className={`st ${STATUS_ST[rec.status]}`}>{STATUS_LABEL[rec.status]}</span>} bodyStyle={{ maxHeight: 330 }}>
      <div style={{ fontWeight: 700, fontSize: 12.5, marginBottom: 4 }}>{rec.title}</div>
      <dl className="kv">
        <dt>建议对象</dt><dd>{rec.addressee}</dd>
        <dt>原因节点</dt><dd className="mono">{rec.causeNodeIds.join(' · ')}</dd>
        <dt>期限</dt><dd className="mono" style={{ color: rec.isOverdue ? 'var(--red)' : undefined }}>{toLocal(rec.dueUtc)}{rec.isOverdue && '（逾期）'}</dd>
        {rec.responseSummary && <><dt>最新回复</dt><dd>{rec.responses[rec.responses.length - 1]?.party}：{rec.responseSummary}</dd></>}
        {rec.verificationNote && <><dt>核实说明</dt><dd>{rec.verificationNote}</dd></>}
      </dl>

      {rec.status === 'Responded' && (
        <div className="p6-card" style={{ marginTop: 8 }}>
          <div className="row-actions">
            <span className="p6-dim">落实进度</span>
            <input type="range" min={0} max={100} step={5} value={pct} onChange={(e) => setPct(Number(e.target.value))} style={{ flex: 1 }} />
            <b className="mono">{pct}%</b>
            <button className="btn btn-sm" disabled={pct === rec.progressPct} onClick={saveProgress}>保存进度</button>
          </div>
        </div>
      )}

      {showResponse && (props.pending === 'Responded' || rec.status === 'Responded' || rec.status === 'Issued') && (
        <div className="p6-card" style={{ marginTop: 8, borderColor: props.pending === 'Responded' ? 'var(--cyan)' : undefined }}>
          <div className="p6-dim" style={{ marginBottom: 4 }}>登记书面回复{rec.status === 'Issued' ? '（登记后进入“落实中”）' : '（追加，不改状态）'}</div>
          <div className="row-actions">
            <input className="input" style={{ width: 130 }} value={party} onChange={(e) => setParty(e.target.value)} placeholder="回复方" />
            <input className="input" style={{ flex: 1 }} value={text} onChange={(e) => setText(e.target.value)} placeholder="回复内容" />
            <button className="btn btn-sm btn-primary" disabled={!party.trim() || !text.trim()} onClick={respond}>登记回复</button>
          </div>
        </div>
      )}

      <div className="p6-card" style={{ marginTop: 8, borderColor: props.pending && props.pending !== 'Responded' ? 'var(--cyan)' : undefined }}>
        <div className="p6-dim" style={{ marginBottom: 4 }}>状态变更（允许：{allowed.map((s) => STATUS_LABEL[s]).join('、') || '无，已终结'}）</div>
        <div className="row-actions">
          <input className="input" style={{ flex: 1, minWidth: 120 }} value={note} onChange={(e) => setNote(e.target.value)} placeholder="说明（未采纳必填）" />
          {closeTargets.map((s) => (
            <button key={s} className={`btn btn-sm ${s === 'NotAdopted' ? 'btn-danger' : s === props.pending ? 'btn-primary' : ''}`}
              disabled={s === 'NotAdopted' && !note.trim()} onClick={() => props.onTransition(rec.id, s, note).then(() => setNote(''))}>
              → {STATUS_LABEL[s]}
            </button>
          ))}
          {props.pending && <button className="btn btn-sm" onClick={props.onCancel}>取消</button>}
        </div>
      </div>

      <div style={{ marginTop: 8 }}>
        {rec.history.slice().reverse().map((h, i) => (
          <div key={i} className="p6-note">{toLocal(h.utc)} · {h.operator} · {STATUS_LABEL[h.from]} → {STATUS_LABEL[h.to]}{h.note ? `（${h.note}）` : ''}</div>
        ))}
      </div>
    </Panel>
  )
}

function ConsultationTable({ rounds }: { rounds: ConsultationRound[] }) {
  if (!rounds.length) return <div className="empty">暂无征求意见轮次</div>
  const parties = rounds[rounds.length - 1].parties
  return (
    <div>
      <table className="p6-table">
        <thead>
          <tr><th>利益相关方</th>{rounds.map((r) => <th key={r.roundNo}>第 {r.roundNo} 轮</th>)}<th>采纳（本轮）</th></tr>
        </thead>
        <tbody>
          {parties.map((p) => {
            const last = rounds[rounds.length - 1].partyStatus.find((x) => x.partyId === p.partyId)
            return (
              <tr key={p.partyId}>
                <td>{p.name}</td>
                {rounds.map((r) => {
                  const st = r.partyStatus.find((x) => x.partyId === p.partyId)
                  return <td key={r.roundNo}>{st ? <span className={`st ${PARTY_ST[st.status][0]}`}>{PARTY_ST[st.status][1]}</span> : '—'}</td>
                })}
                <td className="mono">{last && last.total ? `${last.adopted + last.partiallyAdopted}/${last.total}` : '—'}</td>
              </tr>
            )
          })}
        </tbody>
      </table>
      <div style={{ padding: '8px 10px' }}>
        {rounds.map((r) => (
          <div key={r.roundNo} className="p6-note">
            第 {r.roundNo} 轮 · {r.draftVersion} · 发出 {toLocal(r.openedUtc)} · 期限 {toLocal(r.deadlineUtc)}
            {r.isClosed ? ' · 已关闭' : ` · 剩余 ${r.daysRemaining} 天${r.allReplied ? ' · 各方均已回复' : ''}`}
          </div>
        ))}
        <div className="p6-note">MSC.255(84) 第 13 章：草案征求意见默认 30 天；非“采纳”的处理须写反馈理由。</div>
      </div>
    </div>
  )
}

function CreateForm({ onDone }: { onDone: (id?: string) => void }) {
  const { run } = useToast()
  const [f, setF] = useState({ title: '', addressee: '', causeNodeIds: 'COLREG-R19', dueUtc: '2027-06-30', isInterim: false })
  const submit = () => run(async () => {
    const r = await api.post<Recommendation>(casePath('/recommendations'), {
      title: f.title, addressee: f.addressee, body: '', isInterim: f.isInterim,
      causeNodeIds: f.causeNodeIds.split(/[,，\s]+/).filter(Boolean), dueUtc: `${f.dueUtc}T15:59:59Z`,
    })
    onDone(r.id)
    return r
  }, '已新建安全建议（草拟）')
  return (
    <div className="p6-card" style={{ marginBottom: 12, borderColor: 'var(--cyan)' }}>
      <div className="row-actions">
        <input className="input" style={{ flex: 2 }} placeholder="建议标题" value={f.title} onChange={(e) => setF({ ...f, title: e.target.value })} />
        <input className="input" style={{ flex: 1 }} placeholder="建议对象" value={f.addressee} onChange={(e) => setF({ ...f, addressee: e.target.value })} />
        <input className="input" style={{ width: 160 }} placeholder="原因节点（逗号分隔）" value={f.causeNodeIds} onChange={(e) => setF({ ...f, causeNodeIds: e.target.value })} />
        <input className="input" type="date" value={f.dueUtc} onChange={(e) => setF({ ...f, dueUtc: e.target.value })} />
        <label className="p6-dim"><input type="checkbox" checked={f.isInterim} onChange={(e) => setF({ ...f, isInterim: e.target.checked })} /> 临时措施</label>
        <button className="btn btn-sm btn-primary" disabled={!f.title.trim() || !f.addressee.trim()} onClick={submit}>保存</button>
        <button className="btn btn-sm" onClick={() => onDone()}>取消</button>
      </div>
    </div>
  )
}
import { useMemo, useState } from 'react'
import { useSearchParams } from 'react-router-dom'
import { api, ApiError, CASE_ID } from '../api'
import { ColregView } from '../colreg/ColregView'
import { reviewBody } from '../colreg/derive'
import { useToast } from '../components/Toast'
import { useLoad } from '../hooks'
import type {
  AuditEvent, CaseDef, CaseListItem, ColregAnalysis, ColregCompare, ColregReportDraft, ColregRunList, ColregRunView,
  ColregVerdict, CpaSeries, EvidenceItem, ReviewAction, TimelineEvent, Vessel,
} from '../types'

const HAILI = 'CASE-2025-HAILI5-WANA17'
/** 章节草稿接口由 W16（Codex）实现；这里只留调用处。 */
export const REPORT_DRAFT_PATH = (caseId: string) => `/cases/${caseId}/colreg/report-drafts`
export const DRAFT_UNAVAILABLE = '章节草稿生成服务尚未上线（W16 开发中）。当前页面的核查项与证据已可复核，接口上线后此按钮直接生成 Draft 章节。'

const REVIEW_ERR: Record<string, string> = {
  colreg_review_reason_required: '驳回或修改须填写理由',
  colreg_review_verdict_not_allowed: '确认/驳回时不能改判定，要改判定请用“修改”',
  colreg_review_verdict_required: '修改须选择新的判定',
  colreg_review_no_change: '新判定与当前判定相同，不构成修改',
  evidence_not_registered: '有证据编号未在本案件登记，请先到证据中心登记',
}

export function ColregPage() {
  const { run, show } = useToast()
  const [params, setParams] = useSearchParams()
  const caseId = params.get('case') || CASE_ID
  const [sel, setSel] = useState<string | null>(null)
  const [evaluating, setEvaluating] = useState(false)
  const [viewRunId, setViewRunId] = useState<string | null>(null)
  const [compare, setCompare] = useState<ColregCompare | null>(null)
  const [draft, setDraft] = useState<ColregReportDraft | null>(null)
  const [draftNotice, setDraftNotice] = useState<string | null>(null)

  const cases = useLoad(() => api.get<CaseListItem[]>('/cases'))
  const caseRes = useLoad(() => api.get<CaseDef>(`/cases/${caseId}`), [caseId])
  const vessels = useLoad(() => api.get<Vessel[]>(`/cases/${caseId}/vessels`), [caseId])
  const runs = useLoad(() => api.get<ColregRunList>(`/cases/${caseId}/colreg/runs`), [caseId])
  const runView = useLoad(() => api.get<ColregRunView>(`/cases/${caseId}/colreg/runs/${viewRunId ?? 'active'}`), [caseId, viewRunId])
  const current = useLoad(() => api.get<ColregAnalysis>(`/cases/${caseId}/colreg`), [caseId])
  const evidence = useLoad(() => api.get<EvidenceItem[]>(`/cases/${caseId}/evidence`), [caseId])
  const audit = useLoad(() => api.get<AuditEvent[]>(`/cases/${caseId}/audit?action=colreg.review&order=asc&limit=500`), [caseId])
  const timeline = useLoad(() => api.get<{ events: TimelineEvent[] }>(`/cases/${caseId}/timeline`), [caseId])
  const cpa = useLoad(() => api.get<CpaSeries>(`/cases/${caseId}/cpa?stepSec=10`), [caseId])
  const drafts = useLoad(() => api.get<{ drafts: ColregReportDraft[] }>(REPORT_DRAFT_PATH(caseId)).catch(() => ({ drafts: [] })), [caseId])

  // 版本接口不可用（旧服务）时退回当前文档
  const analysis = runView.data?.analysis ?? current.data

  const switcher = useMemo(() => {
    const list = cases.data ?? []
    const wanted = [CASE_ID, HAILI]
    const out = wanted.map((id) => list.find((c) => c.caseId === id)).filter((c): c is CaseListItem => !!c)
    return out.length ? out : list
  }, [cases.data])

  const reloadAll = () => { runView.reload(); runs.reload(); current.reload(); audit.reload(); caseRes.reload() }

  const onReview = (checkId: string, action: ReviewAction, verdict: ColregVerdict | null, reason: string, evidenceIds?: string[]) => {
    const label = { confirm: '确认', dismiss: '驳回', modify: '修改' }[action]
    void run(async () => {
      const body = reviewBody(action, verdict, reason, evidenceIds)
      const q = viewRunId ? `?runId=${encodeURIComponent(viewRunId)}` : ''
      try {
        await api.patch(`/cases/${caseId}/colreg/checks/${checkId}${q}`, body)
      } catch (e) {
        if (e instanceof ApiError && REVIEW_ERR[e.code]) throw new Error(`${REVIEW_ERR[e.code]}（${e.message}）`)
        throw e
      }
      reloadAll()
    }, `已${label} ${checkId}，已写入审计`)
  }

  const onEvaluate = (confirmed: boolean) => {
    setEvaluating(true)
    void run(async () => {
      const path = `/cases/${caseId}/colreg:evaluate`
      let doc: ColregAnalysis
      try {
        doc = await api.post<ColregAnalysis>(path, {})
      } catch (e) {
        if (!(e instanceof ApiError) || e.code !== 'colreg_evaluate_confirm_required') throw e
        // 后端二次确认：只有用户已在确认框里确认，才带一次性令牌重发
        if (!confirmed) throw new Error('该案例不是虚构演示数据，运行规则引擎需要二次确认')
        const tok = (e.detail as { confirmToken?: string } | undefined)?.confirmToken
        if (!tok) throw e
        doc = await api.post<ColregAnalysis>(`${path}?confirmToken=${encodeURIComponent(tok)}`, {})
      }
      setViewRunId(null)
      setCompare(null)
      reloadAll()
      return doc
    }, '规则引擎已运行，结果另存为新版本（草稿），旧版本与复核保留').finally(() => setEvaluating(false))
  }

  const onActivateRun = (runId: string) => {
    void run(async () => {
      await api.post(`/cases/${caseId}/colreg/runs/${runId}:activate`, {})
      setViewRunId(null)
      reloadAll()
    }, `已把 ${runId} 设为当前版本（已写审计）`)
  }

  const onCompare = (baseRunId: string, otherRunId: string) => {
    void run(async () => {
      setCompare(await api.get<ColregCompare>(`/cases/${caseId}/colreg/compare?base=${baseRunId}&other=${otherRunId}`))
    }, '版本对比已生成')
  }

  const onGenerateDraft = () => {
    void (async () => {
      try {
        const d = await api.post<ColregReportDraft>(REPORT_DRAFT_PATH(caseId), { runId: runView.data?.runId ?? null })
        setDraft(d)
        setDraftNotice(null)
        drafts.reload()
        show(`已生成章节草稿 ${d.draftId}（Draft，已写审计）`)
      } catch (e) {
        if (e instanceof ApiError && [404, 405, 501].includes(e.status)) {
          setDraftNotice(DRAFT_UNAVAILABLE)
          show('章节草稿服务尚未上线（W16），已在页面给出说明')
        } else {
          setDraftNotice(`生成章节草稿失败：${(e as Error).message}`)
        }
      }
    })()
  }

  const onOpenDraft = (id: string) => {
    void run(async () => { setDraft(await api.get<ColregReportDraft>(`${REPORT_DRAFT_PATH(caseId)}/${id}`)) }, `已打开 ${id}`)
  }

  const err = caseRes.error || (current.error && runView.error) || vessels.error
  if (!caseRes.data || !analysis) {
    return (
      <div>
        {err && <div className="p6-card" style={{ borderColor: 'var(--red)' }}>后端错误：{err}</div>}
        {!err && <div className="empty">正在载入避碰规则对照…</div>}
      </div>
    )
  }

  return (
    <ColregView
      caseDef={caseRes.data}
      vessels={vessels.data ?? []}
      analysis={analysis}
      evidence={evidence.data ?? []}
      audit={audit.data ?? []}
      selectedId={sel ?? analysis.checks[0]?.checkId ?? null}
      onSelect={setSel}
      onReview={onReview}
      onEvaluate={onEvaluate}
      evaluating={evaluating}
      cases={switcher}
      onSwitchCase={(id) => { setSel(null); setViewRunId(null); setCompare(null); setDraft(null); setDraftNotice(null); setParams(id === CASE_ID ? {} : { case: id }); show(`已切换到 ${id}`) }}
      runs={runs.data}
      runView={runView.data}
      onViewRun={(id) => { setSel(null); setViewRunId(id) }}
      onActivateRun={onActivateRun}
      compare={compare}
      onCompare={onCompare}
      onCloseCompare={() => setCompare(null)}
      cpa={cpa.data}
      cpaError={cpa.error}
      timeline={timeline.data?.events ?? []}
      onGenerateDraft={onGenerateDraft}
      draft={draft}
      drafts={drafts.data?.drafts ?? []}
      draftNotice={draftNotice}
      onOpenDraft={onOpenDraft}
    />
  )
}
/* 视觉沿用 prototype/index.html + prototype/p6/p6.css 的设计变量与组件类。 */
:root {
  --bg-deep: #050a12;
  --bg-panel: rgba(10, 20, 35, 0.78);
  --bg-panel-solid: #0a1423;
  --bg-panel-elevated: rgba(15, 29, 50, 0.86);
  --bg-card: rgba(13, 25, 43, 0.72);
  --bg-input: rgba(6, 13, 24, 0.85);
  --cyan: #3be3ff;
  --cyan-dim: rgba(59, 227, 255, 0.18);
  --amber: #ffb020;
  --amber-dim: rgba(255, 176, 32, 0.18);
  --red: #ff3b5c;
  --red-dim: rgba(255, 59, 92, 0.2);
  --green: #10b981;
  --green-dim: rgba(16, 185, 129, 0.18);
  --purple: #a78bfa;
  --text-main: #e6f1ff;
  --text-sec: #8da4c4;
  --text-muted: #526987;
  --border-line: rgba(59, 227, 255, 0.22);
  --border-subtle: rgba(141, 164, 196, 0.15);
  --font-sans: "PingFang SC", "Microsoft YaHei", "Noto Sans CJK SC", -apple-system, BlinkMacSystemFont, sans-serif;
  --font-mono: ui-monospace, "JetBrains Mono", Consolas, "Liberation Mono", monospace;
  --sidebar-w: 224px;
  --topbar-h: 62px;
  --radius-sm: 4px;
}
* { box-sizing: border-box; }
html, body, #root { height: 100%; margin: 0; }
body {
  background: radial-gradient(1200px 700px at 70% -10%, rgba(14, 116, 144, 0.22), transparent 60%),
    radial-gradient(900px 600px at -10% 110%, rgba(59, 227, 255, 0.07), transparent 60%), var(--bg-deep);
  color: var(--text-main);
  font-family: var(--font-sans);
  font-size: 12px;
  -webkit-font-smoothing: antialiased;
}
button, input, select, textarea { font-family: inherit; font-size: inherit; color: inherit; }
::-webkit-scrollbar { width: 6px; height: 6px; }
::-webkit-scrollbar-thumb { background: rgba(59, 227, 255, 0.25); border-radius: 3px; }

.app { display: grid; grid-template-columns: var(--sidebar-w) 1fr; grid-template-rows: var(--topbar-h) 1fr; height: 100vh; }

/* 侧栏 */
.sidebar { grid-row: 1 / 3; background: linear-gradient(180deg, rgba(8, 17, 31, 0.95), rgba(5, 11, 20, 0.98)); border-right: 1px solid var(--border-line);
  display: flex; flex-direction: column; box-shadow: 4px 0 24px rgba(0, 0, 0, 0.5); z-index: 20; min-height: 0; }
.brand-box { height: var(--topbar-h); padding: 0 14px; display: flex; align-items: center; gap: 10px; border-bottom: 1px solid var(--border-line); flex-shrink: 0; }
.brand-logo { width: 32px; height: 32px; border: 1px solid var(--cyan); border-radius: 6px; display: flex; align-items: center; justify-content: center;
  color: var(--cyan); font-weight: 800; font-family: var(--font-mono); box-shadow: 0 0 10px rgba(59, 227, 255, 0.35); }
.brand-name { font-weight: 800; letter-spacing: 1px; font-family: var(--font-mono); font-size: 14px; }
.brand-name small { margin-left: 6px; font-size: 9px; color: var(--cyan); border: 1px solid var(--border-line); padding: 1px 4px; border-radius: 3px; }
.brand-sub { font-size: 10px; color: var(--text-sec); }
.demo-banner { margin: 10px 10px 4px; padding: 7px 9px; border: 1px solid rgba(255, 176, 32, 0.5); background: rgba(255, 176, 32, 0.1); border-radius: 4px; font-size: 10.5px; color: #ffd166; line-height: 1.5; }
.nav { flex: 1; overflow-y: auto; padding: 6px 8px 10px; display: flex; flex-direction: column; gap: 2px; }
.nav-sub-label { padding: 12px 6px 4px; font-size: 10px; font-family: var(--font-mono); letter-spacing: 1.2px; color: var(--amber); border-top: 1px dashed rgba(255, 176, 32, 0.3); margin-top: 6px; }
.nav-sub-label.first { border-top: none; margin-top: 0; color: var(--text-muted); }
.nav-item { display: flex; align-items: center; gap: 10px; padding: 6px 10px; border-radius: var(--radius-sm); color: var(--text-sec); text-decoration: none; border: 1px solid transparent; }
.nav-item:hover { background: rgba(59, 227, 255, 0.06); color: var(--text-main); }
.nav-item.active { background: linear-gradient(90deg, rgba(59, 227, 255, 0.18), rgba(59, 227, 255, 0.04)); color: #fff; border-color: rgba(59, 227, 255, 0.45);
  box-shadow: inset 0 0 12px rgba(59, 227, 255, 0.12), 0 0 12px rgba(59, 227, 255, 0.1); }
.nav-step-num { width: 20px; height: 20px; border-radius: 4px; background: rgba(141, 164, 196, 0.12); border: 1px solid rgba(141, 164, 196, 0.25); font-family: var(--font-mono);
  font-size: 11px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.nav-item.p6 .nav-step-num { border-color: rgba(255, 176, 32, 0.4); color: #ffd166; background: rgba(255, 176, 32, 0.1); }
.nav-item.active .nav-step-num { border-color: var(--cyan); color: var(--cyan); background: var(--cyan-dim); }
.nav-item-text { display: flex; flex-direction: column; min-width: 0; }
.nav-item-name { font-size: 12px; font-weight: 600; white-space: nowrap; }
.nav-item-desc { font-size: 9.5px; color: var(--text-muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.nav-live { font-size: 9px; margin-left: auto; color: var(--green); font-family: var(--font-mono); }
.sidebar-foot { padding: 8px 12px; border-top: 1px solid var(--border-line); font-size: 10px; color: var(--text-muted); font-family: var(--font-mono); display: flex; justify-content: space-between; }
.dot-ok { color: var(--green); } .dot-bad { color: var(--red); }

/* 顶栏 */
.topbar { background: rgba(8, 16, 29, 0.88); border-bottom: 1px solid var(--border-line); display: flex; align-items: center; justify-content: space-between; padding: 0 16px; gap: 12px; z-index: 15; }
.topbar-left, .topbar-right { display: flex; align-items: center; gap: 10px; }
.case-chip { font-family: var(--font-mono); font-size: 11px; color: var(--text-sec); border: 1px solid var(--border-line); padding: 5px 10px; border-radius: 4px; background: rgba(6, 13, 24, 0.6); white-space: nowrap; }
.case-chip b { color: var(--cyan); margin: 0 6px; }
.watermark { font-size: 11px; font-weight: 700; color: #ffd166; border: 1px solid rgba(255, 176, 32, 0.55); background: rgba(255, 176, 32, 0.12); padding: 5px 10px; border-radius: 4px; white-space: nowrap; }
.watermark.real, .demo-banner.real { color: #a7f3d0; border-color: rgba(16, 185, 129, 0.55); background: rgba(16, 185, 129, 0.12); }
.role-select { background: var(--bg-input); border: 1px solid var(--border-line); border-radius: 4px; padding: 5px 8px; color: var(--text-main); }
.ident { font-size: 11px; color: var(--text-sec); }

/* 主区 */
.main { overflow: auto; padding: 14px 18px 18px; min-width: 0; }
.page-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; margin-bottom: 12px; }
.page-title { font-size: 18px; font-weight: 800; display: flex; align-items: center; gap: 10px; letter-spacing: .5px; }
.page-sub { font-size: 11.5px; color: var(--text-sec); margin-top: 4px; line-height: 1.5; max-width: 820px; }
.page-actions { display: flex; gap: 8px; flex-shrink: 0; }

.panel { background: var(--bg-panel); border: 1px solid var(--border-line); border-radius: 8px; box-shadow: 0 8px 24px rgba(0, 0, 0, 0.35), inset 0 1px 0 rgba(59, 227, 255, 0.06);
  display: flex; flex-direction: column; min-height: 0; min-width: 0; position: relative; }
.panel::before { content: ""; position: absolute; left: 10px; top: -1px; width: 36px; height: 2px; background: var(--cyan); box-shadow: 0 0 8px var(--cyan); }
.panel-header { padding: 8px 12px; border-bottom: 1px solid var(--border-subtle); display: flex; align-items: center; justify-content: space-between; gap: 10px; }
.panel-title { font-size: 12.5px; font-weight: 700; display: flex; align-items: center; gap: 8px; letter-spacing: .3px; white-space: nowrap; }
.panel-title::before { content: ""; width: 4px; height: 13px; background: var(--cyan); border-radius: 1px; box-shadow: 0 0 6px var(--cyan); }
.panel-meta { font-size: 10.5px; color: var(--text-muted); font-family: var(--font-mono); display: flex; gap: 8px; align-items: center; }
.panel-body { padding: 10px 12px; flex: 1; min-height: 0; overflow: auto; }

.btn { display: inline-flex; align-items: center; justify-content: center; gap: 6px; padding: 6px 13px; border-radius: var(--radius-sm); font-size: 12px; font-weight: 600;
  color: var(--text-main); background: rgba(18, 35, 60, 0.85); border: 1px solid rgba(59, 227, 255, 0.32); cursor: pointer; white-space: nowrap; }
.btn:hover:not(:disabled) { border-color: var(--cyan); box-shadow: 0 0 10px rgba(59, 227, 255, 0.2); }
.btn:disabled { opacity: .45; cursor: not-allowed; }
.btn-primary { background: linear-gradient(135deg, rgba(59, 227, 255, 0.28), rgba(14, 116, 144, 0.45)); border-color: var(--cyan); color: #fff; box-shadow: 0 0 14px rgba(59, 227, 255, 0.22); }
.btn-sm { padding: 3px 8px; font-size: 11px; }
.btn-warn { border-color: rgba(255, 176, 32, 0.6); color: #ffd166; }
.btn-danger { border-color: rgba(255, 59, 92, 0.6); color: #ff8fa3; }
.input, .select { background: var(--bg-input); border: 1px solid var(--border-subtle); border-radius: 4px; padding: 4px 7px; color: var(--text-main); outline: none; }
.input:focus, .select:focus { border-color: var(--cyan); }

/* P6 组件 */
.p6-tag { font-size: 10px; font-family: var(--font-mono); color: var(--amber); border: 1px solid rgba(255, 176, 32, 0.45); background: rgba(255, 176, 32, 0.12); padding: 1px 6px; border-radius: 3px; white-space: nowrap; font-weight: 600; }
.p6-tag.cyan { color: var(--cyan); border-color: var(--border-line); background: var(--cyan-dim); }
.grid { display: grid; gap: 12px; min-height: 0; }
.p6-table { width: 100%; border-collapse: collapse; font-size: 11.5px; }
.p6-table th { text-align: left; font-weight: 600; color: var(--text-muted); font-family: var(--font-mono); font-size: 10px; letter-spacing: .4px; padding: 5px 7px;
  border-bottom: 1px solid var(--border-line); white-space: nowrap; background: rgba(59, 227, 255, 0.04); position: sticky; top: 0; }
.p6-table td { padding: 5px 7px; border-bottom: 1px solid var(--border-subtle); vertical-align: middle; }
.p6-table tbody tr { cursor: pointer; }
.p6-table tbody tr:hover td { background: rgba(59, 227, 255, 0.04); }
.p6-table tr.sel td { background: rgba(59, 227, 255, 0.1); }
.mono { font-family: var(--font-mono); font-size: 10.5px; white-space: nowrap; }
.p6-dim { color: var(--text-sec); } .p6-muted { color: var(--text-muted); }
.st { display: inline-block; font-size: 10px; font-weight: 700; padding: 1px 6px; border-radius: 3px; white-space: nowrap; font-family: var(--font-mono); }
.st-ok { color: var(--green); background: var(--green-dim); border: 1px solid rgba(16, 185, 129, .45); }
.st-bad { color: #ff8fa3; background: var(--red-dim); border: 1px solid rgba(255, 59, 92, .5); }
.st-warn { color: #ffd166; background: var(--amber-dim); border: 1px solid rgba(255, 176, 32, .45); }
.st-info { color: var(--cyan); background: var(--cyan-dim); border: 1px solid rgba(59, 227, 255, .4); }
.st-pur { color: #c4b5fd; background: rgba(167, 139, 250, .16); border: 1px solid rgba(167, 139, 250, .45); }
.st-mute { color: var(--text-sec); background: rgba(141, 164, 196, .1); border: 1px solid var(--border-subtle); }
.p6-note { font-size: 10.5px; color: var(--text-muted); line-height: 1.5; }
.p6-card { background: var(--bg-card); border: 1px solid var(--border-subtle); border-radius: 6px; padding: 8px 10px; }
.p6-metric { background: var(--bg-card); border: 1px solid var(--border-subtle); border-left: 3px solid var(--cyan); border-radius: 4px; padding: 7px 10px; }
.p6-metric .lbl { font-size: 10.5px; color: var(--text-sec); }
.p6-metric .val { font-size: 18px; font-weight: 700; font-family: var(--font-mono); color: #fff; line-height: 1.25; }
.p6-metric .val small { font-size: 11px; color: var(--text-sec); margin-left: 4px; font-weight: 500; }
.p6-metric.red { border-left-color: var(--red); } .p6-metric.red .val { color: var(--red); }
.p6-metric.green { border-left-color: var(--green); } .p6-metric.green .val { color: var(--green); }
.p6-metric.amber { border-left-color: var(--amber); } .p6-metric.amber .val { color: var(--amber); }
.p6-metric.pur { border-left-color: var(--purple); } .p6-metric.pur .val { color: #c4b5fd; }
.p6-agent { display: inline-flex; align-items: center; gap: 6px; font-size: 10.5px; color: #c4b5fd; background: rgba(167, 139, 250, 0.1); border: 1px dashed rgba(167, 139, 250, 0.5); border-radius: 4px; padding: 4px 8px; }
