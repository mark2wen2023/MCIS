        {
            foreach (var rule in new[] { ColregRuleId.R5, ColregRuleId.R7, ColregRuleId.R8 })
                Assert.Contains(Checks(r, rule, vessel), c => Overlaps(c, start, end) && c.Status != RuleCheckStatus.NotApplicable);
        }

