using System;
using System.Globalization;

namespace Mcis.Core
{
    /// <summary>
    /// 仿真相对时间（距案件纪元 CaseEpochUtc 的双精度秒数）。
    /// 系统内所有时间轴采样、插值、烘焙均以 SimTime 为唯一自变量。
    /// </summary>
    public readonly struct SimTime : IComparable<SimTime>, IEquatable<SimTime>
    {
        /// <summary>仿真零时刻。</summary>
        public static readonly SimTime Zero = new SimTime(0.0);

        /// <summary>距案件纪元的秒数（双精度）。</summary>
        public double Seconds { get; }

        /// <summary>构造仿真相对时间。</summary>
        public SimTime(double seconds)
        {
            Seconds = seconds;
        }

        /// <summary>转换为对应的 UTC 绝对时间。</summary>
        public DateTimeOffset ToUtc(DateTimeOffset caseEpochUtc)
        {
            return caseEpochUtc.AddSeconds(Seconds);
        }

        /// <summary>从 UTC 绝对时间与案件纪元换算仿真相对时间。</summary>
        public static SimTime FromUtc(DateTimeOffset timestampUtc, DateTimeOffset caseEpochUtc)
        {
            return new SimTime((timestampUtc - caseEpochUtc).TotalSeconds);
        }

        /// <summary>比较两个仿真时间。</summary>
        public int CompareTo(SimTime other)
        {
            return Seconds.CompareTo(other.Seconds);
        }

        /// <summary>判断两个仿真时间是否相等。</summary>
        public bool Equals(SimTime other)
        {
            return Seconds.Equals(other.Seconds);
        }

        /// <inheritdoc />
        public override bool Equals(object obj)
        {
            return obj is SimTime other && Equals(other);
        }

        /// <inheritdoc />
        public override int GetHashCode()
        {
            return Seconds.GetHashCode();
        }

        /// <inheritdoc />
        public override string ToString()
        {
            return string.Format(CultureInfo.InvariantCulture, "{0:F3}s", Seconds);
        }

        public static SimTime operator +(SimTime a, double deltaSeconds)
        {
            return new SimTime(a.Seconds + deltaSeconds);
        }

        public static SimTime operator -(SimTime a, double deltaSeconds)
        {
            return new SimTime(a.Seconds - deltaSeconds);
        }

        public static double operator -(SimTime a, SimTime b)
        {
            return a.Seconds - b.Seconds;
        }

        public static bool operator <(SimTime a, SimTime b)
        {
            return a.Seconds < b.Seconds;
        }

        public static bool operator >(SimTime a, SimTime b)
        {
            return a.Seconds > b.Seconds;
        }

        public static bool operator <=(SimTime a, SimTime b)
        {
            return a.Seconds <= b.Seconds;
        }

        public static bool operator >=(SimTime a, SimTime b)
        {
            return a.Seconds >= b.Seconds;
        }

        public static bool operator ==(SimTime a, SimTime b)
        {
            return a.Seconds == b.Seconds;
        }

        public static bool operator !=(SimTime a, SimTime b)
        {
            return a.Seconds != b.Seconds;
        }
    }
}
using System;
using System.Collections.Generic;

namespace Mcis.Core
{
    /// <summary>
    /// 通用操作结果包装结构，避免在高频或解析路径抛出异常。
    /// </summary>
    /// <typeparam name="T">结果值类型。</typeparam>
    public readonly struct Result<T> : IEquatable<Result<T>>
    {
        /// <summary>是否操作成功。</summary>
        public bool IsSuccess { get; }

        /// <summary>成功时的返回值。</summary>
        public T Value { get; }

        /// <summary>失败时的错误代码。</summary>
        public string ErrorCode { get; }

        /// <summary>失败时的错误描述信息。</summary>
        public string ErrorMessage { get; }

        /// <summary>构造操作结果。</summary>
        public Result(bool isSuccess, T value, string errorCode, string errorMessage)
        {
            IsSuccess = isSuccess;
            Value = value;
            ErrorCode = errorCode;
            ErrorMessage = errorMessage;
        }

        /// <summary>创建成功结果。</summary>
        public static Result<T> Ok(T value)
        {
            return new Result<T>(true, value, null, null);
        }

        /// <summary>创建失败结果。</summary>
        public static Result<T> Fail(string code, string message)
        {
            return new Result<T>(false, default(T), code, message);
        }

        /// <inheritdoc />
        public bool Equals(Result<T> other)
        {
            return IsSuccess == other.IsSuccess &&
                   EqualityComparer<T>.Default.Equals(Value, other.Value) &&
                   string.Equals(ErrorCode, other.ErrorCode, StringComparison.Ordinal) &&
                   string.Equals(ErrorMessage, other.ErrorMessage, StringComparison.Ordinal);
        }

        /// <inheritdoc />
        public override bool Equals(object obj)
        {
            return obj is Result<T> other && Equals(other);
        }

        /// <inheritdoc />
        public override int GetHashCode()
        {
            unchecked
            {
                int hash = IsSuccess.GetHashCode();
                hash = (hash * 397) ^ (Value != null ? EqualityComparer<T>.Default.GetHashCode(Value) : 0);
                hash = (hash * 397) ^ (ErrorCode != null ? ErrorCode.GetHashCode() : 0);
                hash = (hash * 397) ^ (ErrorMessage != null ? ErrorMessage.GetHashCode() : 0);
                return hash;
            }
        }

        /// <inheritdoc />
        public override string ToString()
        {
            if (IsSuccess)
            {
                return string.Format("Ok({0})", Value);
            }
            return string.Format("Fail[{0}]: {1}", ErrorCode, ErrorMessage);
        }
    }
}
using System;
using System.Globalization;

namespace Mcis.Domain.Common
{
    /// <summary>
    /// 局部切平面东-北-天坐标（单位：米，双精度）。
    /// </summary>
    public readonly struct EnuPosition : IEquatable<EnuPosition>
    {
        /// <summary>原点零位置。</summary>
        public static readonly EnuPosition Zero = new EnuPosition(0.0, 0.0, 0.0);

        /// <summary>东向距离（米）。</summary>
        public double EastM { get; }

        /// <summary>北向距离（米）。</summary>
        public double NorthM { get; }

        /// <summary>天向高度（米）。</summary>
        public double UpM { get; }

        /// <summary>构造局部切平面 ENU 坐标。</summary>
        public EnuPosition(double eastM, double northM, double upM = 0.0)
        {
            EastM = eastM;
            NorthM = northM;
            UpM = upM;
        }

        /// <summary>水平面二维分量 (East, North)。</summary>
        public Double2 Horizontal
        {
            get { return new Double2(EastM, NorthM); }
        }

        /// <summary>转换为三维双精度向量 (East, North, Up)。</summary>
        public Double3 ToDouble3()
        {
            return new Double3(EastM, NorthM, UpM);
        }

        /// <summary>计算与另一 ENU 点的水平欧氏距离（米）。</summary>
        public double HorizontalDistanceTo(EnuPosition other)
        {
            double de = other.EastM - EastM;
            double dn = other.NorthM - NorthM;
            return Math.Sqrt(de * de + dn * dn);
        }

        /// <inheritdoc />
        public bool Equals(EnuPosition other)
        {
            return EastM.Equals(other.EastM) && NorthM.Equals(other.NorthM) && UpM.Equals(other.UpM);
        }

        /// <inheritdoc />
        public override bool Equals(object obj)
        {
            return obj is EnuPosition other && Equals(other);
        }

        /// <inheritdoc />
        public override int GetHashCode()
        {
            unchecked
            {
                int hash = EastM.GetHashCode();
                hash = (hash * 397) ^ NorthM.GetHashCode();
                hash = (hash * 397) ^ UpM.GetHashCode();
                return hash;
            }
        }

        /// <inheritdoc />
        public override string ToString()
        {
            return string.Format(CultureInfo.InvariantCulture, "ENU({0:F3}m, {1:F3}m, {2:F3}m)", EastM, NorthM, UpM);
        }
    }

    /// <summary>
    /// AIS 消息 5 / 24 尺寸参数（GPS 天线距离船首 A、船尾 B、左舷 C、右舷 D，单位：米）。
    /// 用于将天线定位点修正至船舶几何中心。
    /// </summary>
    public readonly struct AntennaOffset : IEquatable<AntennaOffset>
    {
        /// <summary>零偏移。</summary>
        public static readonly AntennaOffset Zero = new AntennaOffset(0f, 0f, 0f, 0f);

        /// <summary>天线距船首距离 A（米）。</summary>
        public float ToBowA { get; }

        /// <summary>天线距船尾距离 B（米）。</summary>
        public float ToSternB { get; }

        /// <summary>天线距左舷距离 C（米）。</summary>
        public float ToPortC { get; }

        /// <summary>天线距右舷距离 D（米）。</summary>
        public float ToStarboardD { get; }

        /// <summary>构造天线偏移参数。</summary>
        public AntennaOffset(float toBowA, float toSternB, float toPortC, float toStarboardD)
        {
            ToBowA = toBowA;
            ToSternB = toSternB;
            ToPortC = toPortC;
            ToStarboardD = toStarboardD;
        }

        /// <summary>船舶总长 LOA = A + B（米）。</summary>
        public float LoaM
        {
            get { return ToBowA + ToSternB; }
        }

        /// <summary>船舶型宽 Beam = C + D（米）。</summary>
        public float BeamM
        {
            get { return ToPortC + ToStarboardD; }
        }

        /// <summary>
        /// 船中心相对于天线的船体局部偏移（X=横向右舷为正 (C-D)/2 或 (D-C)/2，Y=纵向船首为正 (A-B)/2，单位：米）。
        /// 按 ARCHITECTURE 4.2.5：纵向 Δx = (A - B)/2（前向为正），横向 Δy = (C - D)/2（右舷为正：天线偏左时 C&lt;D，中心在右舷正方向 (D-C)/2；若天线距左舷 C、距右舷 D，船宽中心距左舷 (C+D)/2，故相对天线向右舷偏移为 (D-C)/2，向前偏移为 (A-B)/2）。
        /// 返回 Double2(StarboardOffset, ForwardOffset)。
        /// </summary>
        public Double2 CenterOffsetFromAntenna
        {
            get
            {
                return new Double2(
                    (ToStarboardD - ToPortC) * 0.5,
                    (ToBowA - ToSternB) * 0.5);
            }
        }

        /// <summary>根据船首向（真北顺时针角度）将船体中心相对天线的偏移转换为 ENU 位移增量（米）。</summary>
        public Double2 ToEnuOffset(double headingDeg)
        {
            double rad = headingDeg * (Math.PI / 180.0);
            double sinH = Math.Sin(rad);
            double cosH = Math.Cos(rad);
            double forward = (ToBowA - ToSternB) * 0.5;
            double starboard = (ToStarboardD - ToPortC) * 0.5;
            double dEast = forward * sinH + starboard * cosH;
            double dNorth = forward * cosH - starboard * sinH;
            return new Double2(dEast, dNorth);
        }

        /// <inheritdoc />
        public bool Equals(AntennaOffset other)
        {
            return ToBowA.Equals(other.ToBowA) &&
                   ToSternB.Equals(other.ToSternB) &&
                   ToPortC.Equals(other.ToPortC) &&
                   ToStarboardD.Equals(other.ToStarboardD);
        }

        /// <inheritdoc />
        public override bool Equals(object obj)
        {
            return obj is AntennaOffset other && Equals(other);
        }

        /// <inheritdoc />
        public override int GetHashCode()
        {
            unchecked
            {
                int hash = ToBowA.GetHashCode();
                hash = (hash * 397) ^ ToSternB.GetHashCode();
                hash = (hash * 397) ^ ToPortC.GetHashCode();
                hash = (hash * 397) ^ ToStarboardD.GetHashCode();
                return hash;
            }
        }
    }

    /// <summary>运动学样本来源标记（贯穿清洗、插值、HUD 显示与报告审计）。</summary>
    public enum SampleProvenance : byte
    {
        /// <summary>原始传感器实测（AIS / VDR GPS）。</summary>
        Measured = 0,
        /// <summary>正常间隔内插值（线性 / Hermite）。</summary>
        Interpolated = 1,
        /// <summary>时间缺口（TimeGap）跨越插值。</summary>
        LowConfidence = 2,
        /// <summary>航位推算外推（DR）。</summary>
        DeadReckoned = 3,
        /// <summary>调查员手绘关键点样条。</summary>
        ManualDrawn = 4,
        /// <summary>操纵模型假设推演或人工推定。</summary>
        Presumed = 5,
        /// <summary>已被异常检测剔除。</summary>
        Rejected = 6
    }

    /// <summary>时间戳质量等级。</summary>
    public enum TimeQuality : byte
    {
        /// <summary>岸基 AIS Tag Block UNIX 秒时间戳或 VDR $GPZDA。</summary>
        ExactTagBlock = 0,
        /// <summary>接收软件日志行前缀时间。</summary>
        LogPrefix = 1,
        /// <summary>利用 AIS 秒字段修正后的就近分钟对齐时间。</summary>
        MinuteAligned = 2,
        /// <summary>无绝对时间，按起始时间与接收顺序推算。</summary>
        Estimated = 3
    }

    /// <summary>AIS 异常点剔除或告警原因代码（兼容 ARCHITECTURE 5.1 与 P1_TASK_A 命名）。</summary>
    public enum RejectReason : byte
    {
        /// <summary>无异常。</summary>
        None = 0,
        /// <summary>NMEA 异或校验和失败。</summary>
        ChecksumError = 1,
        /// <summary>字段非法或不可用值（如 Lon=181, Lat=91）。</summary>
        InvalidField = 2,
        /// <summary>不可用值（同 InvalidField 细分）。</summary>
        Unavailable = 9,
        /// <summary>经纬度或航速数值越界。</summary>
        OutOfRange = 10,
        /// <summary>同 MMSI 时间戳重复。</summary>
        Duplicate = 3,
        /// <summary>时间戳重复（同 Duplicate）。</summary>
        DuplicateTimestamp = 3,
        /// <summary>时间倒序且重排后仍冲突。</summary>
        TimeReversal = 4,
        /// <summary>乱序（同 TimeReversal）。</summary>
        OutOfOrder = 4,
        /// <summary>相邻点隐含航速超过船型物理门限。</summary>
        SpeedGate = 5,
        /// <summary>位置跳变 / 隐含航速超阈（同 SpeedGate）。</summary>
        PositionJump = 5,
        /// <summary>报告 SOG 航速突变超限。</summary>
        SpeedJump = 11,
        /// <summary>航向突变或与位移严重不符。</summary>
        CourseJump = 12,
        /// <summary>前后双向航位推算残差均超限。</summary>
        DrResidual = 6,
        /// <summary>滑动窗口 Hampel 离群滤波剔除。</summary>
        Hampel = 7,
        /// <summary>字段不一致（如 SOG≈0 但位置持续漂移，仅标记不剔除）。</summary>
        Inconsistent = 8
    }

    /// <summary>船舶运动控制模式。</summary>
    public enum ControlMode : byte
    {
        /// <summary>严格按清洗插值后的 AIS 航迹回放。</summary>
        AisReplay = 0,
        /// <summary>调查员海图手绘样条轨迹。</summary>
        DrawnPath = 1,
        /// <summary>Nomoto 操纵模型推演。</summary>
        ManeuverModel = 2,
        /// <summary>碰撞后物理驱动。</summary>
        PhysicsDriven = 3
    }

    /// <summary>航迹插值算法模式。</summary>
    public enum InterpolationMode : byte
    {
        /// <summary>线性插值。</summary>
        Linear = 0,
        /// <summary>三次 Hermite 插值。</summary>
        CubicHermite = 1,
        /// <summary>Catmull-Rom 样条插值。</summary>
        CatmullRom = 2
    }

    /// <summary>时间缺口处理策略。</summary>
    public enum GapPolicy : byte
    {
        /// <summary>Hermite/线性连接但标记 LowConfidence（虚线显示）。</summary>
        ConnectDashed = 0,
        /// <summary>按缺口前最后有效 SOG/COG 航位推算。</summary>
        DeadReckon = 1,
        /// <summary>缺口时段隐藏船舶 / 拒绝外推。</summary>
        HideVessel = 2
    }

    /// <summary>碰撞风险等级。</summary>
    public enum RiskLevel : byte
    {
        /// <summary>安全（青/绿色）。</summary>
        Safe = 0,
        /// <summary>警告（琥珀色）。</summary>
        Warning = 1,
        /// <summary>危险（红色）。</summary>
        Danger = 2
    }
}
using System;
using System.Globalization;

namespace Mcis.Domain.Common
{
    /// <summary>
    /// 纯 C# 双精度二维向量（替代 Unity.Mathematics.double2，用于水平面东/北速度与位移计算）。
    /// </summary>
    public readonly struct Double2 : IEquatable<Double2>
    {
        /// <summary>零向量。</summary>
        public static readonly Double2 Zero = new Double2(0.0, 0.0);

        /// <summary>X 分量（通常对应东向 East）。</summary>
        public double X { get; }

        /// <summary>Y 分量（通常对应北向 North）。</summary>
        public double Y { get; }

        /// <summary>构造二维双精度向量。</summary>
        public Double2(double x, double y)
        {
            X = x;
            Y = y;
        }

        /// <summary>向量模长平方。</summary>
        public double LengthSquared
        {
            get { return X * X + Y * Y; }
        }

        /// <summary>向量模长。</summary>
        public double Length
        {
            get { return Math.Sqrt(X * X + Y * Y); }
        }

        /// <summary>二维向量点积。</summary>
        public static double Dot(Double2 a, Double2 b)
        {
            return a.X * b.X + a.Y * b.Y;
        }

        /// <summary>二维向量叉积标量（a.X * b.Y - a.Y * b.X）。</summary>
        public static double Cross(Double2 a, Double2 b)
        {
            return a.X * b.Y - a.Y * b.X;
        }

        public static Double2 operator +(Double2 a, Double2 b)
        {
            return new Double2(a.X + b.X, a.Y + b.Y);
        }

        public static Double2 operator -(Double2 a, Double2 b)
        {
            return new Double2(a.X - b.X, a.Y - b.Y);
        }

        public static Double2 operator *(Double2 a, double s)
        {
            return new Double2(a.X * s, a.Y * s);
        }

        public static Double2 operator *(double s, Double2 a)
        {
            return new Double2(a.X * s, a.Y * s);
        }

        public static Double2 operator /(Double2 a, double s)
        {
            return new Double2(a.X / s, a.Y / s);
        }

        /// <inheritdoc />
        public bool Equals(Double2 other)
        {
            return X.Equals(other.X) && Y.Equals(other.Y);
        }

        /// <inheritdoc />
        public override bool Equals(object obj)
        {
            return obj is Double2 other && Equals(other);
        }

        /// <inheritdoc />
        public override int GetHashCode()
        {
            unchecked
            {
                return (X.GetHashCode() * 397) ^ Y.GetHashCode();
            }
        }

        /// <inheritdoc />
        public override string ToString()
        {
            return string.Format(CultureInfo.InvariantCulture, "({0:F4}, {1:F4})", X, Y);
        }
    }

    /// <summary>
    /// 纯 C# 双精度三维向量（替代 Unity.Mathematics.double3，用于 ECEF 坐标与 Unity 局部空间双精度表示）。
    /// </summary>
    public readonly struct Double3 : IEquatable<Double3>
    {
        /// <summary>零向量。</summary>
        public static readonly Double3 Zero = new Double3(0.0, 0.0, 0.0);

        /// <summary>X 分量。</summary>
        public double X { get; }

        /// <summary>Y 分量。</summary>
        public double Y { get; }

        /// <summary>Z 分量。</summary>
        public double Z { get; }

        /// <summary>构造三维双精度向量。</summary>
        public Double3(double x, double y, double z)
        {
            X = x;
            Y = y;
            Z = z;
        }

        /// <summary>向量模长。</summary>
        public double Length
        {
            get { return Math.Sqrt(X * X + Y * Y + Z * Z); }
        }

        public static Double3 operator +(Double3 a, Double3 b)
        {
            return new Double3(a.X + b.X, a.Y + b.Y, a.Z + b.Z);
        }

        public static Double3 operator -(Double3 a, Double3 b)
        {
            return new Double3(a.X - b.X, a.Y - b.Y, a.Z - b.Z);
        }

        public static Double3 operator *(Double3 a, double s)
        {
            return new Double3(a.X * s, a.Y * s, a.Z * s);
        }

        /// <inheritdoc />
        public bool Equals(Double3 other)
        {
            return X.Equals(other.X) && Y.Equals(other.Y) && Z.Equals(other.Z);
        }

        /// <inheritdoc />
        public override bool Equals(object obj)
        {
            return obj is Double3 other && Equals(other);
        }

        /// <inheritdoc />
        public override int GetHashCode()
        {
            unchecked
            {
                int hash = X.GetHashCode();
                hash = (hash * 397) ^ Y.GetHashCode();
                hash = (hash * 397) ^ Z.GetHashCode();
                return hash;
            }
        }

        /// <inheritdoc />
        public override string ToString()
        {
            return string.Format(CultureInfo.InvariantCulture, "({0:F4}, {1:F4}, {2:F4})", X, Y, Z);
        }
    }

    /// <summary>
    /// WGS84 大地坐标（经度 LonDeg、纬度 LatDeg 单位为十进制度；椭球高 HeightM 单位为米）。
    /// </summary>
    public readonly struct GeoCoord : IEquatable<GeoCoord>
    {
        /// <summary>经度（十进制度，东经为正，[-180, 180]）。</summary>
        public double LonDeg { get; }

        /// <summary>纬度（十进制度，北纬为正，[-90, 90]）。</summary>
        public double LatDeg { get; }

        /// <summary>相对 WGS84 椭球面的大地高（米）。</summary>
        public double HeightM { get; }

        /// <summary>构造大地坐标。</summary>
        public GeoCoord(double lonDeg, double latDeg, double heightM = 0.0)
        {
            LonDeg = lonDeg;
            LatDeg = latDeg;
            HeightM = heightM;
        }

        /// <inheritdoc />
        public bool Equals(GeoCoord other)
        {
            return LonDeg.Equals(other.LonDeg) && LatDeg.Equals(other.LatDeg) && HeightM.Equals(other.HeightM);
        }

        /// <inheritdoc />
        public override bool Equals(object obj)
        {
            return obj is GeoCoord other && Equals(other);
        }

        /// <inheritdoc />
        public override int GetHashCode()
        {
            unchecked
            {
                int hash = LonDeg.GetHashCode();
                hash = (hash * 397) ^ LatDeg.GetHashCode();
                hash = (hash * 397) ^ HeightM.GetHashCode();
                return hash;
            }
        }

        /// <inheritdoc />
        public override string ToString()
        {
            return string.Format(CultureInfo.InvariantCulture, "({0:F6}°, {1:F6}°, {2:F2}m)", LonDeg, LatDeg, HeightM);
        }
    }
