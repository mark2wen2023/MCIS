using System;
using Mcis.Core;
using Mcis.Domain.Common;
using Mcis.Domain.Models;

namespace Mcis.Domain.Cpa
{
    /// <summary>
    /// DCPA / TCPA 核心解算器（对应 ARCHITECTURE.md 4.6 节与论文 thesis.txt 3.4 节）。
    /// 提供平面向量法与雷达标绘矢量三角形公式法两种严格等价的实现。
    /// </summary>
    public static partial class CpaCalculator
    {
        /// <summary>标准海里米数（1 nm = 1852 m）。</summary>
        public const double MetersPerNauticalMile = 1852.0;

        /// <summary>每分钟秒数（60 s）。</summary>
        public const double SecondsPerMinute = 60.0;

        /// <summary>每小时秒数（3600 s）。</summary>
        public const double SecondsPerHour = 3600.0;

        /// <summary>节转米每秒系数（1 kn = 1852 / 3600 m/s）。</summary>
        public const double MetersPerSecondPerKnot = MetersPerNauticalMile / SecondsPerHour;

        /// <summary>相对静止退化判定默认阈值（0.01 m/s，对应 ARCHITECTURE.md 4.6.1 节）。</summary>
        public const double DefaultDegenerateSpeedMps = 0.01;

        /// <summary>相对静止退化判定默认阈值（节，约 0.01943844 kn）。</summary>
        public const double DefaultDegenerateSpeedKn = DefaultDegenerateSpeedMps / MetersPerSecondPerKnot;

        /// <summary>
        /// 向量法计算 DCPA / TCPA（SI 单位输入：位置为 ENU 米，速度为东/北 m/s）。
        /// 公式：
        /// r = P_t - P_o
        /// v = V_t - V_o
        /// TCPA = -(r · v) / |v|²
        /// DCPA = |r + v · TCPA|
        /// 当 |v| &lt; ε 时判为退化（相对静止），DCPA = |r|，TCPA = +∞，IsDegenerate = true。
        /// </summary>
        public static CpaResult CalculateByVector(
            EnuPosition ownPosition,
            Double2 ownVelocityMps,
            EnuPosition targetPosition,
            Double2 targetVelocityMps,
            CpaPairKey pair = default,
            SimTime time = default,
            RiskLevel riskLevel = RiskLevel.Safe,
            double hullClearanceM = double.NaN,
            double degenerateSpeedEpsilonMps = DefaultDegenerateSpeedMps)
        {
            double rx = targetPosition.EastM - ownPosition.EastM;
            double ry = targetPosition.NorthM - ownPosition.NorthM;
            double currentDistanceM = Math.Sqrt(rx * rx + ry * ry);

            double vx = targetVelocityMps.X - ownVelocityMps.X;
            double vy = targetVelocityMps.Y - ownVelocityMps.Y;
            double vSq = vx * vx + vy * vy;
            double relSpeedMps = Math.Sqrt(vSq);

            double trueBearingDeg = currentDistanceM > 1e-12
                ? NormalizeAngleDeg(Math.Atan2(rx, ry) * (180.0 / Math.PI))
                : 0.0;

            double eps = degenerateSpeedEpsilonMps > 0.0 ? degenerateSpeedEpsilonMps : DefaultDegenerateSpeedMps;
            bool isDegenerate = relSpeedMps < eps;

            double relCourseDeg;
            double tcpaSec;
            double dcpaM;
            EnuPosition ownCpaEnu;
            EnuPosition targetCpaEnu;
            bool isDiverging;

            if (isDegenerate)
            {
                relCourseDeg = 0.0;
                tcpaSec = double.PositiveInfinity;
                dcpaM = currentDistanceM;
                ownCpaEnu = ownPosition;
                targetCpaEnu = targetPosition;
                isDiverging = false;
            }
            else
            {
                relCourseDeg = NormalizeAngleDeg(Math.Atan2(vx, vy) * (180.0 / Math.PI));
                double rDotV = rx * vx + ry * vy;
                tcpaSec = -rDotV / vSq;

                double cpaRx = rx + vx * tcpaSec;
                double cpaRy = ry + vy * tcpaSec;
                dcpaM = Math.Sqrt(cpaRx * cpaRx + cpaRy * cpaRy);

                ownCpaEnu = new EnuPosition(
                    ownPosition.EastM + ownVelocityMps.X * tcpaSec,
                    ownPosition.NorthM + ownVelocityMps.Y * tcpaSec,
                    ownPosition.UpM);
                targetCpaEnu = new EnuPosition(
                    targetPosition.EastM + targetVelocityMps.X * tcpaSec,
                    targetPosition.NorthM + targetVelocityMps.Y * tcpaSec,
                    targetPosition.UpM);
                isDiverging = tcpaSec < 0.0;
            }

            double clearance = double.IsNaN(hullClearanceM) ? currentDistanceM : hullClearanceM;

            return new CpaResult(
                pair,
                time,
                currentDistanceM,
                clearance,
                trueBearingDeg,
                relCourseDeg,
                relSpeedMps,
                dcpaM,
                tcpaSec,
                ownCpaEnu,
                targetCpaEnu,
                isDiverging,
                isDegenerate,
                riskLevel);
        }

        /// <summary>
        /// 向量法计算 DCPA / TCPA（航海单位输入：位置为海里 nm，速度为节 kn）。
        /// 返回的 CpaResult 可直接读取 DcpaNm（海里）、TcpaMin（分钟）、CurrentDistanceNm（海里）以及对应 SI 属性。
        /// </summary>
        public static CpaResult CalculateByVector(
            Double2 ownPositionNm,
            Double2 ownVelocityKn,
            Double2 targetPositionNm,
            Double2 targetVelocityKn,
            CpaPairKey pair = default,
            SimTime time = default,
            RiskLevel riskLevel = RiskLevel.Safe,
            double degenerateSpeedEpsilonKn = DefaultDegenerateSpeedKn)
        {
            EnuPosition ownEnu = new EnuPosition(
                ownPositionNm.X * MetersPerNauticalMile,
                ownPositionNm.Y * MetersPerNauticalMile,
                0.0);
            EnuPosition targetEnu = new EnuPosition(
                targetPositionNm.X * MetersPerNauticalMile,
                targetPositionNm.Y * MetersPerNauticalMile,
                0.0);
            Double2 ownVelMps = new Double2(
                ownVelocityKn.X * MetersPerSecondPerKnot,
                ownVelocityKn.Y * MetersPerSecondPerKnot);
            Double2 targetVelMps = new Double2(
                targetVelocityKn.X * MetersPerSecondPerKnot,
                targetVelocityKn.Y * MetersPerSecondPerKnot);

            double epsMps = (degenerateSpeedEpsilonKn > 0.0 ? degenerateSpeedEpsilonKn : DefaultDegenerateSpeedKn)
                            * MetersPerSecondPerKnot;

            return CalculateByVector(
                ownEnu, ownVelMps, targetEnu, targetVelMps,
                pair, time, riskLevel, double.NaN, epsMps);
        }

        /// <summary>
        /// 从两船状态（VesselMotionState）按向量法计算 DCPA / TCPA。
        /// </summary>
        public static CpaResult CalculateFromStates(
            VesselMotionState ownState,
            VesselMotionState targetState,
            CpaPairKey pair = default,
            SimTime? timeOverride = null,
            RiskLevel riskLevel = RiskLevel.Safe,
            double degenerateSpeedEpsilonMps = DefaultDegenerateSpeedMps)
        {
            SimTime t = timeOverride ?? new SimTime(ownState.TimeSeconds);
            return CalculateByVector(
                ownState.EnuPositionM,
                ownState.VelocityEnuMps,
                targetState.EnuPositionM,
                targetState.VelocityEnuMps,
                pair,
                t,
                riskLevel,
                double.NaN,
                degenerateSpeedEpsilonMps);
        }

        /// <summary>
        /// 从两船航迹样本（TrackSample）按向量法计算 DCPA / TCPA。
        /// </summary>
        public static CpaResult CalculateFromSamples(
            TrackSample ownSample,
            TrackSample targetSample,
            CpaPairKey pair = default,
            bool useRawSogCog = false,
            RiskLevel riskLevel = RiskLevel.Safe,
            double degenerateSpeedEpsilonMps = DefaultDegenerateSpeedMps)
        {
            VesselMotionState ownState = VesselMotionState.FromTrackSample(ownSample, useRawSogCog);
            VesselMotionState targetState = VesselMotionState.FromTrackSample(targetSample, useRawSogCog);
            return CalculateFromStates(ownState, targetState, pair, ownSample.Time, riskLevel, degenerateSpeedEpsilonMps);
        }
    }
}
using System;
using System.Globalization;
using Mcis.Core;
using Mcis.Domain.Common;
using Mcis.Domain.Models;

namespace Mcis.Domain.Models
{
    /// <summary>
    /// CPA 风险分级阈值与滞回配置（对应 ARCHITECTURE.md 4.6.3 与 5.2 节）。
    /// 默认单位：DCPA 为海里 (nm)，TCPA 为分钟 (min)，滞回保持时长为秒 (s)。
    /// </summary>
    public readonly struct RiskThresholds : IEquatable<RiskThresholds>
    {
        /// <summary>默认配置（Danger: DCPA&lt;0.3nm 且 0&lt;TCPA&lt;6min；Warning: DCPA&lt;1.0nm 且 0&lt;TCPA&lt;12min；滞回 1s，裕度 10%）。</summary>
        public static readonly RiskThresholds Default = new RiskThresholds(
            "Default", 0.3, 6.0, 1.0, 12.0, 1.0, 0.1);

        /// <summary>预设方案名称。</summary>
        public string PresetName { get; }

        /// <summary>危险级（Danger）DCPA 阈值（海里，默认 0.3 nm）。</summary>
        public double DangerDcpaNm { get; }

        /// <summary>危险级（Danger）TCPA 阈值（分钟，默认 6.0 min）。</summary>
        public double DangerTcpaMin { get; }

        /// <summary>警告级（Warning）DCPA 阈值（海里，默认 1.0 nm）。</summary>
        public double WarningDcpaNm { get; }

        /// <summary>警告级（Warning）TCPA 阈值（分钟，默认 12.0 min）。</summary>
        public double WarningTcpaMin { get; }

        /// <summary>风险降级保持确认时长 N（秒，默认 1.0 s）。</summary>
        public double HysteresisSeconds { get; }

        /// <summary>风险降级相对裕度比例（降级需越过 阈值×(1+裕度)，默认 0.1 即 10%）。</summary>
        public double DowngradeMarginRatio { get; }

        /// <summary>构造 CPA 风险阈值配置。</summary>
        public RiskThresholds(
            string presetName,
            double dangerDcpaNm = 0.3,
            double dangerTcpaMin = 6.0,
            double warningDcpaNm = 1.0,
            double warningTcpaMin = 12.0,
            double hysteresisSeconds = 1.0,
            double downgradeMarginRatio = 0.1)
        {
            PresetName = presetName ?? "Default";
            DangerDcpaNm = dangerDcpaNm > 0.0 ? dangerDcpaNm : 0.3;
            DangerTcpaMin = dangerTcpaMin > 0.0 ? dangerTcpaMin : 6.0;
            WarningDcpaNm = warningDcpaNm > 0.0 ? warningDcpaNm : 1.0;
            WarningTcpaMin = warningTcpaMin > 0.0 ? warningTcpaMin : 12.0;
            HysteresisSeconds = hysteresisSeconds >= 0.0 ? hysteresisSeconds : 0.0;
            DowngradeMarginRatio = downgradeMarginRatio >= 0.0 ? downgradeMarginRatio : 0.0;
        }

        /// <inheritdoc />
        public bool Equals(RiskThresholds other)
        {
            return string.Equals(PresetName, other.PresetName, StringComparison.Ordinal) &&
                   DangerDcpaNm.Equals(other.DangerDcpaNm) &&
                   DangerTcpaMin.Equals(other.DangerTcpaMin) &&
                   WarningDcpaNm.Equals(other.WarningDcpaNm) &&
                   WarningTcpaMin.Equals(other.WarningTcpaMin) &&
                   HysteresisSeconds.Equals(other.HysteresisSeconds) &&
                   DowngradeMarginRatio.Equals(other.DowngradeMarginRatio);
        }

        /// <inheritdoc />
        public override bool Equals(object obj)
        {
            return obj is RiskThresholds other && Equals(other);
        }

        /// <inheritdoc />
        public override int GetHashCode()
        {
            unchecked
            {
                int hash = PresetName != null ? PresetName.GetHashCode() : 0;
                hash = (hash * 397) ^ DangerDcpaNm.GetHashCode();
                hash = (hash * 397) ^ DangerTcpaMin.GetHashCode();
                hash = (hash * 397) ^ WarningDcpaNm.GetHashCode();
                hash = (hash * 397) ^ WarningTcpaMin.GetHashCode();
                hash = (hash * 397) ^ HysteresisSeconds.GetHashCode();
                hash = (hash * 397) ^ DowngradeMarginRatio.GetHashCode();
                return hash;
            }
        }
    }
}

namespace Mcis.Domain.Cpa
{
    /// <summary>
    /// 轻量级船舶水平运动学状态（供 CPA 委托采样与解算使用，支持海里/节与米/米每秒双单位互转）。
    /// </summary>
    public readonly struct VesselMotionState
    {
        /// <summary>一海里对应的米数（1852.0 m）。</summary>
        public const double MetersPerNm = 1852.0;

        /// <summary>一节对应的米每秒（1852.0 / 3600.0 m/s）。</summary>
        public const double MpsPerKnot = 1852.0 / 3600.0;

        /// <summary>仿真相对时间（秒）。</summary>
        public double TimeSeconds { get; }

        /// <summary>东向坐标（海里）。</summary>
        public double EastNm { get; }

        /// <summary>北向坐标（海里）。</summary>
        public double NorthNm { get; }

        /// <summary>东向速度分量（节）。</summary>
        public double VelocityEastKn { get; }

        /// <summary>北向速度分量（节）。</summary>
        public double VelocityNorthKn { get; }

        /// <summary>对地航速 SOG（节）。</summary>
        public double SpeedKn { get; }

        /// <summary>对地航向 COG（真北顺时针度，0..360°）。</summary>
        public double CourseDeg { get; }

        /// <summary>局部 ENU 位置（米）。</summary>
        public EnuPosition EnuPositionM
        {
            get { return new EnuPosition(EastNm * MetersPerNm, NorthNm * MetersPerNm, 0.0); }
        }

        /// <summary>局部 ENU 速度分量（米/秒）。</summary>
        public Double2 VelocityEnuMps
        {
            get { return new Double2(VelocityEastKn * MpsPerKnot, VelocityNorthKn * MpsPerKnot); }
        }

        /// <summary>按海里位置（EastNm, NorthNm）、航速（节）与真北航向（度）构造运动状态。</summary>
        public VesselMotionState(double eastNm, double northNm, double speedKn, double courseDeg, double timeSeconds = 0.0)
        {
            TimeSeconds = timeSeconds;
            EastNm = eastNm;
            NorthNm = northNm;
            SpeedKn = speedKn;
            CourseDeg = NormalizeAngleDeg(courseDeg);
            double rad = CourseDeg * (Math.PI / 180.0);
            VelocityEastKn = speedKn * Math.Sin(rad);
            VelocityNorthKn = speedKn * Math.Cos(rad);
        }

        private VesselMotionState(
            double timeSeconds, double eastNm, double northNm,
            double veKn, double vnKn, double speedKn, double courseDeg)
        {
            TimeSeconds = timeSeconds;
            EastNm = eastNm;
            NorthNm = northNm;
            VelocityEastKn = veKn;
            VelocityNorthKn = vnKn;
            SpeedKn = speedKn;
            CourseDeg = NormalizeAngleDeg(courseDeg);
        }

        /// <summary>按海里位置与东/北速度分量（节）构造运动状态。</summary>
        public static VesselMotionState FromVelocityKn(double eastNm, double northNm, double veKn, double vnKn, double timeSeconds = 0.0)
        {
            double speed = Math.Sqrt(veKn * veKn + vnKn * vnKn);
            double cog = speed > 1e-12 ? NormalizeAngleDeg(Math.Atan2(veKn, vnKn) * (180.0 / Math.PI)) : 0.0;
            return new VesselMotionState(timeSeconds, eastNm, northNm, veKn, vnKn, speed, cog);
        }

        /// <summary>按 SI 单位（米、米/秒）构造运动状态。</summary>
        public static VesselMotionState FromEnuMeters(EnuPosition enuM, Double2 velocityMps, double timeSeconds = 0.0)
        {
            return FromVelocityKn(
                enuM.EastM / MetersPerNm,
                enuM.NorthM / MetersPerNm,
                velocityMps.X / MpsPerKnot,
                velocityMps.Y / MpsPerKnot,
                timeSeconds);
        }

        /// <summary>从 TrackSample 转换为船舶运动状态。</summary>
        public static VesselMotionState FromTrackSample(TrackSample sample, bool useRawSogCog = false)
        {
            if (useRawSogCog && sample.SogMps >= 0f && !float.IsNaN(sample.CogDeg))
            {
                return new VesselMotionState(
                    sample.EnuCenter.EastM / MetersPerNm,
                    sample.EnuCenter.NorthM / MetersPerNm,
                    sample.SogMps / MpsPerKnot,
                    sample.CogDeg,
                    sample.Time.Seconds);
            }
            return FromEnuMeters(sample.EnuCenter, sample.VelocityEnuMps, sample.Time.Seconds);
        }

        /// <summary>隐式从 TrackSample 转换。</summary>
        public static implicit operator VesselMotionState(TrackSample sample)
        {
            return FromTrackSample(sample, false);
        }

        private static double NormalizeAngleDeg(double deg)
        {
            double m = deg % 360.0;
            return m < 0.0 ? m + 360.0 : m;
        }
    }
}
using System;
using Mcis.Core;
using Mcis.Domain.Common;
using Mcis.Domain.Models;

namespace Mcis.Domain.Cpa
{
    public static partial class CpaCalculator
    {
        /// <summary>
        /// 按论文 thesis.txt 3.4 节雷达标绘矢量三角形公式计算 DCPA / TCPA（航海单位：航速为节 kn，航向/方位为度 °，距离为海里 nm）。
        ///
        /// 【严格数学推导（对应 thesis.txt 3.4 节 Figure 6 船舶会遇矢量三角形 ABC 与 ARCHITECTURE.md 4.6.2 节）】
        /// 1. 设真北为 +N 轴（0°），正东为 +E 轴（90°），角度均按真北顺时针度量：
        ///    - 本船航速 Vo（节），真航向 Co（度） ⇒ 本船速度向量 Vo_vec = (Vo·sin(Co), Vo·cos(Co))
        ///    - 目标船航速 Vt（节），真航向 Ct（度） ⇒ 目标船速度向量 Vt_vec = (Vt·sin(Ct), Vt·cos(Ct))
        ///    - 目标船相对本船真方位为 Q（度），距离为 D（海里） ⇒ 初始相对位置 r0 = (D·sin(Q), D·cos(Q))
        ///
        /// 2. 在速度矢量三角形 ABC 中（V_r = V_t - V_o），Vo_vec 与 Vt_vec 夹角为 (Ct - Co)，由余弦定理得相对速度大小 Vr：
        ///    Vr = sqrt(Vo² + Vt² - 2·Vo·Vt·cos(Ct - Co))
        ///
        /// 3. 目标船相对本船的相对速度分量：
        ///    Vr_E = Vt·sin(Ct) - Vo·sin(Co)
        ///    Vr_N = Vt·cos(Ct) - Vo·cos(Co)
        ///    相对航向 Cr ∈ [0°, 360°) 由四象限反正切给出（消除论文反余弦公式在 0°~180° 之外的象限歧义）：
        ///    Cr = atan2(Vr_E, Vr_N) mod 360°
        ///
        /// 4. 从目标船指向本船的反方位（视线方向）为 (Q + 180°)，因此目标船相对运动方向 Cr 与视线方向 (Q + 180°) 的夹角为：
        ///    θ = Cr - Q - 180°
        ///    在以初始距离 D 为斜边的直角三角形中：
        ///    - 本船到相对运动线的垂距即最近会遇距离 DCPA：
        ///      DCPA = D · |sin(Cr - Q - 180°)|  （单位：海里 nm）
        ///    - 沿相对运动线到达最近会遇点的有向行程为 D · cos(Cr - Q - 180°)，除以相对速度 Vr 得最近会遇时间 TCPA：
        ///      TCPA_hours = D · cos(Cr - Q - 180°) / Vr  （单位：小时 h）
        ///      TCPA_min   = 60 · D · cos(Cr - Q - 180°) / Vr  （单位：分钟 min）
        ///
        /// 5. 与向量法等价性证明：
        ///    r0 · v = (D·sin Q)(Vr·sin Cr) + (D·cos Q)(Vr·cos Cr) = D·Vr·cos(Cr - Q) = -D·Vr·cos(Cr - Q - 180°)
        ///    故 TCPA = -(r0 · v) / |v|² = D·cos(Cr - Q - 180°) / Vr；
        ///    |r0 × v| / |v| = D·|sin(Cr - Q)| = D·|sin(Cr - Q - 180°)| = DCPA。两者恒等。
        /// </summary>
        public static CpaResult CalculateByTriangle(
            double voKn,
            double coDeg,
            double vtKn,
            double ctDeg,
            double azimuthQDeg,
            double distanceNm,
            CpaPairKey pair = default,
            SimTime time = default,
            RiskLevel riskLevel = RiskLevel.Safe,
            double degenerateSpeedEpsilonKn = DefaultDegenerateSpeedKn)
        {
            double dNm = Math.Max(0.0, distanceNm);
            double qDeg = NormalizeAngleDeg(azimuthQDeg);
            double coRad = coDeg * (Math.PI / 180.0);
            double ctRad = ctDeg * (Math.PI / 180.0);
            double qRad = qDeg * (Math.PI / 180.0);

            // 余弦定理求相对速度大小 Vr（节）
            double deltaCourseRad = ctRad - coRad;
            double vrSquared = voKn * voKn + vtKn * vtKn - 2.0 * voKn * vtKn * Math.Cos(deltaCourseRad);
            if (vrSquared < 0.0)
            {
                vrSquared = 0.0;
            }
            double vrKn = Math.Sqrt(vrSquared);

            double epsKn = degenerateSpeedEpsilonKn > 0.0 ? degenerateSpeedEpsilonKn : DefaultDegenerateSpeedKn;
            bool isDegenerate = vrKn < epsKn;

            double currentDistanceM = dNm * MetersPerNauticalMile;
            double relSpeedMps = vrKn * MetersPerSecondPerKnot;
            EnuPosition ownPos = EnuPosition.Zero;
            EnuPosition targetPos = new EnuPosition(
                currentDistanceM * Math.Sin(qRad),
                currentDistanceM * Math.Cos(qRad),
                0.0);

            double crDeg;
            double dcpaNm;
            double tcpaMin;
            EnuPosition ownCpaEnu;
            EnuPosition targetCpaEnu;
            bool isDiverging;

            if (isDegenerate)
            {
                crDeg = 0.0;
                dcpaNm = dNm;
                tcpaMin = double.PositiveInfinity;
                ownCpaEnu = ownPos;
                targetCpaEnu = targetPos;
                isDiverging = false;
            }
            else
            {
                double vrEastKn = vtKn * Math.Sin(ctRad) - voKn * Math.Sin(coRad);
                double vrNorthKn = vtKn * Math.Cos(ctRad) - voKn * Math.Cos(coRad);
                crDeg = NormalizeAngleDeg(Math.Atan2(vrEastKn, vrNorthKn) * (180.0 / Math.PI));

                // θ = Cr - Q - 180°
                double thetaRad = (crDeg - qDeg - 180.0) * (Math.PI / 180.0);
                dcpaNm = dNm * Math.Abs(Math.Sin(thetaRad));
                double tcpaHours = (dNm * Math.Cos(thetaRad)) / vrKn;
                tcpaMin = tcpaHours * 60.0;

                double tcpaSecVal = tcpaMin * SecondsPerMinute;
                double voMps = voKn * MetersPerSecondPerKnot;
                double vtMps = vtKn * MetersPerSecondPerKnot;
                ownCpaEnu = new EnuPosition(
                    voMps * Math.Sin(coRad) * tcpaSecVal,
                    voMps * Math.Cos(coRad) * tcpaSecVal,
                    0.0);
                targetCpaEnu = new EnuPosition(
                    targetPos.EastM + vtMps * Math.Sin(ctRad) * tcpaSecVal,
                    targetPos.NorthM + vtMps * Math.Cos(ctRad) * tcpaSecVal,
                    0.0);
                isDiverging = tcpaMin < 0.0;
            }

            double dcpaM = dcpaNm * MetersPerNauticalMile;
            double tcpaSec = double.IsPositiveInfinity(tcpaMin)
                ? double.PositiveInfinity
                : tcpaMin * SecondsPerMinute;

            return new CpaResult(
                pair,
                time,
                currentDistanceM,
                currentDistanceM,
                qDeg,
                crDeg,
                relSpeedMps,
                dcpaM,
                tcpaSec,
                ownCpaEnu,
                targetCpaEnu,
                isDiverging,
                isDegenerate,
                riskLevel);
        }

        /// <summary>
        /// 根据瞬时 DCPA（海里）与 TCPA（分钟）评估未加滞回的瞬时三级风险等级。
        /// 默认规则：Danger: DCPA &lt; 0.3nm 且 0 &lt; TCPA &lt; 6min；Warning: DCPA &lt; 1.0nm 且 0 &lt; TCPA &lt; 12min；其余 Safe。
        /// </summary>
        public static RiskLevel EvaluateInstantRisk(
            double dcpaNm,
            double tcpaMin,
            bool isDegenerate,
            RiskThresholds thresholds)
        {
            if (isDegenerate || double.IsNaN(dcpaNm) || double.IsNaN(tcpaMin) || tcpaMin <= 0.0)
            {
                return RiskLevel.Safe;
            }

            if (dcpaNm < thresholds.DangerDcpaNm && tcpaMin < thresholds.DangerTcpaMin)
            {
                return RiskLevel.Danger;
            }

            if (dcpaNm < thresholds.WarningDcpaNm && tcpaMin < thresholds.WarningTcpaMin)
            {
                return RiskLevel.Warning;
            }

            return RiskLevel.Safe;
        }

        internal static double NormalizeAngleDeg(double deg)
        {
            double m = deg % 360.0;
            return m < 0.0 ? m + 360.0 : m;
        }
    }
}
