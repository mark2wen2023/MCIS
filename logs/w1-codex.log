@@ -0,0 +1,329 @@
+using System;
+using System.Collections.Generic;
+using Mcis.Core;
+using Mcis.Domain.Common;
+using Mcis.Domain.Cpa;
+using Mcis.Domain.Models;
+
+namespace Mcis.Domain.Colreg
+{
+    /// <summary>
+    /// 两艘机动船的确定性技术核查入口。仅在共同观测区间内插值；
+    /// 时间带为左闭右开，末带包含观测终点，终点发生转换时保留零长度末带。
+    /// </summary>
+    public sealed class ColregEngine
+    {
+        /// <summary>分析合成或已规范化航迹；输入不合法时返回失败结果。</summary>
+        public Result<ColregAnalysisReport> Analyze(ColregAnalysisRequest request)
+        {
+            string error = Validate(request);
+            if (error != null)
+                return Result<ColregAnalysisReport>.Fail("COLREG_INVALID_INPUT", error);
+
+            double start = Math.Max(request.OwnSamples[0].Time.Seconds, request.TargetSamples[0].Time.Seconds);
+            double end = Math.Min(request.OwnSamples[request.OwnSamples.Count - 1].Time.Seconds,
+                request.TargetSamples[request.TargetSamples.Count - 1].Time.Seconds);
+            if (start > end)
+                return Result<ColregAnalysisReport>.Fail("COLREG_NO_OVERLAP", "两船航迹没有共同观测时间。");
+            double count = (end - start) / request.Thresholds.SampleIntervalSeconds;
+            if (!Finite(count) || count > 1000000)
+                return Result<ColregAnalysisReport>.Fail("COLREG_TOO_MANY_SAMPLES", "采样网格超过一百万点，请增大采样间隔或缩短观测区间。");
+
+            var times = new SortedSet<double> { start, end };
+            for (int i = 1; i <= (int)count; i++)
+            {
+                double time = start + i * request.Thresholds.SampleIntervalSeconds;
+                if (time < end) times.Add(time);
+            }
+            AddTimes(times, request.OwnSamples, start, end);
+            AddTimes(times, request.TargetSamples, start, end);
+            foreach (var state in request.Environment)
+                if (state.Time.Seconds >= start && state.Time.Seconds <= end) times.Add(state.Time.Seconds);
+
+            var frames = new List<ColregFrame>();
+            var pair = new CpaPairKey(request.OwnVesselId, request.TargetVesselId);
+            int overtaker = 0;
+            foreach (double time in times)
+            {
+                var own = SampleAt(request.OwnSamples, time);
+                var target = SampleAt(request.TargetSamples, time);
+                var cpa = CpaCalculator.CalculateFromSamples(own, target, pair);
+                var frame = new ColregFrame(own, target, cpa, VisibilityAt(request, time));
+                bool danger = !cpa.IsDegenerate && cpa.TcpaSec > 0 &&
+                    (cpa.DcpaNm < request.Thresholds.CollisionRiskDcpaNm || request.Thresholds.IncludeClosingRisk);
+                frame.HasCollisionRisk = danger;
+                if (overtaker != 0 && IsPastAndClear(frame, request.Thresholds)) overtaker = 0;
+                if (overtaker == 0 && danger) overtaker = FindOvertaker(frame, request.Thresholds);
+                frame.Overtaker = overtaker;
+                Classify(frame, request);
+                frames.Add(frame);
+            }
+
+            var spans = new List<ColregSpan>();
+            int first = 0;
+            for (int i = 1; i <= frames.Count; i++)
+            {
+                if (i < frames.Count && frames[first].SameClassification(frames[i])) continue;
+                int last = i < frames.Count ? i : frames.Count - 1;
+                spans.Add(new ColregSpan(first, last, new ColregTimeBand(frames[first].Own.Time,
+                    frames[last].Own.Time, frames[first].Situation, frames[first].OwnRole,
+                    frames[first].TargetRole, ApplicableRules(frames[first], request.InNarrowChannel))));
+                first = i;
+            }
+            var bands = new List<ColregTimeBand>();
+            var checks = new List<ColregRuleCheck>();
+            foreach (var span in spans)
+            {
+                bands.Add(span.Band);
+                ColregEvaluator.Evaluate(request, frames, span, checks);
+            }
+            var assumptions = new List<string>
+            {
+                "按两艘机动船分析；未输入船型特权、声号、航道几何、操纵性能和停船距离。",
+                "仅在共同观测区间内对ENU位置、速度作线性插值，航向沿最短圆弧插值；保留原始及环境变化时刻。",
+                "追越扇区包含边界；边界存疑按追越处理。驶过让清的技术代理为已过CPA、正在远离且达到配置让清距离。",
+                "安全航速、及早行动及R17干预/紧迫门限均为可配置技术代理，不能证明单凭一船已无法避碰。",
+                "交叉角色按本船相对方位划分，不以船名决定；双方同见对方位于同侧的几何疑义在R15列为部分核查。",
+                "规则逐带核查，实际操纵观察到该带终点；转换点共享观测值，不跨转换点归属操纵。"
+            };
+            if (!request.VesselsInSight.HasValue)
+                assumptions.Add("未给互见标志时，能见度达到阈值即按互见分析。未给能见度时视为无限能见度。");
+            if (request.VisibilityNm == null && (request.Environment.Count == 0 || request.Environment[0].Time.Seconds > start))
+                assumptions.Add("首个环境状态生效前缺少能见度，采用无限能见度；环境状态按最近过去值保持。");
+            return Result<ColregAnalysisReport>.Ok(new ColregAnalysisReport(pair, bands, checks,
+                request.Thresholds, request.CaseEpochUtc, assumptions));
+        }
+
+        private static void Classify(ColregFrame f, ColregAnalysisRequest request)
+        {
+            var t = request.Thresholds;
+            if (request.VesselsInSight == false || f.VisibilityNm < t.RestrictedVisibilityNm)
+            {
+                f.Situation = EncounterSituation.RestrictedVisibility;
+                f.OwnRole = f.TargetRole = TrafficRole.BothActionRequired;
+            }
+            else if (f.Overtaker != 0)
+            {
+                f.Situation = EncounterSituation.Overtaking;
+                f.OwnRole = f.Overtaker == 1 ? TrafficRole.GiveWay : TrafficRole.StandOn;
+                f.TargetRole = f.Overtaker == 2 ? TrafficRole.GiveWay : TrafficRole.StandOn;
+            }
+            else if (!f.HasCollisionRisk)
+            {
+                f.Situation = EncounterSituation.NoCollisionRisk;
+                f.OwnRole = f.TargetRole = TrafficRole.None;
+            }
+            else if (180 - f.HeadingDifferenceDeg <= t.HeadOnHalfAngleDeg + 1e-7 &&
+                Math.Abs(Delta(0, f.OwnBearingDeg)) <= t.HeadOnForwardHalfAngleDeg + 1e-7 &&
+                Math.Abs(Delta(0, f.TargetBearingDeg)) <= t.HeadOnForwardHalfAngleDeg + 1e-7)
+            {
+                f.Situation = EncounterSituation.HeadOn;
+                f.OwnRole = f.TargetRole = TrafficRole.BothActionRequired;
+            }
+            else
+            {
+                f.Situation = EncounterSituation.Crossing;
+                bool ownRight = f.OwnBearingDeg > 0 && f.OwnBearingDeg < 180;
+                bool targetRight = f.TargetBearingDeg > 0 && f.TargetBearingDeg < 180;
+                f.CrossingGeometryAmbiguous = ownRight == targetRight || f.OwnBearingDeg == 0 || f.OwnBearingDeg == 180;
+                f.OwnRole = ownRight ? TrafficRole.GiveWay : TrafficRole.StandOn;
+                f.TargetRole = ownRight ? TrafficRole.StandOn : TrafficRole.GiveWay;
+            }
+        }
+
+        private static int FindOvertaker(ColregFrame f, ColregThresholds t)
+        {
+            double boundary = 90 + t.OvertakingAbaftBeamAngleDeg;
+            // 本方法仅在CPA确认正在接近且存在危险时调用；不额外要求航向平行，
+            // 从后扇区接近的斜向追越同样按R13优先处理。
+            bool targetBehind = InSector(f.OwnBearingDeg, boundary);
+            bool ownBehind = InSector(f.TargetBearingDeg, boundary);
+            if (targetBehind && ownBehind)
+                return Math.Abs(180 - f.OwnBearingDeg) <= Math.Abs(180 - f.TargetBearingDeg) ? 2 : 1;
+            return targetBehind ? 2 : ownBehind ? 1 : 0;
+        }
+
+        private static bool InSector(double bearing, double boundary)
+        {
+            return bearing >= boundary - 1e-7 && bearing <= 360 - boundary + 1e-7;
+        }
+
+        private static bool IsPastAndClear(ColregFrame f, ColregThresholds t)
+        {
+            return f.Cpa.CurrentDistanceNm >= t.ClearDistanceNm && f.Cpa.IsDiverging;
+        }
+
+        private static IReadOnlyList<ColregRuleId> ApplicableRules(ColregFrame f, bool narrow)
+        {
+            var rules = new List<ColregRuleId>();
+            if (f.Situation != EncounterSituation.NoCollisionRisk)
+            {
+                rules.Add(ColregRuleId.R8);
+                if (f.Situation == EncounterSituation.RestrictedVisibility) rules.Add(ColregRuleId.R19);
+                else if (f.Situation == EncounterSituation.HeadOn) rules.Add(ColregRuleId.R14);
+                else
+                {
+                    rules.Add(f.Situation == EncounterSituation.Overtaking ? ColregRuleId.R13 : ColregRuleId.R15);
+                    rules.Add(ColregRuleId.R16);
+                    rules.Add(ColregRuleId.R17);
+                }
+            }
+            if (narrow) rules.Add(ColregRuleId.R9);
+            return rules;
+        }
+
+        private static void AddTimes(SortedSet<double> times, IReadOnlyList<TrackSample> samples, double start, double end)
+        {
+            foreach (var sample in samples)
+                if (sample.Time.Seconds >= start && sample.Time.Seconds <= end) times.Add(sample.Time.Seconds);
+        }
+
+        internal static TrackSample SampleAt(IReadOnlyList<TrackSample> samples, double time)
+        {
+            int lo = 0, hi = samples.Count - 1;
+            while (lo < hi)
+            {
+                int middle = lo + (hi - lo) / 2;
+                if (samples[middle].Time.Seconds < time) lo = middle + 1;
+                else hi = middle;
+            }
+            if (samples[lo].Time.Seconds == time || lo == 0) return samples[lo];
+            var a = samples[lo - 1];
+            var b = samples[lo];
+            double fraction = (time - a.Time.Seconds) / (b.Time - a.Time);
+            return new TrackSample(new SimTime(time), a.Geo,
+                new EnuPosition(Lerp(a.EnuCenter.EastM, b.EnuCenter.EastM, fraction),
+                    Lerp(a.EnuCenter.NorthM, b.EnuCenter.NorthM, fraction)),
+                new Double2(Lerp(a.VelocityEnuMps.X, b.VelocityEnuMps.X, fraction),
+                    Lerp(a.VelocityEnuMps.Y, b.VelocityEnuMps.Y, fraction)),
+                (float)Lerp(a.SogMps, b.SogMps, fraction),
+                (float)Normalize(Course(a) + Delta(Course(a), Course(b)) * fraction),
+                (float)Normalize(Heading(a) + Delta(Heading(a), Heading(b)) * fraction),
+                0, SampleProvenance.Interpolated, a.TimeQuality, false);
+        }
+
+        private static double VisibilityAt(ColregAnalysisRequest request, double time)
+        {
+            double visibility = request.VisibilityNm ?? double.PositiveInfinity;
+            int lo = 0, hi = request.Environment.Count;
+            while (lo < hi)
+            {
+                int mid = lo + (hi - lo) / 2;
+                if (request.Environment[mid].Time.Seconds <= time) lo = mid + 1;
+                else hi = mid;
+            }
+            if (lo > 0) visibility = request.Environment[lo - 1].VisibilityNm;
+            return visibility;
+        }
+
+        internal static double Heading(TrackSample sample)
+        {
+            return !sample.HeadingFromCog && Finite(sample.HdgDeg) && sample.HdgDeg >= 0 && sample.HdgDeg <= 360
+                ? Normalize(sample.HdgDeg) : sample.CogDeg;
+        }
+
+        private static double Course(TrackSample sample)
+        {
+            return Finite(sample.CogDeg) && sample.CogDeg >= 0 && sample.CogDeg <= 360 ? Normalize(sample.CogDeg) :
+                Normalize(Math.Atan2(sample.VelocityEnuMps.X, sample.VelocityEnuMps.Y) * 180 / Math.PI);
+        }
+
+        internal static double Normalize(double angle) { return (angle % 360 + 360) % 360; }
+        internal static double Delta(double from, double to) { return Normalize(to - from + 180) - 180; }
+        internal static bool Finite(double value) { return !double.IsNaN(value) && !double.IsInfinity(value); }
+        private static double Lerp(double a, double b, double f) { return a + (b - a) * f; }
+
+        private static string Validate(ColregAnalysisRequest r)
+        {
+            if (r == null) return "请求不能为空。";
+            if (string.IsNullOrWhiteSpace(r.OwnVesselId) || string.IsNullOrWhiteSpace(r.TargetVesselId) ||
+                r.OwnVesselId == r.TargetVesselId) return "需要两个不同且非空的船舶标识。";
+            var t = r.Thresholds;
+            var positive = new[] { t.RestrictedVisibilityNm, t.CollisionRiskDcpaNm, t.SafePassingDcpaNm,
+                t.SubstantialTurnDeg, t.SubstantialSpeedChangeMps, t.SampleIntervalSeconds,
+                t.EarlyActionTcpaSeconds, t.EarlyActionDistanceNm, t.SafeSpeedMps, t.ClearDistanceNm,
+                t.StandOnEmergencyTcpaSeconds, t.StandOnInterventionTcpaSeconds };
+            foreach (double value in positive) if (!Finite(value) || value <= 0) return "阈值必须为有限正数。";
+            var nonnegative = new[] { t.HeadOnHalfAngleDeg, t.OvertakingAbaftBeamAngleDeg,
+                t.MaintainHeadingToleranceDeg, t.MaintainSpeedToleranceMps, t.HeadOnForwardHalfAngleDeg };
+            foreach (double value in nonnegative) if (!Finite(value) || value < 0) return "角度/保持容差必须为有限非负数。";
+            if (t.HeadOnHalfAngleDeg >= 90 || t.HeadOnForwardHalfAngleDeg >= 90 ||
+                t.OvertakingAbaftBeamAngleDeg >= 90 || t.SubstantialTurnDeg > 180 ||
+                t.MaintainHeadingToleranceDeg >= t.SubstantialTurnDeg ||
+                t.MaintainSpeedToleranceMps >= t.SubstantialSpeedChangeMps ||
+                t.StandOnEmergencyTcpaSeconds > t.StandOnInterventionTcpaSeconds)
+                return "角度、明显行动/保持容差或R17阶段阈值的关系不合法。";
+            string error = ValidateSamples(r.OwnSamples) ?? ValidateSamples(r.TargetSamples);
+            if (error != null) return error;
+            if (r.VisibilityNm.HasValue && (double.IsNaN(r.VisibilityNm.Value) || r.VisibilityNm.Value < 0))
+                return "能见度必须为非负数。";
+            double previous = double.NegativeInfinity;
+            foreach (var state in r.Environment)
+            {
+                if (!Finite(state.Time.Seconds) || state.Time.Seconds <= previous ||
+                    !Finite(state.VisibilityNm) || state.VisibilityNm < 0)
+                    return "环境状态时间必须严格递增且能见度为有限非负数。";
+                previous = state.Time.Seconds;
+            }
+            return null;
+        }
+
+        private static string ValidateSamples(IReadOnlyList<TrackSample> samples)
+        {
+            if (samples == null || samples.Count == 0) return "航迹不能为空。";
+            double previous = double.NegativeInfinity;
+            foreach (var s in samples)
+            {
+                if (!Finite(s.Time.Seconds) || s.Time.Seconds <= previous || !Finite(s.EnuCenter.EastM) ||
+                    !Finite(s.EnuCenter.NorthM) || !Finite(s.VelocityEnuMps.X) || !Finite(s.VelocityEnuMps.Y) ||
+                    !Finite(s.SogMps) || s.SogMps < 0 || !Finite(Heading(s)) || Heading(s) < 0 || Heading(s) > 360)
+                    return "航迹时间必须严格递增，ENU、速度与有效船首向（或替代COG）必须有效。";
+                previous = s.Time.Seconds;
+            }
+            return null;
+        }
+    }
+
+    /// <summary>内部单时刻状态；CPA由既有解算器提供。</summary>
+    internal sealed class ColregFrame
+    {
+        internal TrackSample Own { get; }
+        internal TrackSample Target { get; }
+        internal CpaResult Cpa { get; }
+        internal double VisibilityNm { get; }
+        internal double OwnBearingDeg { get; }
+        internal double TargetBearingDeg { get; }
+        internal double HeadingDifferenceDeg { get; }
+        internal bool HasCollisionRisk { get; set; }
+        internal bool CrossingGeometryAmbiguous { get; set; }
+        internal int Overtaker { get; set; }
+        internal EncounterSituation Situation { get; set; }
+        internal TrafficRole OwnRole { get; set; }
+        internal TrafficRole TargetRole { get; set; }
+
+        internal ColregFrame(TrackSample own, TrackSample target, CpaResult cpa, double visibilityNm)
+        {
+            Own = own; Target = target; Cpa = cpa; VisibilityNm = visibilityNm;
+            OwnBearingDeg = ColregEngine.Normalize(cpa.TrueBearingDeg - ColregEngine.Heading(own));
+            TargetBearingDeg = ColregEngine.Normalize(cpa.TrueBearingDeg + 180 - ColregEngine.Heading(target));
+            HeadingDifferenceDeg = Math.Abs(ColregEngine.Delta(ColregEngine.Heading(own), ColregEngine.Heading(target)));
+        }
+
+        internal bool SameClassification(ColregFrame other)
+        {
+            return Situation == other.Situation && OwnRole == other.OwnRole && TargetRole == other.TargetRole;
+        }
+    }
+
+    /// <summary>内部时间带与对应观测端点索引。</summary>
+    internal sealed class ColregSpan
+    {
+        internal int First { get; }
+        internal int Last { get; }
+        internal ColregTimeBand Band { get; }
+        internal ColregSpan(int first, int last, ColregTimeBand band)
+        {
+            First = first; Last = last; Band = band;
+        }
+    }
+}
diff --git a/unity/Assets/_Project/Scripts/Domain/Colreg/ColregEvaluator.cs b/unity/Assets/_Project/Scripts/Domain/Colreg/ColregEvaluator.cs
new file mode 100644
index 0000000000000000000000000000000000000000..0d1d85f6d9ee3e5ee53f74124507566f0aa56544
--- /dev/null
+++ b/unity/Assets/_Project/Scripts/Domain/Colreg/ColregEvaluator.cs
@@ -0,0 +1,448 @@
+using System;
+using System.Collections.Generic;
+using Mcis.Core;
+using Mcis.Domain.Cpa;
+using Mcis.Domain.Models;
+
+namespace Mcis.Domain.Colreg
+{
+    /// <summary>逐时间带对照应采取行动与观测操纵；所有CPA均复用既有解算器。</summary>
+    internal static class ColregEvaluator
+    {
+        internal static void Evaluate(ColregAnalysisRequest request, List<ColregFrame> frames,
+            ColregSpan span, List<ColregRuleCheck> checks)
+        {
+            var own = Observe(frames, span, true, request.Thresholds);
+            var target = Observe(frames, span, false, request.Thresholds);
+            EvaluateVessel(request, frames, span, true, own, checks);
+            EvaluateVessel(request, frames, span, false, target, checks);
+        }
+
+        private static void EvaluateVessel(ColregAnalysisRequest r, List<ColregFrame> frames,
+            ColregSpan span, bool own, ObservedManeuver action,
+            List<ColregRuleCheck> checks)
+        {
+            var first = frames[span.First];
+            var last = frames[span.Last];
+            var t = r.Thresholds;
+            var role = own ? first.OwnRole : first.TargetRole;
+            double bearing = own ? first.OwnBearingDeg : first.TargetBearingDeg;
+            string vessel = own ? r.OwnVesselId : r.TargetVesselId;
+            bool observed = action.ObservedDurationSeconds > 0;
+            bool substantial = Substantial(action, t);
+            bool early = Early(r, action, first);
+            double minimumDistance = MinimumObservedDistance(frames, span);
+            bool safe = SafePassing(last.Cpa, t) && minimumDistance >= t.SafePassingDcpaNm * VesselMotionState.MetersPerNm;
+            bool holding = Holding(frames, span, own, t);
+            bool allowed = !(first.Situation == EncounterSituation.HeadOn && action.MaxPortTurnDeg > t.MaintainHeadingToleranceDeg);
+            bool adequate = early && substantial && safe && allowed;
+            double earlyTcpa, earlyDistance;
+            ActionEvidence(r, action, first, out earlyTcpa, out earlyDistance);
+            var evidence = new ColregEvidence(bearing, first.HeadingDifferenceDeg, first.Cpa.DcpaM,
+                first.Cpa.TcpaSec, action.HeadingChangeDeg, action.SpeedChangeMps,
+                first.VisibilityNm, first.Cpa.CurrentDistanceM, last.Cpa.DcpaM,
+                minimumDistance, last.Cpa.TcpaSec, last.Cpa.CurrentDistanceM, earlyTcpa, earlyDistance);
+            string numbers = string.Format(System.Globalization.CultureInfo.InvariantCulture,
+                "及早={0}；明显行动={1}；安全驶过代理={2}；终点DCPA={3:F3}m，TCPA={4:F3}s，间距={5:F3}m；观测最小中心间距={6:F3}m。",
+                early, substantial, safe, last.Cpa.DcpaM, last.Cpa.TcpaSec, last.Cpa.CurrentDistanceM, minimumDistance);
+
+            Action<ColregRuleId, RuleCheckStatus, string, string, string> add = (id, status, clause, expected, explanation) =>
+                checks.Add(new ColregRuleCheck(span.Band.StartTime, span.Band.EndTime, id, vessel,
+                    status, clause, expected, action, evidence, explanation));
+            Action<ColregRuleId> na = id => add(id, RuleCheckStatus.NotApplicable, id.ToString(),
+                ColregRules.Get(id).Summary, "本时间带的会遇局面或船舶角色不适用该项。");
+
+            AddAvoidanceChecks(r, frames, span, own, checks);
+
+            add(ColregRuleId.R9, RuleCheckStatus.NotApplicable, "R9(a)", "在狭水道尽量靠本船右舷一侧的航道外缘行驶。",
+                r.InNarrowChannel ? "已标记狭水道；缺少航道几何，无法核查靠右外缘的几何项。" : "请求未标记狭水道。");
+
+            if (first.Situation == EncounterSituation.Overtaking)
+                add(ColregRuleId.R13, !observed ? RuleCheckStatus.Partial :
+                    (role == TrafficRole.GiveWay ? safe : holding || safe) ? RuleCheckStatus.Satisfied : RuleCheckStatus.NotSatisfied,
+                    "R13", role == TrafficRole.GiveWay ? "追越船应让清，驶过让清前持续履行让路义务。" : "被追越船按直航船规则核查保向保速。",
+                    "闭边界追越判据；追越身份持续至驶过、达到让清距离且正在远离。" + numbers + ObservationNote(observed));
+            else na(ColregRuleId.R13);
+
+            if (first.Situation == EncounterSituation.HeadOn)
+                add(ColregRuleId.R14, !observed ? RuleCheckStatus.Partial :
+                    action.MaxPortTurnDeg > t.MaintainHeadingToleranceDeg || action.MaxStarboardTurnDeg <= t.MaintainHeadingToleranceDeg
+                        ? RuleCheckStatus.NotSatisfied : RuleCheckStatus.Satisfied,
+                    "R14", "双方均应向右转向，以便从他船左舷驶过。",
+                    "按船首向差和双方前方扇区识别；任何超出噪声容差的左转均不满足。" + ObservationNote(observed));
+            else na(ColregRuleId.R14);
+
+            if (first.Situation == EncounterSituation.Crossing)
+            {
+                bool astern = PassesAstern(last, own);
+                add(ColregRuleId.R15, role == TrafficRole.StandOn ? RuleCheckStatus.NotApplicable :
+                    !observed || first.CrossingGeometryAmbiguous ? RuleCheckStatus.Partial :
+                    safe && substantial && astern ? RuleCheckStatus.Satisfied : RuleCheckStatus.NotSatisfied,
+                    "R15", role == TrafficRole.GiveWay ? "他船在本船右舷，应给他船让路并避免横越其前方。" : "他船在本船左舷，按R17核查直航行动。",
+                    "采用终点CPA预测相对位置沿直航船船首方向的投影核查前后关系；双方同侧或轴线几何疑义=" + first.CrossingGeometryAmbiguous + "。" +
+                    "预测从后方驶过=" + astern + "；" + numbers + ObservationNote(observed));
+            }
+            else na(ColregRuleId.R15);
+
+            if (role == TrafficRole.GiveWay)
+                add(ColregRuleId.R16, !observed ? RuleCheckStatus.Partial :
+                    adequate ? RuleCheckStatus.Satisfied : RuleCheckStatus.NotSatisfied,
+                    "R16", "让路船应及早采取大幅度行动，以便明确让清他船。", numbers + ObservationNote(observed));
+            else na(ColregRuleId.R16);
+
+            if (role == TrafficRole.StandOn) AddStandOnChecks(r, frames, span, own, checks);
+            else na(ColregRuleId.R17);
+
+            if (first.Situation == EncounterSituation.RestrictedVisibility)
+            {
+                double maxSpeed = MaximumSpeed(frames, span, own);
+                add(ColregRuleId.R19, maxSpeed <= t.SafeSpeedMps ? RuleCheckStatus.Satisfied : RuleCheckStatus.NotSatisfied,
+                    "R19(b)", "以适合能见度不良环境的安全航速行驶。",
+                    string.Format(System.Globalization.CultureInfo.InvariantCulture,
+                        "观察最大航速={0:F3}m/s；安全航速技术阈值={1:F3}m/s；未输入操纵性能与交通密度。", maxSpeed, t.SafeSpeedMps));
+                bool foreApplicable, aftApplicable;
+                bool foreViolation, aftViolation;
+                RestrictedTurns(frames, span, own, action, t, out foreApplicable, out aftApplicable,
+                    out foreViolation, out aftViolation);
+                add(ColregRuleId.R19, !foreApplicable ? RuleCheckStatus.NotApplicable : !observed ? RuleCheckStatus.Partial :
+                    foreViolation ? RuleCheckStatus.NotSatisfied : RuleCheckStatus.Satisfied,
+                    "R19(d)(i)", "对正横以前他船避免向左转向，正在被本船追越的目标除外。",
+                    "以各观测段起点相对方位核查；追越例外依据保留的追越身份。" + ObservationNote(observed));
+                add(ColregRuleId.R19, !aftApplicable ? RuleCheckStatus.NotApplicable : !observed ? RuleCheckStatus.Partial :
+                    aftViolation ? RuleCheckStatus.NotSatisfied : RuleCheckStatus.Satisfied,
+                    "R19(d)(ii)", "对正横或正横以后他船避免朝其转向。",
+                    "右舷正横至船尾禁右转，左舷船尾至正横禁左转；正后方任一明显转向保守列为不满足。" + ObservationNote(observed));
+            }
+            else na(ColregRuleId.R19);
+        }
+
+        private static ObservedManeuver Observe(List<ColregFrame> frames, ColregSpan span, bool own, ColregThresholds t)
+        {
+            var first = own ? frames[span.First].Own : frames[span.First].Target;
+            var previous = first;
+            double cumulative = 0, minimum = 0, maximum = 0, port = 0, starboard = 0;
+            double speedUp = 0, speedDown = 0;
+            SimTime? actionTime = null;
+            for (int i = span.First + 1; i <= span.Last; i++)
+            {
+                var current = own ? frames[i].Own : frames[i].Target;
+                double before = cumulative;
+                double priorMinimum = minimum, priorMaximum = maximum;
+                cumulative += ColregEngine.Delta(ColregEngine.Heading(previous), ColregEngine.Heading(current));
+                starboard = Math.Max(starboard, cumulative - minimum);
+                port = Math.Max(port, maximum - cumulative);
+                maximum = Math.Max(maximum, cumulative);
+                minimum = Math.Min(minimum, cumulative);
+                speedUp = Math.Max(speedUp, current.SogMps - first.SogMps);
+                speedDown = Math.Max(speedDown, first.SogMps - current.SogMps);
+                if (!actionTime.HasValue)
+                {
+                    double fraction = 2;
+                    // 与最大单向转幅使用相同的运行极值基准，回转不因净变化较小而丢失时刻。
+                    fraction = Math.Min(fraction, CrossingFraction(before - priorMinimum, cumulative - priorMinimum, t.SubstantialTurnDeg));
+                    fraction = Math.Min(fraction, CrossingFraction(priorMaximum - before, priorMaximum - cumulative, t.SubstantialTurnDeg));
+                    fraction = Math.Min(fraction, CrossingFraction(previous.SogMps - first.SogMps,
+                        current.SogMps - first.SogMps, t.SubstantialSpeedChangeMps));
+                    fraction = Math.Min(fraction, CrossingFraction(first.SogMps - previous.SogMps,
+                        first.SogMps - current.SogMps, t.SubstantialSpeedChangeMps));
+                    if (fraction <= 1)
+                        actionTime = new SimTime(previous.Time.Seconds + fraction * (current.Time - previous.Time));
+                }
+                previous = current;
+            }
+            TurnDirection turn = Math.Abs(cumulative) > t.MaintainHeadingToleranceDeg
+                ? cumulative > 0 ? TurnDirection.Starboard : TurnDirection.Port
+                : Math.Max(starboard, port) <= t.MaintainHeadingToleranceDeg ? TurnDirection.None
+                : starboard >= port ? TurnDirection.Starboard : TurnDirection.Port;
+            double speedChange = previous.SogMps - first.SogMps;
+            SpeedChange speed = Math.Abs(speedChange) > t.MaintainSpeedToleranceMps
+                ? speedChange > 0 ? SpeedChange.Accelerating : SpeedChange.Decelerating
+                : Math.Max(speedUp, speedDown) <= t.MaintainSpeedToleranceMps ? SpeedChange.Steady
+                : speedUp >= speedDown ? SpeedChange.Accelerating : SpeedChange.Decelerating;
+            return new ObservedManeuver(cumulative, speedChange, turn, speed, starboard, port,
+                speedUp, speedDown, actionTime, previous.Time - first.Time);
+        }
+
+        private static double CrossingFraction(double before, double after, double threshold)
+        {
+            if (before >= threshold) return 0;
+            return after >= threshold && after > before ? (threshold - before) / (after - before) : 2;
+        }
+
+        private static bool Substantial(ObservedManeuver a, ColregThresholds t)
+        {
+            return Math.Max(a.MaxStarboardTurnDeg, a.MaxPortTurnDeg) >= t.SubstantialTurnDeg - 1e-7 ||
+                Math.Max(a.MaxSpeedIncreaseMps, a.MaxSpeedDecreaseMps) >= t.SubstantialSpeedChangeMps;
+        }
+
+        private static bool Early(ColregAnalysisRequest r, ObservedManeuver a, ColregFrame first)
+        {
+            double tcpa, distance;
+            ActionEvidence(r, a, first, out tcpa, out distance);
+            return tcpa >= r.Thresholds.EarlyActionTcpaSeconds || distance / VesselMotionState.MetersPerNm >= r.Thresholds.EarlyActionDistanceNm;
+        }
+
+        private static void ActionEvidence(ColregAnalysisRequest r, ObservedManeuver a, ColregFrame first,
+            out double remainingTcpa, out double distanceM)
+        {
+            remainingTcpa = distanceM = double.NaN;
+            if (!a.FirstSubstantialActionTime.HasValue) return;
+            double time = a.FirstSubstantialActionTime.Value.Seconds;
+            var own = ColregEngine.SampleAt(r.OwnSamples, time);
+            var target = ColregEngine.SampleAt(r.TargetSamples, time);
+            var atAction = CpaCalculator.CalculateFromSamples(own, target);
+            remainingTcpa = first.Cpa.TcpaSec - (time - first.Own.Time.Seconds);
+            distanceM = atAction.CurrentDistanceM;
+        }
+
+        private static double MinimumObservedDistance(List<ColregFrame> frames, ColregSpan span)
+        {
+            double minimum = frames[span.First].Cpa.CurrentDistanceM;
+            for (int i = span.First; i < span.Last; i++)
+            {
+                var a = frames[i];
+                var b = frames[i + 1];
+                double seconds = b.Own.Time - a.Own.Time;
+                var ownVelocity = (b.Own.EnuCenter.Horizontal - a.Own.EnuCenter.Horizontal) * (1 / seconds);
+                var targetVelocity = (b.Target.EnuCenter.Horizontal - a.Target.EnuCenter.Horizontal) * (1 / seconds);
+                var cpa = CpaCalculator.CalculateFromStates(
+                    VesselMotionState.FromEnuMeters(a.Own.EnuCenter, ownVelocity),
+                    VesselMotionState.FromEnuMeters(a.Target.EnuCenter, targetVelocity));
+                // 按段内TCPA限制既有解算器结果，避免将观测区间外的CPA当成实际经过距离。
+                if (!cpa.IsDegenerate && cpa.TcpaSec >= 0 && cpa.TcpaSec <= seconds)
+                    minimum = Math.Min(minimum, cpa.DcpaM);
+                minimum = Math.Min(minimum, Math.Min(cpa.CurrentDistanceM, b.Cpa.CurrentDistanceM));
+            }
+            return minimum;
+        }
+
+        private static bool SafePassing(CpaResult cpa, ColregThresholds t)
+        {
+            if (cpa.IsDegenerate) return cpa.CurrentDistanceNm >= t.SafePassingDcpaNm;
+            return cpa.TcpaSec > 0 ? cpa.DcpaNm >= t.SafePassingDcpaNm :
+                cpa.IsDiverging && cpa.CurrentDistanceNm >= t.SafePassingDcpaNm;
+        }
+
+        private static bool Holding(List<ColregFrame> frames, ColregSpan span, bool own, ColregThresholds t)
+        {
+            var first = own ? frames[span.First].Own : frames[span.First].Target;
+            double accumulated = 0;
+            var previous = first;
+            for (int i = span.First; i <= span.Last; i++)
+            {
+                var sample = own ? frames[i].Own : frames[i].Target;
+                accumulated += ColregEngine.Delta(ColregEngine.Heading(previous), ColregEngine.Heading(sample));
+                if (Math.Abs(accumulated) > t.MaintainHeadingToleranceDeg ||
+                    Math.Abs(sample.SogMps - first.SogMps) > t.MaintainSpeedToleranceMps) return false;
+                previous = sample;
+            }
+            return true;
+        }
+
+        private static void AddAvoidanceChecks(ColregAnalysisRequest r, List<ColregFrame> frames,
+            ColregSpan span, bool own, List<ColregRuleCheck> checks)
+        {
+            int first = span.First;
+            bool active = frames[first].HasCollisionRisk || frames[first].Overtaker != 0;
+            for (int i = span.First + 1; i <= span.Last; i++)
+            {
+                bool next = frames[i].HasCollisionRisk || frames[i].Overtaker != 0;
+                if (next == active) continue;
+                AddAvoidancePhase(r, frames, new ColregSpan(first, i, span.Band), own, active, checks);
+                first = i;
+                active = next;
+            }
+            AddAvoidancePhase(r, frames, new ColregSpan(first, span.Last, span.Band), own, active, checks);
+        }
+
+        private static void AddAvoidancePhase(ColregAnalysisRequest r, List<ColregFrame> frames,
+            ColregSpan span, bool own, bool active, List<ColregRuleCheck> checks)
+        {
+            var t = r.Thresholds;
+            var first = frames[span.First];
+            var last = frames[span.Last];
+            var action = Observe(frames, span, own, t);
+            var role = own ? first.OwnRole : first.TargetRole;
+            bool holding = Holding(frames, span, own, t);
+            double minimumDistance = MinimumObservedDistance(frames, span);
+            bool safe = SafePassing(last.Cpa, t) && minimumDistance >= t.SafePassingDcpaNm * VesselMotionState.MetersPerNm;
+            bool allowed = first.Situation != EncounterSituation.HeadOn || action.MaxPortTurnDeg <= t.MaintainHeadingToleranceDeg;
+            bool early = Early(r, action, first);
+            bool substantial = Substantial(action, t);
+            RuleCheckStatus status = !active || (role == TrafficRole.StandOn && holding && !Emergency(frames, span, t))
+                ? RuleCheckStatus.NotApplicable : action.ObservedDurationSeconds <= 0 ? RuleCheckStatus.Partial :
+                early && substantial && safe && allowed ? RuleCheckStatus.Satisfied : RuleCheckStatus.NotSatisfied;
+            double earlyTcpa, earlyDistance;
+            ActionEvidence(r, action, first, out earlyTcpa, out earlyDistance);
+            var evidence = new ColregEvidence(own ? first.OwnBearingDeg : first.TargetBearingDeg,
+                first.HeadingDifferenceDeg, first.Cpa.DcpaM, first.Cpa.TcpaSec, action.HeadingChangeDeg,
+                action.SpeedChangeMps, first.VisibilityNm, first.Cpa.CurrentDistanceM, last.Cpa.DcpaM,
+                minimumDistance, last.Cpa.TcpaSec, last.Cpa.CurrentDistanceM, earlyTcpa, earlyDistance);
+            checks.Add(new ColregRuleCheck(first.Own.Time, last.Own.Time, ColregRuleId.R8,
+                own ? r.OwnVesselId : r.TargetVesselId, status, "R8",
+                "及早采取明显的避碰行动，并核查能否在安全距离驶过。", action, evidence,
+                status == RuleCheckStatus.NotApplicable ? "本阶段无碰撞危险，或直航船在正常保向保速阶段。" :
+                "及早=" + early + "；明显行动=" + substantial + "；安全驶过代理=" + safe +
+                "；按本阶段全部观测段的CPA核查最小实际中心间距。" + ObservationNote(action.ObservedDurationSeconds > 0)));
+        }
+
+        private static void AddStandOnChecks(ColregAnalysisRequest r, List<ColregFrame> frames,
+            ColregSpan span, bool own, List<ColregRuleCheck> checks)
+        {
+            var t = r.Thresholds;
+            int first = span.First;
+            int stage = StandOnStage(frames[first], false, t);
+            var otherFirst = own ? frames[first].Target : frames[first].Own;
+            var previous = otherFirst;
+            double accumulated = 0, minimum = 0, maximum = 0;
+            bool otherSubstantial = false;
+            for (int i = span.First + 1; i < span.Last; i++)
+            {
+                var current = own ? frames[i].Target : frames[i].Own;
+                accumulated += ColregEngine.Delta(ColregEngine.Heading(previous), ColregEngine.Heading(current));
+                otherSubstantial |= accumulated - minimum >= t.SubstantialTurnDeg || maximum - accumulated >= t.SubstantialTurnDeg ||
+                    Math.Abs(current.SogMps - otherFirst.SogMps) >= t.SubstantialSpeedChangeMps;
+                maximum = Math.Max(maximum, accumulated);
+                minimum = Math.Min(minimum, accumulated);
+                previous = current;
+                int nextStage = StandOnStage(frames[i], otherSubstantial, t);
+                if (nextStage == stage) continue;
+                AddStandOnPhase(r, frames, new ColregSpan(first, i, span.Band), span.First, own, stage, checks);
+                first = i;
+                stage = nextStage;
+            }
+            AddStandOnPhase(r, frames, new ColregSpan(first, span.Last, span.Band), span.First, own, stage, checks);
+        }
+
+        private static int StandOnStage(ColregFrame frame, bool otherSubstantial, ColregThresholds t)
+        {
+            if (!frame.HasCollisionRisk || (otherSubstantial && SafePassing(frame.Cpa, t))) return 0;
+            if (frame.Cpa.TcpaSec <= t.StandOnEmergencyTcpaSeconds + 1e-7) return 2;
+            return frame.Cpa.TcpaSec <= t.StandOnInterventionTcpaSeconds + 1e-7 ? 1 : 0;
+        }
+
+        private static void AddStandOnPhase(ColregAnalysisRequest r, List<ColregFrame> frames,
+            ColregSpan span, int encounterFirst, bool own, int stage, List<ColregRuleCheck> checks)
+        {
+            var t = r.Thresholds;
+            var first = frames[span.First];
+            var last = frames[span.Last];
+            var action = Observe(frames, span, own, t);
+            bool observed = action.ObservedDurationSeconds > 0;
+            bool holding = Holding(frames, span, own, t);
+            bool substantial = Substantial(action, t);
+            bool continuing = ContinuingManeuver(frames, span, encounterFirst, own, action, t);
+            double minimumDistance = MinimumObservedDistance(frames, span);
+            bool safe = SafePassing(last.Cpa, t) && minimumDistance >= t.SafePassingDcpaNm * VesselMotionState.MetersPerNm;
+            bool forbiddenPort = first.Situation == EncounterSituation.Crossing && PortTowardPortVessel(frames, span, own, action, t);
+            RuleCheckStatus status;
+            if (!observed) status = RuleCheckStatus.Partial;
+            else if (forbiddenPort) status = RuleCheckStatus.NotSatisfied;
+            else if (stage == 2) status = (substantial || continuing) && safe ? RuleCheckStatus.Partial : RuleCheckStatus.NotSatisfied;
+            else if (holding) status = RuleCheckStatus.Satisfied;
+            else if (stage == 1) status = substantial && safe ? RuleCheckStatus.Satisfied : RuleCheckStatus.NotSatisfied;
+            else status = RuleCheckStatus.NotSatisfied;
+            double earlyTcpa, earlyDistance;
+            ActionEvidence(r, action, first, out earlyTcpa, out earlyDistance);
+            var evidence = new ColregEvidence(own ? first.OwnBearingDeg : first.TargetBearingDeg,
+                first.HeadingDifferenceDeg, first.Cpa.DcpaM, first.Cpa.TcpaSec, action.HeadingChangeDeg,
+                action.SpeedChangeMps, first.VisibilityNm, first.Cpa.CurrentDistanceM, last.Cpa.DcpaM,
+                minimumDistance, last.Cpa.TcpaSec, last.Cpa.CurrentDistanceM, earlyTcpa, earlyDistance);
+            checks.Add(new ColregRuleCheck(first.Own.Time, last.Own.Time, ColregRuleId.R17,
+                own ? r.OwnVesselId : r.TargetVesselId, status,
+                stage == 2 ? "R17(b)" : stage == 1 ? "R17(a)(ii)" : "R17(a)(i)",
+                stage == 2 ? "紧迫阶段应采取最有助于避碰的行动；交叉局面避免向左舷来船左转。" :
+                stage == 1 ? "他船明显未适当行动时可采取避碰行动；避免向左舷来船左转。" : "直航船应保向保速，并持续观察让路船行动。",
+                action, evidence,
+                "按本阶段剩余TCPA与已观测的让路船行动核查；保向保速=" + holding + "；安全驶过代理=" + safe + "；连续操纵=" + continuing +
+                "；朝左舷来船左转=" + forbiddenPort + "。" +
+                (stage == 2 ? "缺少操纵性能与停船距离，无法证实单凭让路船已不能避碰；即使动作有效亦仅部分核查。" : "") +
+                "R17不解除让路船义务。" + ObservationNote(observed)));
+        }
+
+        private static bool ContinuingManeuver(List<ColregFrame> frames, ColregSpan span, int encounterFirst,
+            bool own, ObservedManeuver action, ColregThresholds t)
+        {
+            if (span.First <= encounterFirst || action.ObservedDurationSeconds <= 0) return false;
+            var before = own ? frames[span.First - 1].Own : frames[span.First - 1].Target;
+            var after = own ? frames[span.First].Own : frames[span.First].Target;
+            double turn = ColregEngine.Delta(ColregEngine.Heading(before), ColregEngine.Heading(after));
+            double speed = after.SogMps - before.SogMps;
+            bool sameTurn = (turn > 0 && action.HeadingChangeDeg > t.MaintainHeadingToleranceDeg) ||
+                (turn < 0 && action.HeadingChangeDeg < -t.MaintainHeadingToleranceDeg);
+            bool sameSpeed = (speed > 0 && action.SpeedChangeMps > t.MaintainSpeedToleranceMps) ||
+                (speed < 0 && action.SpeedChangeMps < -t.MaintainSpeedToleranceMps);
+            if (!sameTurn && !sameSpeed) return false;
+            return Substantial(Observe(frames, new ColregSpan(encounterFirst, span.Last, span.Band), own, t), t);
+        }
+
+        private static bool Emergency(List<ColregFrame> frames, ColregSpan span, ColregThresholds t)
+        {
+            // 不将下一局面端点的危险归到上一局面；单点带仍可显示阶段，但证据不足。
+            for (int i = span.First; i < span.Last || i == span.First; i++)
+                if (frames[i].HasCollisionRisk && frames[i].Cpa.TcpaSec <= t.StandOnEmergencyTcpaSeconds) return true;
+            return false;
+        }
+
+        private static bool PassesAstern(ColregFrame f, bool own)
+        {
+            var standOn = own ? f.Target : f.Own;
+            var giveWayCpa = own ? f.Cpa.OwnCpaEnu : f.Cpa.TargetCpaEnu;
+            var standOnCpa = own ? f.Cpa.TargetCpaEnu : f.Cpa.OwnCpaEnu;
+            double rad = ColregEngine.Heading(standOn) * Math.PI / 180;
+            return (giveWayCpa.EastM - standOnCpa.EastM) * Math.Sin(rad) +
+                (giveWayCpa.NorthM - standOnCpa.NorthM) * Math.Cos(rad) <= 0;
+        }
+
+        private static bool PortTowardPortVessel(List<ColregFrame> frames, ColregSpan span, bool own,
+            ObservedManeuver action, ColregThresholds t)
+        {
+            if (action.MaxPortTurnDeg <= t.MaintainHeadingToleranceDeg) return false;
+            for (int i = span.First; i < span.Last; i++)
+            {
+                double bearing = own ? frames[i].OwnBearingDeg : frames[i].TargetBearingDeg;
+                var before = own ? frames[i].Own : frames[i].Target;
+                var after = own ? frames[i + 1].Own : frames[i + 1].Target;
+                if (bearing > 180 && ColregEngine.Delta(ColregEngine.Heading(before), ColregEngine.Heading(after)) < 0) return true;
+            }
+            return false;
+        }
+
+        private static void RestrictedTurns(List<ColregFrame> frames, ColregSpan span, bool own,
+            ObservedManeuver action, ColregThresholds t, out bool foreApplicable, out bool aftApplicable,
+            out bool foreViolation, out bool aftViolation)
+        {
+            foreApplicable = aftApplicable = foreViolation = aftViolation = false;
+            for (int i = span.First; i < span.Last || i == span.First; i++)
+            {
+                var f = frames[i];
+                double bearing = own ? f.OwnBearingDeg : f.TargetBearingDeg;
+                bool forward = bearing < 90 || bearing > 270;
+                bool overtakingTarget = f.Overtaker == (own ? 1 : 2);
+                if (forward && !overtakingTarget) foreApplicable = true;
+                if (!forward) aftApplicable = true;
+                if (i == span.Last) continue;
+                var before = own ? f.Own : f.Target;
+                var after = own ? frames[i + 1].Own : frames[i + 1].Target;
+                double change = ColregEngine.Delta(ColregEngine.Heading(before), ColregEngine.Heading(after));
+                bool port = change < 0 && action.MaxPortTurnDeg > t.MaintainHeadingToleranceDeg;
+                bool starboard = change > 0 && action.MaxStarboardTurnDeg > t.MaintainHeadingToleranceDeg;
+                if (forward && !overtakingTarget && port) foreViolation = true;
+                if (!forward && ((bearing <= 180 && starboard) || (bearing >= 180 && port))) aftViolation = true;
+            }
+        }
+
+        private static double MaximumSpeed(List<ColregFrame> frames, ColregSpan span, bool own)
+        {
+            double result = 0;
+            for (int i = span.First; i <= span.Last; i++)
+                result = Math.Max(result, own ? frames[i].Own.SogMps : frames[i].Target.SogMps);
+            return result;
+        }
+
+        private static string ObservationNote(bool observed)
+        {
+            return observed ? "" : "仅有单时刻观测，无法核实操纵过程。";
+        }
+    }
+}

