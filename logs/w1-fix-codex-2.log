using System.Linq;
using Mcis.Domain.Colreg;
using Xunit;
using static Mcis.Acceptance.W1.Fx;

namespace Mcis.Acceptance.W1
{
    /// <summary>应采取行动 vs 实际操纵（R8/R16/R17/R19(d)/R13 被追越船）验收。示例数据·虚构。</summary>
    public sealed class ActionAcceptanceTests
    {
        private static Ship CrossTgt() => CollisionTarget(45, 2828.4, 400); // 右舷来船，T=400 s 相撞

        // ---------- R16 ----------

        /// <summary>R16/R8(a)(b)(d)：让路船在 TCPA≈340 s 时右转 60°（及早、大幅、驶过距离 ≥0.5 nm、从直航船船尾驶过）→ R16、R15、R8 满足。</summary>
        [Fact]
        public void R16_EarlySubstantialStarboardTurn_Satisfied()
        {
            var r = Ok(new Ship(0, 0, 0, 5).Order(60, 60).Run(450), CrossTgt().Run(450));
            var r16 = Checks(r, ColregRuleId.R16, Own).Where(c => c.Status != RuleCheckStatus.NotApplicable).ToList();
            Assert.NotEmpty(r16);
            Assert.All(r16, c => Assert.Equal(RuleCheckStatus.Satisfied, c.Status));
            Assert.Contains(Checks(r, ColregRuleId.R15, Own), c => c.Status == RuleCheckStatus.Satisfied);
            Assert.Contains(Checks(r, ColregRuleId.R8, Own), c => c.Status == RuleCheckStatus.Satisfied);
            Assert.Equal(TurnDirection.Starboard, r16[0].ActualAction.Turn);
            Assert.True(r16[0].Evidence.EarlyActionRemainingTcpaSeconds > 300, Describe(r));
        }

        /// <summary>R16"及早"：同样 60° 右转但在 TCPA≈70 s、距离 0.27 nm 时才采取 → R16 不满足（不得被判满足）。</summary>
        [Fact]
        public void R16_LateAction_NotSatisfied()
        {
            var r = Ok(new Ship(0, 0, 0, 5).Order(330, 60).Run(450), CrossTgt().Run(450));
            var own = Checks(r, ColregRuleId.R16, Own).Where(c => c.Status != RuleCheckStatus.NotApplicable).ToList();
            Assert.Contains(own, c => c.Status == RuleCheckStatus.NotSatisfied);
            Assert.DoesNotContain(own, c => c.Status == RuleCheckStatus.Satisfied);
        }

        /// <summary>R16：让路船全程保向保速 → R16、R8 不满足；R15 不满足。</summary>
        [Fact]
        public void R16_NoAction_NotSatisfied()
        {
            var r = Ok(new Ship(0, 0, 0, 5).Run(450), CrossTgt().Run(450));
            Assert.Equal(RuleCheckStatus.NotSatisfied, Checks(r, ColregRuleId.R16, Own).First().Status);
            Assert.Equal(RuleCheckStatus.NotSatisfied, Checks(r, ColregRuleId.R15, Own).First().Status);
            Assert.Contains(Checks(r, ColregRuleId.R8, Own), c => c.Status == RuleCheckStatus.NotSatisfied);
        }

        /// <summary>R16"大幅度"：及早但只右转 5°（小于 R8 明显阈值 10°）→ 不满足。</summary>
        [Fact]
        public void R16_SmallAlteration_NotSatisfied()
        {
            var r = Ok(new Ship(0, 0, 0, 5).Order(60, 5).Run(450), CrossTgt().Run(450));
            Assert.DoesNotContain(Checks(r, ColregRuleId.R16, Own), c => c.Status == RuleCheckStatus.Satisfied);
        }

        // ---------- R17 ----------

        /// <summary>R17(a)(i)/(b)：直航船保向保速 → 早期 R17(a)(i) 满足；进入紧迫阶段（TCPA≤60 s）仍保向保速 → R17(b) 不满足。</summary>
        [Fact]
        public void R17_StandOnHolds_ThenFailsToActInExtremis()
        {
            var r = Ok(new Ship(0, 0, 0, 5).Run(450), CrossTgt().Run(450));
            var c = Checks(r, ColregRuleId.R17, Tgt).ToList();
            Assert.Contains(c, x => x.Clause == "R17(a)(i)" && x.Status == RuleCheckStatus.Satisfied);
            Assert.Contains(c, x => x.Clause == "R17(b)" && x.Status == RuleCheckStatus.NotSatisfied);
        }

        /// <summary>R17(a)(i)：让路船尚有充分时间（TCPA≈300 s）时直航船擅自大幅右转 → 不满足保向保速。</summary>
        [Fact]
        public void R17_StandOnPrematureAlteration_NotSatisfied()
        {
            var r = Ok(new Ship(0, 0, 0, 5).Run(450), CrossTgt().Order(100, 315).Run(450));
            Assert.Contains(Checks(r, ColregRuleId.R17, Tgt), x => x.Clause == "R17(a)(i)" && x.Status == RuleCheckStatus.NotSatisfied);
        }

        /// <summary>
        /// R17(a)(ii)：让路船未行动，TCPA≈175 s（已进入引擎自身的介入门限 180 s）时直航船独自右转 120° 远离，碰撞危险在 240 s 解除、驶过距离 ≥0.5 nm。
        /// 这是允许的独自行动，不应判 NotSatisfied；也不应因本船转向使 TCPA 回升而把同一操纵的后半段改按 R17(a)(i)"擅自变向"判定。
        /// </summary>
        [Fact]
        [Trait("Category", "KnownDefect")]
        public void W1_D06_R17_StandOnIndependentAction_NotFragmentedIntoViolations()
        {
            var tgt = CrossTgt();
            var r = Ok(new Ship(0, 0, 0, 5).Run(450), tgt.Order(225, Norm(tgt.Heading + 120)).Run(450));
            var during = Checks(r, ColregRuleId.R17, Tgt).Where(x => x.EndTime.Seconds > 220 && x.Status != RuleCheckStatus.NotApplicable).ToList();
            Assert.NotEmpty(during);
            Assert.DoesNotContain(during, x => x.Status == RuleCheckStatus.NotSatisfied);
        }

        /// <summary>R17(c)：交叉局面直航船若采取行动，不应对左舷来船向左转向 → 不满足。</summary>
        [Fact]
        public void R17_StandOnPortTurnTowardPortVessel_NotSatisfied()
        {
            var tgt = CrossTgt();
            var r = Ok(new Ship(0, 0, 0, 5).Run(450), tgt.Order(250, Norm(tgt.Heading - 60)).Run(450));
            Assert.Contains(Checks(r, ColregRuleId.R17, Tgt), x => x.Status == RuleCheckStatus.NotSatisfied && x.ActualAction.MaxPortTurnDeg > 30);
        }

        /// <summary>R13 + R17：被追越船（直航船）中途大幅转向，R13 对被追越船的核查应与 R17 保向保速结论一致，不应 R13=满足而 R17=不满足。</summary>
        [Fact]
        public void R13_OvertakenVesselAlteration_R13AndR17Agree()
        {
            var own = new Ship(0, 0, 0, 5).Order(30, 40);
            var r = Ok(own.Run(300), new Ship(0, -800, 0, 10).Run(300));
            var r13 = Checks(r, ColregRuleId.R13, Own).Where(c => c.Status != RuleCheckStatus.NotApplicable).ToList();
            var r17 = Checks(r, ColregRuleId.R17, Own).Where(c => c.Status != RuleCheckStatus.NotApplicable).ToList();
            Assert.NotEmpty(r13);
            Assert.Contains(r17, c => c.Status == RuleCheckStatus.NotSatisfied);
            Assert.DoesNotContain(r13, c => c.Status == RuleCheckStatus.Satisfied);
        }

        // ---------- R8 明显行动阈值 ----------

        /// <summary>R8(b)"大得足以使他船容易察觉"以 SubstantialTurnDeg=10° 为代理：9.5° 非明显、10° 明显（含边界）。安全距离阈值放宽以单独观察"明显"。</summary>
        [Theory]
        [InlineData(9.5, false)]
        [InlineData(10.0, true)]
        [InlineData(25.0, true)]
        public void R8_SubstantialTurnThreshold(double turn, bool substantial)
        {
            var th = new ColregThresholds(safePassingDcpaNm: 0.001, clearDistanceNm: 0.001);
            var r = Ok(new Ship(0, 0, 0, 5).Order(60, turn).Run(450), CrossTgt().Run(450), th);
            var first = Checks(r, ColregRuleId.R8, Own).First();
            Assert.Contains("明显行动=" + substantial, first.Explanation);
        }

        /// <summary>阈值可配置：SubstantialTurnDeg=30 时 20° 右转不再"明显"。</summary>
        [Fact]
        public void R8_SubstantialTurnThreshold_IsConfigurable()
        {
            var th = new ColregThresholds(substantialTurnDeg: 30, safePassingDcpaNm: 0.001, clearDistanceNm: 0.001);
            var r = Ok(new Ship(0, 0, 0, 5).Order(60, 20).Run(450), CrossTgt().Run(450), th);
            Assert.Contains("明显行动=False", Checks(r, ColregRuleId.R8, Own).First().Explanation);
        }

        /// <summary>R8(b) 变速代理：减速 ≥1.0 m/s 为明显行动。</summary>
        [Fact]
        public void R8_SubstantialSpeedReduction()
        {
            var th = new ColregThresholds(safePassingDcpaNm: 0.001, clearDistanceNm: 0.001);
            var r = Ok(new Ship(0, 0, 0, 5) { Accel = 5 }.Order(60, 0, 2.0).Run(450), CrossTgt().Run(450), th);
            Assert.Contains("明显行动=True", Checks(r, ColregRuleId.R8, Own).First().Explanation);
        }

        /// <summary>359°→1° 跨零小幅右转：本船 355°→15°（+20°）应识别为右转 20°，不得为 -340°。</summary>
        [Fact]
        public void HeadingWrap_TurnAcrossNorth_IsStarboard20()
        {
            var r = Ok(new Ship(0, 0, 355, 5).Order(60, 15).Run(300), new Ship(0, 4000, 175, 5).Run(300));
            var c = Checks(r, ColregRuleId.R8, Own).First();
            var all = r.RuleChecks.Where(x => x.VesselId == Own).Select(x => x.ActualAction.HeadingChangeDeg).ToList();
            Assert.Contains(all, h => System.Math.Abs(h - 20) < 0.5);
            Assert.DoesNotContain(all, h => System.Math.Abs(h) > 25);
            Assert.Equal(TurnDirection.Starboard, r.RuleChecks.First(x => x.VesselId == Own && System.Math.Abs(x.ActualAction.HeadingChangeDeg - 20) < 0.5).ActualAction.Turn);
        }

        // ---------- R19(d) ----------

        /// <summary>R19(d)(i)：能见度不良、对正横前且构成碰撞危险的他船，本船左转 → 不满足。</summary>
        [Fact]
        public void R19d_i_PortTurnForVesselForwardOfBeam_NotSatisfied()
        {
            var r = Ok(new Ship(0, 0, 0, 5).Order(60, 330).Run(300), CollisionTarget(0, 4000, 400).Run(300), vis: 0.5, inSight: false);
            Assert.Contains(Checks(r, ColregRuleId.R19, Own), c => c.Clause == "R19(d)(i)" && c.Status == RuleCheckStatus.NotSatisfied);
        }

        /// <summary>R19(d)(i)：右转避让正前方来船 → 满足（不违反）。</summary>
        [Fact]
        public void R19d_i_StarboardTurnForVesselAhead_Satisfied()
        {
            var r = Ok(new Ship(0, 0, 0, 5).Order(60, 40).Run(300), CollisionTarget(0, 4000, 400).Run(300), vis: 0.5, inSight: false);
            Assert.Contains(Checks(r, ColregRuleId.R19, Own), c => c.Clause == "R19(d)(i)" && c.Status == RuleCheckStatus.Satisfied);
        }

        /// <summary>R19(d)(ii)：他船在右舷正横后且有碰撞危险，本船右转（朝其转向）→ 不满足。</summary>
        [Fact]
        public void R19d_ii_TurnTowardVesselAbaftBeam_NotSatisfied()
        {
            var r = Ok(new Ship(0, 0, 0, 5).Order(30, 40).Run(200), CollisionTarget(150, 1000, 300).Run(200), vis: 0.5, inSight: false);
            Assert.Contains(Checks(r, ColregRuleId.R19, Own), c => c.Clause == "R19(d)(ii)" && c.Status == RuleCheckStatus.NotSatisfied);
        }

        /// <summary>
        /// R19(d) 的转向限制以"判定正在形成紧迫局面和/或存在碰撞危险并采取避让行动"为前提。
        /// 他船在右前方 2 nm 外安全驶过（无碰撞危险）时本船左转，不应判 R19(d)(i) 不满足。
        /// </summary>
        [Fact]
        [Trait("Category", "KnownDefect")]
        public void W1_D05_R19d_NotApplicableWithoutCloseQuartersOrRisk()
        {
            var r = Ok(new Ship(0, 0, 0, 5).Order(30, 340).Run(200), new Ship(4000, 4000, 180, 5).Run(200), vis: 0.5, inSight: false);
            Assert.DoesNotContain(Checks(r, ColregRuleId.R19, Own), c => c.Clause.StartsWith("R19(d)") && c.Status == RuleCheckStatus.NotSatisfied);
        }

        /// <summary>R19(b) 安全航速：观测最大航速 > SafeSpeedMps（默认 5 m/s）→ 不满足；阈值可配置。</summary>
        [Fact]
        public void R19b_SafeSpeedProxy_ConfigurableThreshold()
        {
            var tgt = CollisionTarget(0, 4000, 400);
            var fast = Ok(new Ship(0, 0, 0, 7).Run(200), tgt.Run(200), vis: 0.5, inSight: false);
            Assert.Contains(Checks(fast, ColregRuleId.R19, Own), c => c.Clause == "R19(b)" && c.Status == RuleCheckStatus.NotSatisfied);
            var relaxed = Ok(new Ship(0, 0, 0, 7).Run(200), tgt.Run(200), new ColregThresholds(safeSpeedMps: 8), vis: 0.5, inSight: false);
            Assert.Contains(Checks(relaxed, ColregRuleId.R19, Own), c => c.Clause == "R19(b)" && c.Status == RuleCheckStatus.Satisfied);
        }
    }
}
using System.Linq;
using Mcis.Domain.Colreg;
using Xunit;
using static Mcis.Acceptance.W1.Fx;

namespace Mcis.Acceptance.W1
{
    /// <summary>会遇局面判定（R13/R14/R15/R19）验收。示例数据·虚构。</summary>
    public sealed class SituationAcceptanceTests
    {
        // ---------- R14 对遇 ----------

        /// <summary>R14(a)(b)：反向或接近反向航向、他船在正前方 → 对遇，双方均须向右转向；无直航船。</summary>
        [Fact]
        public void R14_ExactReciprocal_IsHeadOn_BothMustAlterToStarboard()
        {
            var tgt = CollisionTarget(0, 4000, 400);
            var r = Ok(new Ship(0, 0, 0, 5).Run(300), tgt.Run(300));
            var b = r.TimeBands.First();
            Assert.Equal(EncounterSituation.HeadOn, b.Situation);
            Assert.Equal(TrafficRole.BothActionRequired, b.OwnRole);
            Assert.Equal(TrafficRole.BothActionRequired, b.TargetRole);
            Assert.Contains(ColregRuleId.R14, b.ApplicableRules);
            Assert.DoesNotContain(ColregRuleId.R17, b.ApplicableRules);
            foreach (var v in new[] { Own, Tgt })
                Assert.Contains("右", Checks(r, ColregRuleId.R14, v).First().ExpectedAction);
        }

        /// <summary>R14(b) 夜间"桅灯成一直线或接近一直线"以船首向差 ≤6° 近似：边界内侧（含 6.0°）为对遇，外侧 6.1° 为交叉。</summary>
        [Theory]
        [InlineData(0.0, true)]
        [InlineData(5.9, true)]
        [InlineData(6.0, true)]
        [InlineData(-6.0, true)]
        [InlineData(6.1, false)]
        [InlineData(-6.1, false)]
        [InlineData(10.0, false)]
        public void R14_HeadingDifferenceBoundary_SixDegrees(double offset, bool headOn)
        {
            // 他船以 180+offset 航向驶向碰撞点(0,2000)，T=400 s；方位始终在船首 ±15° 内。
            double h = 180 + offset;
            var tgt = new Ship(-5 * Sin(h) * 400, 2000 - 5 * Cos(h) * 400, h, 5);
            var r = Ok(new Ship(0, 0, 0, 5).Run(300), tgt.Run(300));
            var s = r.TimeBands.First().Situation;
            if (headOn) Assert.Equal(EncounterSituation.HeadOn, s);
            else Assert.Equal(EncounterSituation.Crossing, s);
        }

        /// <summary>R14(b)：船首向反向但他船明显偏在船首一侧（桅灯不可能成一直线，方位 30°）→ 不按对遇。</summary>
        [Fact]
        public void R14_ReciprocalButWellOffBow_IsNotHeadOn()
        {
            // 他船位于方位 30°、距 1400 m，航向 180 → 横距 700 m=0.38 nm (<0.5 有碰撞危险)
            var tgt = new Ship(1400 * Sin(30), 1400 * Cos(30), 180, 5);
            var r = Ok(new Ship(0, 0, 0, 5).Run(60), tgt.Run(60));
            Assert.NotEqual(EncounterSituation.HeadOn, r.TimeBands.First().Situation);
        }

        /// <summary>航向 359°→1° 跨零：本船 359°、他船 179°（反向，差 180°）应判对遇，船首向差证据为 180。</summary>
        [Fact]
        public void R14_HeadingWrapAroundZero_359vs179_IsHeadOn()
        {
            var own = new Ship(0, 0, 359, 5);
            // 碰撞点：本船 400 s 后位置
            double pe = 5 * Sin(359) * 400, pn = 5 * Cos(359) * 400;
            var tgt = new Ship(pe - 5 * Sin(179) * 400, pn - 5 * Cos(179) * 400, 179, 5);
            var r = Ok(own.Run(300), tgt.Run(300));
            Assert.Equal(EncounterSituation.HeadOn, r.TimeBands.First().Situation);
            Assert.Equal(180.0, Checks(r, ColregRuleId.R14, Own).First().Evidence.HeadingDifferenceDeg, 3);
        }

        // ---------- R15 交叉 ----------

        /// <summary>R15：他船在本船右舷（方位 45°）→ 本船让路、他船直航。</summary>
        [Fact]
        public void R15_TargetOnStarboard_OwnGivesWay()
        {
            var r = Ok(new Ship(0, 0, 0, 5).Run(300), CollisionTarget(45, 2828.4, 400).Run(300));
            var b = r.TimeBands.First();
            Assert.Equal(EncounterSituation.Crossing, b.Situation);
            Assert.Equal(TrafficRole.GiveWay, b.OwnRole);
            Assert.Equal(TrafficRole.StandOn, b.TargetRole);
            Assert.Contains(ColregRuleId.R15, b.ApplicableRules);
            Assert.Contains(ColregRuleId.R16, b.ApplicableRules);
            Assert.Contains(ColregRuleId.R17, b.ApplicableRules);
        }

        /// <summary>R15/R17：他船在本船左舷（方位 315°）→ 本船直航、他船让路。</summary>
        [Fact]
        public void R15_TargetOnPort_OwnStandsOn()
        {
            var r = Ok(new Ship(0, 0, 0, 5).Run(300), CollisionTarget(315, 2828.4, 400).Run(300));
            var b = r.TimeBands.First();
            Assert.Equal(EncounterSituation.Crossing, b.Situation);
            Assert.Equal(TrafficRole.StandOn, b.OwnRole);
            Assert.Equal(TrafficRole.GiveWay, b.TargetRole);
            Assert.Equal(RuleCheckStatus.NotApplicable, Checks(r, ColregRuleId.R15, Own).First().Status);
        }

        /// <summary>
        /// R15 + R8(d)/R16"直至最后驶过让清"：交叉局面的让路/直航义务确定后，不应因让路船自己的（迟到但大幅的）右转使相对方位落到左舷而互换角色。
        /// </summary>
        [Fact]
        [Trait("Category", "KnownDefect")]
        public void W1_D01_Crossing_RolesMustNotFlipAfterGiveWayStarboardTurn()
        {
            var tgt = CollisionTarget(45, 2828.4, 400);
            var r = Ok(new Ship(0, 0, 0, 5).Order(250, 60).Run(450), tgt.Run(450));
            Assert.DoesNotContain(r.TimeBands, b => b.Situation == EncounterSituation.Crossing && b.OwnRole == TrafficRole.StandOn);
            // 原直航船（乙）不应被判 R16 让路义务不满足
            Assert.DoesNotContain(Checks(r, ColregRuleId.R16, Tgt), c => c.Status == RuleCheckStatus.NotSatisfied);
        }

        /// <summary>
        /// R14(a)：对遇中一船按规定右转后，局面不应改判为"交叉"并把正确右转的船定为直航船、保向的他船定为让路船。
        /// </summary>
        [Fact]
        [Trait("Category", "KnownDefect")]
        public void W1_D02_HeadOn_ProperStarboardTurnMustNotReclassifyToCrossingWithSwappedRoles()
        {
            var r = Ok(new Ship(0, 0, 0, 5).Order(100, 30).Run(450), CollisionTarget(0, 4000, 400).Run(450));
            Assert.DoesNotContain(r.TimeBands, b => b.Situation == EncounterSituation.Crossing);
            Assert.DoesNotContain(Checks(r, ColregRuleId.R16, Tgt), c => c.Status == RuleCheckStatus.NotSatisfied);
        }

        // ---------- R13 追越 ----------

        /// <summary>R13(b)(c)：来自正横后大于 22.5°（相对方位 112.5°–247.5°）为追越；存疑按追越 → 边界闭区间。边界外侧为交叉。</summary>
        [Theory]
        [InlineData(112.49, EncounterSituation.Crossing)]
        [InlineData(112.51, EncounterSituation.Overtaking)]
        [InlineData(150.0, EncounterSituation.Overtaking)]
        [InlineData(180.0, EncounterSituation.Overtaking)]
        [InlineData(247.49, EncounterSituation.Overtaking)]
        [InlineData(247.51, EncounterSituation.Crossing)]
        public void R13_OvertakingSectorBoundaries(double bearing, EncounterSituation expected)
        {
            var tgt = CollisionTarget(bearing, 1000, 300);
            var r = Ok(new Ship(0, 0, 0, 5).Run(200), tgt.Run(200));
            var b = r.TimeBands.First();
            Assert.Equal(expected, b.Situation);
            if (expected == EncounterSituation.Overtaking)
            {
                Assert.Equal(TrafficRole.StandOn, b.OwnRole);   // 被追越
                Assert.Equal(TrafficRole.GiveWay, b.TargetRole); // 追越船
                Assert.Contains(ColregRuleId.R13, b.ApplicableRules);
            }
        }

        /// <summary>R13(a)：追越条款优先于交叉 —— 追越船即使位于被追越船右舷后方，也不得按 R15 让被追越船让路。</summary>
        [Fact]
        public void R13_OvertakingFromStarboardQuarter_OverridesCrossing()
        {
            var tgt = CollisionTarget(135, 1000, 300);
            var r = Ok(new Ship(0, 0, 0, 5).Run(200), tgt.Run(200));
            Assert.Equal(EncounterSituation.Overtaking, r.TimeBands.First().Situation);
            Assert.DoesNotContain(ColregRuleId.R15, r.TimeBands.First().ApplicableRules);
        }

        /// <summary>R13(d)：追越局面一旦确定，此后方位变化（追越船到正横、再横越前方）不使其成为交叉船，直至驶过让清。</summary>
        [Fact]
        public void R13_OvertakingPersistsUntilPastAndClear()
        {
            // 他船在本船右后方 100 m 横距、1000 m 后，航速 10 → 200 s 时到正横，随后左转 300° 横越本船船首
            var own = new Ship(0, 0, 0, 5);
            var tgt = new Ship(100, -1000, 0, 10).Order(200, 300);
            var r = Ok(own.Run(600), tgt.Run(600));
            var first = r.TimeBands.First();
            Assert.Equal(EncounterSituation.Overtaking, first.Situation);
            Assert.DoesNotContain(r.TimeBands, b => b.Situation == EncounterSituation.Crossing || b.Situation == EncounterSituation.HeadOn);
            // 追越船角色始终是让路船
            Assert.All(r.TimeBands.Where(b => b.Situation == EncounterSituation.Overtaking), b => Assert.Equal(TrafficRole.GiveWay, b.TargetRole));
        }

        /// <summary>R13(d)：驶过让清后追越身份解除 → 最后一段为无碰撞危险。</summary>
        [Fact]
        public void R13_OvertakingReleasedAfterClear()
        {
            var r = Ok(new Ship(0, 0, 0, 5).Run(600), new Ship(100, -1000, 0, 10).Run(600));
            Assert.Equal(EncounterSituation.Overtaking, r.TimeBands.First().Situation);
            Assert.Equal(EncounterSituation.NoCollisionRisk, r.TimeBands.Last().Situation);
        }

        // ---------- R19 能见度不良 ----------

        /// <summary>R19(a)/R11：未互见（显式 false）时适用 R19，优先于 R13–R15（对遇几何）。</summary>
        [Fact]
        public void R19_NotInSight_OverridesHeadOn()
        {
            var r = Ok(new Ship(0, 0, 0, 5).Run(300), CollisionTarget(0, 4000, 400).Run(300), vis: 1.0, inSight: false);
            var b = r.TimeBands.First();
            Assert.Equal(EncounterSituation.RestrictedVisibility, b.Situation);
            Assert.Contains(ColregRuleId.R19, b.ApplicableRules);
            Assert.DoesNotContain(ColregRuleId.R14, b.ApplicableRules);
            Assert.All(r.RuleChecks.Where(c => c.RuleId == ColregRuleId.R13 || c.RuleId == ColregRuleId.R14 || c.RuleId == ColregRuleId.R15),
                c => Assert.Equal(RuleCheckStatus.NotApplicable, c.Status));
        }

        /// <summary>R19(a)：未互见时追越几何也不按 R13 分让路/直航（双方均有 R19 行动义务）。</summary>
        [Fact]
        public void R19_NotInSight_OverridesOvertaking()
        {
            var r = Ok(new Ship(0, 0, 0, 5).Run(200), CollisionTarget(180, 1000, 300).Run(200), vis: 0.5, inSight: false);
            var b = r.TimeBands.First();
            Assert.Equal(EncounterSituation.RestrictedVisibility, b.Situation);
            Assert.Equal(TrafficRole.BothActionRequired, b.OwnRole);
            Assert.DoesNotContain(ColregRuleId.R13, b.ApplicableRules);
        }

        /// <summary>
        /// R11 + R19(a)：第二节（R11–R18）适用于"互见中的船舶"，R19 仅适用于"不在互见中"的船舶。能见度 1 nm 但已显式互见 → 应按 R14 对遇，而非 R19。
        /// （原型 11 也明确区分"能见度不良·未互见 R19"与"互见·对遇 R14"。）
        /// </summary>
        [Fact]
        [Trait("Category", "KnownDefect")]
        public void W1_D03_RestrictedVisibilityButExplicitlyInSight_AppliesSectionII()
        {
            var r = Ok(new Ship(0, 0, 0, 5).Run(300), CollisionTarget(0, 1500, 150).Run(140), vis: 1.0, inSight: true);
            Assert.Equal(EncounterSituation.HeadOn, r.TimeBands.First().Situation);
        }

        /// <summary>
        /// 原型 11 时间带"能见度不良·未互见 R19 → 互见·对遇 R14"：互见状态须能随时间变化（如环境序列或距离≤能见度时转为互见）。
        /// 能见度 1 nm 恒定、两船对驶从 2.2 nm 接近 → 距离进入 1 nm 后应出现互见的对遇时间带。
        /// </summary>
        [Fact]
        [Trait("Category", "KnownDefect")]
        public void W1_D04_InSightMustBeAbleToChangeOverTime_PrototypeBandSequence()
        {
            var env = new[] { Env(0, 1.0f) };
            var r = Ok(new Ship(0, 0, 0, 5).Run(380), CollisionTarget(0, 4000, 400).Run(380), vis: null, inSight: null, env: env);
            Assert.Equal(EncounterSituation.RestrictedVisibility, r.TimeBands.First().Situation);
            Assert.Contains(r.TimeBands, b => b.Situation == EncounterSituation.HeadOn);
        }

        /// <summary>能见度阈值：低于 2.0 nm（默认）且未给互见标志 → R19；等于 2.0 nm 不按能见度不良（阈值为严格小于，已在假设中说明）。</summary>
        [Theory]
        [InlineData(1.99, EncounterSituation.RestrictedVisibility)]
        [InlineData(2.0, EncounterSituation.HeadOn)]
        public void R19_VisibilityThreshold(double vis, EncounterSituation expected)
        {
            var r = Ok(new Ship(0, 0, 0, 5).Run(300), CollisionTarget(0, 4000, 400).Run(300), vis: vis, inSight: null);
            Assert.Equal(expected, r.TimeBands.First().Situation);
        }

        /// <summary>无碰撞危险（平行远离/横距 2 nm）→ 不分让路直航，R13–R17 全部不适用。R7 前提。</summary>
        [Fact]
        public void NoRisk_NoRolesAssigned()
        {
            var r = Ok(new Ship(0, 0, 0, 5).Run(200), new Ship(3704, 1000, 180, 5).Run(200));
            Assert.All(r.TimeBands, b => Assert.Equal(EncounterSituation.NoCollisionRisk, b.Situation));
            Assert.All(r.RuleChecks.Where(c => c.RuleId != ColregRuleId.R9), c => Assert.Equal(RuleCheckStatus.NotApplicable, c.Status));
        }
    }
}

