.rpt-pending, .rpt-error, .rpt-notice { padding: 8px 10px; border-radius: 4px; line-height: 1.65; overflow-wrap: anywhere; }
.rpt-pending { background: var(--amber-dim); color: #ffd166; border: 1px solid rgba(255,176,32,.4); }
.rpt-error { background: var(--red-dim); color: #ff9aae; border: 1px solid rgba(255,59,92,.4); }
.rpt-notice { background: rgba(59,227,255,.06); color: var(--cyan); border: 1px solid var(--border-line); }
.rpt-gisis-note { color: var(--text-muted); font-size: 10px; line-height: 1.65; margin: 0 0 10px; }
.rpt-gisis-fields { display: flex; flex-direction: column; gap: 9px; max-height: 680px; overflow-y: auto; }
.rpt-gisis-field { display: grid; grid-template-columns: minmax(110px,1fr) minmax(120px,1.2fr); gap: 4px 8px; padding-bottom: 8px; border-bottom: 1px solid var(--border-subtle); align-items: start; }
.rpt-gisis-field > label { color: var(--text-sec); font-size: 11px; }
.rpt-gisis-field > label small { display: block; color: var(--text-muted); font-size: 9px; }
.rpt-gisis-field .input, .rpt-gisis-field .select { width: 100%; min-width: 0; }
.rpt-gisis-field > .rpt-missing { grid-column: 2; color: var(--amber); font-size: 10px; }
.rpt-field-source { grid-column: 1 / -1; color: var(--text-muted); line-height: 1.5; font-size: 9px; overflow-wrap: anywhere; }
.rpt-field-mapping { grid-column: 1 / -1; display: flex; flex-wrap: wrap; gap: 4px 7px; align-items: center; color: var(--text-sec); font-size: 10px; }
.rpt-field-mapping small { flex-basis: 100%; color: var(--text-muted); line-height: 1.6; }
.rpt-mapping-tag { border: 1px solid var(--border-line); border-radius: 3px; padding: 1px 5px; }
.rpt-mapping-pending { color: #ffd166; background: var(--amber-dim); border-color: #ffd166; font-weight: 700; }
.rpt-field-rules { grid-column: 1 / -1; color: var(--text-muted); font-size: 10px; }
.rpt-field-rules summary { cursor: pointer; }
.rpt-field-rules pre { white-space: pre-wrap; overflow-wrap: anywhere; padding: 7px; background: var(--bg-input); }
.rpt-audit-list { display: flex; flex-direction: column; gap: 6px; max-height: 480px; overflow-y: auto; }
.rpt-audit { border: 1px solid var(--border-subtle); border-radius: 4px; padding: 7px 10px; font-size: 11px; }
.rpt-audit summary { color: var(--text-sec); }
.rpt-audit .mono { white-space: normal; }
.rpt-audit-values { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 10px; }
.rpt-audit-values pre { white-space: pre-wrap; overflow-wrap: anywhere; max-height: 320px; overflow-y: auto; color: var(--text-sec); background: var(--bg-input); padding: 8px; }
.rpt-reason { white-space: pre-wrap; overflow-wrap: anywhere; color: var(--text-main); padding: 7px 0; }
.rpt-modal-backdrop { position: fixed; inset: 0; z-index: 90; background: rgba(0,5,12,.78); display: flex; align-items: center; justify-content: center; padding: 24px; }
.rpt-modal { background: var(--bg-panel-solid); border: 1px solid var(--cyan); border-radius: 8px; box-shadow: 0 16px 64px #0009; padding: 18px; width: min(860px,100%); max-height: 90vh; overflow-y: auto; }
.rpt-modal h2 { font-size: 16px; margin: 0 0 15px; }
.rpt-edit-pair { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 12px; margin-bottom: 12px; }
.rpt-edit-pair label, .rpt-reason-label { display: flex; flex-direction: column; gap: 6px; color: var(--text-sec); }
.rpt-modal textarea { width: 100%; resize: vertical; line-height: 1.7; }
.rpt-dialog-actions { justify-content: flex-end; margin-top: 14px; }
@media (max-width: 1200px) { .rpt-columns { grid-template-columns: minmax(0,1.5fr) minmax(280px,1fr); } .rpt-heading { flex-direction: column; } .rpt-generate select { max-width: 240px; } }
