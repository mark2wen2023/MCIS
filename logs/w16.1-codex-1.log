"""W16 HTTP 接口。真实案例先检查使用状态，拒绝路径不发生任何写入。"""
from __future__ import annotations

from io import BytesIO
import hashlib
from typing import Any

from fastapi import APIRouter, Body
from fastapi.responses import StreamingResponse

from ..cases import service as cases
from ..common import contracts
from ..common.context import Ctx, CtxDep, problem
from ..db import WRITE_LOCK, list_docs
from ..redaction.gateway import require
from . import service
from .models import ReportRow

router = APIRouter(prefix='/api/v1', tags=['reports'])


def file_response(data: bytes, filename: str, media_type: str) -> StreamingResponse:
    return StreamingResponse(BytesIO(data), media_type=media_type,
                             headers={'Content-Disposition': f'attachment; filename="{filename}"',
                                      'X-Sha256': hashlib.sha256(data).hexdigest()})


def check_access(s, ctx: Ctx, case_id: str, *, write: bool = False, fictional: bool = False) -> dict:
    case = service.case_info(s, case_id)
    # 必须在权限或上游访问前阻止真实案例生成，不触发只读接口中的延迟初始化。
    if fictional:
        service.require_fictional(case)
    # 报告保存跨来源完整快照，W17尚未提供报告字段脱敏；仅调查员可读写。
    if ctx.role not in ('LeadInvestigator', 'Investigator'):
        raise problem(403, 'FORBIDDEN', '当前报告包含受限证据与询问来源，仅调查员可访问')
    require(ctx, s, case_id, 'report_draft', write=write)
    return case


@router.get('/report-templates')
def get_templates(caseId: str | None = None, ctx: Ctx = CtxDep) -> dict:
    from .templates import TEMPLATES
    status = 'fictional'
    if caseId:
        with ctx.db.session() as s:
            status = service.data_status(service.case_info(s, caseId))
    return {'templates': TEMPLATES, 'caseId': caseId, 'realDataStatus': status}


@router.get('/report-glossary')
def get_glossary() -> list:
    from .templates import GLOSSARY
    return GLOSSARY


@router.get('/cases/{case_id}/reports')
def list_reports(case_id: str, ctx: Ctx = CtxDep) -> dict:
    with ctx.db.session() as s:
        case = check_access(s, ctx, case_id)
        if not service.is_fictional(case):
            return service.pending(case)
        return {'caseId': case_id, 'realDataStatus': 'fictional',
                'reports': list_docs(s, ReportRow, case_id)}


@router.post('/cases/{case_id}/reports', status_code=201)
def create_report(case_id: str, body: dict[str, Any] = Body(...), ctx: Ctx = CtxDep) -> dict:
    with WRITE_LOCK, ctx.db.session() as s:
        case = check_access(s, ctx, case_id, write=True, fictional=True)
        template_id, lang = service.options(body)
        return service.create_report(s, ctx, case, template_id, lang)


@router.post('/cases/{case_id}/reports/sections/colreg:draft', status_code=201)
def colreg_draft(case_id: str, body: dict[str, Any] | None = Body(None), ctx: Ctx = CtxDep) -> dict:
    with WRITE_LOCK, ctx.db.session() as s:
        case = check_access(s, ctx, case_id, write=True, fictional=True)
        template_id, lang = service.options(body or {}, optional=True)
        report = service.create_report(s, ctx, case, template_id, lang, colreg_only=True)
        return {'section': report['sections'][0], 'reportId': report['reportId'],
                'reportHref': report['reportHref'], 'report': report}


@router.get('/cases/{case_id}/reports/{report_id}')
def get_report(case_id: str, report_id: str, ctx: Ctx = CtxDep) -> dict:
    with ctx.db.session() as s:
        case = check_access(s, ctx, case_id)
        if not service.is_fictional(case):
            return service.pending(case)
        return service.get_report(s, case_id, report_id)


@router.post('/cases/{case_id}/reports/{report_id}:generate', status_code=201)
def regenerate(case_id: str, report_id: str, ctx: Ctx = CtxDep) -> dict:
    with WRITE_LOCK, ctx.db.session() as s:
        case = check_access(s, ctx, case_id, write=True, fictional=True)
        old = service.get_report(s, case_id, report_id)
        colreg_only = len(old['sections']) == 1 and old['sections'][0]['sectionId'] == 'analysis'
        return service.create_report(s, ctx, case, old['templateId'], old['lang'], parent=old, colreg_only=colreg_only)


@router.patch('/cases/{case_id}/reports/{report_id}/sections/{section_id}')
def review(case_id: str, report_id: str, section_id: str, body: dict[str, Any] = Body(...), ctx: Ctx = CtxDep) -> dict:
    with WRITE_LOCK, ctx.db.session() as s:
        check_access(s, ctx, case_id, write=True, fictional=True)
        report = service.get_report(s, case_id, report_id)
        return service.review_section(s, ctx, report, section_id, body)


@router.get('/cases/{case_id}/reports/{report_id}/audit')
def audit_list(case_id: str, report_id: str, ctx: Ctx = CtxDep) -> list:
    with ctx.db.session() as s:
        case = check_access(s, ctx, case_id)
        require(ctx, s, case_id, 'audit')
        if not service.is_fictional(case):
            return []
        service.get_report(s, case_id, report_id)
        return service.report_audit(s, case_id, report_id)


@router.get('/cases/{case_id}/reports/{report_id}/export')
def export_report(case_id: str, report_id: str, format: str = 'pdf', lang: str | None = None, ctx: Ctx = CtxDep):
    from .exporter import export_report as render
    with WRITE_LOCK, ctx.db.session() as s:
        check_access(s, ctx, case_id, fictional=True)
        report = service.get_report(s, case_id, report_id)
        lang = lang or report['lang']
        if format not in ('pdf', 'docx') or lang not in ('zh', 'en', 'bilingual'):
            raise problem(422, 'report_invalid_argument', '不支持的导出格式或语言')
        data = render(report, format=format, lang=lang)
        service.append_operation(s, ctx, case_id, action='report.export', report_id=report_id,
                                 before={'status': report['status']},
                                 after={'format': format, 'lang': lang, 'sha256': hashlib.sha256(data).hexdigest()})
    mime = 'application/pdf' if format == 'pdf' else 'application/vnd.openxmlformats-officedocument.wordprocessingml.document'
    return file_response(data, f'{report_id}-{lang}.{format}', mime)


def gisis_doc(s, case: dict) -> dict:
    from .gisis import build_gisis
    if not service.is_fictional(case):
        return {'caseId': case['caseId'], 'isFictionalDemo': False, 'realDataStatus': 'pending-confirmation',
                'fields': [], 'notice': '真实数据使用待 Mark 本人确认'}
    doc = build_gisis(case, cases.vessels(s, case['caseId']))
    contracts.validate('report#/$defs/gisis', doc)
    return doc


@router.get('/cases/{case_id}/gisis')
def get_gisis(case_id: str, ctx: Ctx = CtxDep) -> dict:
    with ctx.db.session() as s:
        return gisis_doc(s, check_access(s, ctx, case_id))


@router.post('/cases/{case_id}/gisis:validate')
def validate_gisis(case_id: str, body: dict[str, Any] | None = Body(None), ctx: Ctx = CtxDep):
    from .gisis import validate_gisis as validate, serialize_gisis
    args = body or {}
    failed = None
    with WRITE_LOCK, ctx.db.session() as s:
        case = check_access(s, ctx, case_id, fictional=True)
        if set(args) - {'values', 'export', 'format'} or not isinstance(args.get('values', {}), dict) or \
                not isinstance(args.get('export', False), bool) or args.get('format', 'json') not in ('json', 'csv'):
            raise problem(422, 'report_invalid_argument', 'GISIS 校验参数不合法')
        doc = gisis_doc(s, case)
        result = validate(doc, args.get('values', {}))
        service.append_operation(s, ctx, case_id, action='report.gisis.validate', before=doc,
                                 after={'values': args.get('values', {}), **result})
        if args.get('export'):
            if not result['valid']:
                # 校验失败也留痕：导出被拒单独记一条审计，先提交，再在事务外返回422。
                service.append_operation(s, ctx, case_id, action='report.gisis.export_rejected',
                                         after={'format': args.get('format', 'json'), 'validated': False,
                                                'errors': result.get('errors', [])})
                failed = result
            else:
                doc['fields'] = result['fields']
                data = serialize_gisis(doc, args.get('format', 'json'))
                service.append_operation(s, ctx, case_id, action='report.gisis.export',
                                         after={'format': args.get('format', 'json'), 'validated': True,
                                                'sha256': hashlib.sha256(data).hexdigest()})
    if failed is not None:
        raise problem(422, 'report_gisis_validation_failed', 'GISIS 字段校验未通过', failed)
    if args.get('export'):
        format = args.get('format', 'json')
        return file_response(data, f'gisis-{case_id}.{format}', 'application/json' if format == 'json' else 'text/csv')
    return result


@router.get('/cases/{case_id}/gisis/export')
def export_gisis(case_id: str, format: str = 'json', ctx: Ctx = CtxDep):
    from .gisis import serialize_gisis
    with WRITE_LOCK, ctx.db.session() as s:
        case = check_access(s, ctx, case_id, fictional=True)
        if format not in ('json', 'csv'):
            raise problem(422, 'report_invalid_argument', 'GISIS 格式须为 json 或 csv')
        data = serialize_gisis(gisis_doc(s, case), format)
        service.append_operation(s, ctx, case_id, action='report.gisis.export',
                                 after={'format': format, 'validated': False, 'sha256': hashlib.sha256(data).hexdigest()})
    return file_response(data, f'gisis-{case_id}.{format}', 'application/json' if format == 'json' else 'text/csv')
"""报告与完整操作快照独立存储，不写入任何上游分析表。"""
from ..db import Base, DocMixin, table_args


class ReportRow(DocMixin, Base):
    __tablename__ = 'investigation_reports'
    __table_args__ = table_args('investigation_reports')


class ReportAuditRow(DocMixin, Base):
    """只通过追加函数写入；auditSeq 指向现有不可改写的审计哈希链。"""
    __tablename__ = 'report_operation_snapshots'
    __table_args__ = table_args('report_operation_snapshots')
"""报告编排：每次生成另存一版，复核与审计在同一数据库事务提交。"""
from __future__ import annotations

from copy import deepcopy
from typing import Any
from uuid import uuid4

from sqlalchemy import select

from ..audit import service as audit
from ..audit.models import AuditEventRow
from ..cases import service as cases
from ..colreg.haili5_seed import CASE_ID as HAILI5_CASE_ID
from ..common import contracts
from ..common.context import problem
from ..common.timeutil import iso, now_utc
from ..db import get_doc, list_docs, put_doc
from .models import ReportAuditRow, ReportRow

YANGZE22_CASE_ID = 'CJK-2024-1230-YangZe22-VegaDream'  # 规范 caseId（DEFECTS/W12.md 21:52 裁定）；仍仅作真实案例入口，不读 reports/。
REAL_CASE_IDS = {HAILI5_CASE_ID, YANGZE22_CASE_ID}
DISCLAIMER_ZH = '不作责任认定'
DISCLAIMER_EN = 'This report does not apportion blame or liability'


def case_info(s, case_id: str) -> dict:
    if case_id == YANGZE22_CASE_ID:
        return {'caseId': case_id, 'title': 'YANGZE 22', 'isFictionalDemo': False}
    return cases.load_case(s, case_id)


def is_fictional(case: dict) -> bool:
    return case.get('isFictionalDemo') is True and case['caseId'] not in REAL_CASE_IDS


def data_status(case: dict) -> str:
    return 'fictional' if is_fictional(case) else 'pending-confirmation'


def require_fictional(case: dict) -> None:
    if not is_fictional(case):
        raise problem(409, 'report_real_data_pending', '真实数据使用待 Mark 本人确认')


def pending(case: dict) -> dict:
    return {'caseId': case['caseId'], 'isFictionalDemo': False, 'realDataStatus': 'pending-confirmation',
            'message': '真实数据使用待 Mark 本人确认', 'reports': []}


def get_report(s, case_id: str, report_id: str) -> dict:
    doc = get_doc(s, ReportRow, case_id, report_id)
    if doc is None:
        raise problem(404, 'report_not_found', f'报告不存在：{report_id}')
    return deepcopy(doc)


def template_for(template_id: str) -> dict:
    from .templates import TEMPLATES
    found = next((t for t in TEMPLATES if t['templateId'] == template_id), None)
    if found is None:
        raise problem(422, 'report_invalid_argument', '未知报告模板')
    return deepcopy(found)


def options(body: dict, *, optional: bool = False) -> tuple[str, str]:
    if set(body) - {'templateId', 'lang'}:
        raise problem(422, 'report_invalid_argument', '生成请求仅接受 templateId、lang')
    template_id = body.get('templateId', 'imo-cic' if optional else None)
    lang = body.get('lang', 'bilingual' if optional else None)
    template_for(template_id)
    if lang not in ('zh', 'en', 'bilingual'):
        raise problem(422, 'report_invalid_argument', 'lang 须为 zh、en 或 bilingual')
    return template_id, lang


def append_operation(s, ctx, case_id: str, *, action: str, report_id: str | None = None,
                     section_id: str | None = None, sentence_id: str | None = None,
                     before: Any = None, after: Any = None, reason: str = '') -> int:
    """审计摘要可截断；独立快照和哈希链 reason 均保留原文。"""
    snapshot_id = 'RA-' + uuid4().hex
    event = audit.append(s, case_id=case_id, operator=ctx.operator, role=ctx.role,
                         action=action, category='Report', command=f'{action} {report_id or case_id}',
                         before=str(before or ''), after=str(after or ''),
                         entity_type='report' if report_id else 'gisis', entity_id=report_id or case_id,
                         reason=reason)
    doc = {'reportId': report_id, 'sectionId': section_id, 'sentenceId': sentence_id,
           'reason': reason, 'beforeValue': deepcopy(before), 'afterValue': deepcopy(after),
           'summary': f'{action} · {section_id or report_id or case_id}'[:200], 'auditSeq': event.seq}
    put_doc(s, ReportAuditRow, case_id, snapshot_id, doc)
    return event.seq


def create_report(s, ctx, case: dict, template_id: str, lang: str, *, parent: dict | None = None,
                  colreg_only: bool = False) -> dict:
    from .sources import build_sections
    require_fictional(case)
    template = template_for(template_id)
    report_id = 'RPT-' + uuid4().hex[:20]
    family_id = parent['familyId'] if parent else report_id
    versions = [r['version'] for r in list_docs(s, ReportRow, case['caseId']) if r['familyId'] == family_id]
    sections = build_sections(s, case, template)
    if colreg_only:
        section = next(x for x in sections if x['sectionId'] == 'analysis')
        section['titleZh'], section['titleEn'] = '避碰规则分析', 'Collision avoidance rules analysis'
        section['dataSources'] = ['colreg-check', 'evidence']  # 只含核查项句子（及其证据引用）
        section['sentences'] = [x for x in section['sentences'] if any(c['kind'] == 'colreg-check' for c in x['citations'])]
        if not section['sentences']:
            from .sources import missing_sentence
            section['sentences'] = [missing_sentence('analysis-colreg-missing', 'COLREG 核查项未提供', 'COLREG checks not provided')]
        refresh_text(section)
        section['generatedText'] = {'textZh': section['textZh'], 'textEn': section['textEn']}
        sections = [section]
    from urllib.parse import urlencode
    report = {'reportId': report_id, 'familyId': family_id, 'parentReportId': parent['reportId'] if parent else None,
              'caseId': case['caseId'], 'templateId': template_id, 'lang': lang, 'version': max(versions or [0]) + 1,
              'status': 'Draft', 'isFictionalDemo': True, 'realDataStatus': 'fictional',
              'createdBy': ctx.operator, 'createdUtc': iso(now_utc()), 'sections': sections,
              'disclaimerZh': DISCLAIMER_ZH, 'disclaimerEn': DISCLAIMER_EN,
              'reportHref': '#/report?' + urlencode({'case': case['caseId'], 'report': report_id})}
    contracts.validate('report', report)
    put_doc(s, ReportRow, case['caseId'], report_id, report)
    append_operation(s, ctx, case['caseId'], action='report.regenerate' if parent else ('report.colreg.draft' if colreg_only else 'report.generate'),
                     report_id=report_id, before=parent, after=report)
    return report


def refresh_text(section: dict) -> None:
    for key in ('textZh', 'textEn'):
        section[key] = '\n'.join(x[key] for x in section['sentences'])
    section['missing'] = any(x['missing'] for x in section['sentences'])


def aggregate_status(items: list[dict]) -> str:
    states = [x['status'] for x in items]
    if states and all(x == 'Confirmed' for x in states):
        return 'Confirmed'
    if states and all(x == 'Dismissed' for x in states):
        return 'Dismissed'
    if states and all(x in ('Confirmed', 'Modified') for x in states):
        return 'Modified'
    return 'Draft'


def validate_review(body: dict, target: dict) -> tuple[str, str, dict]:
    action = body.get('action')
    if action not in ('confirm', 'dismiss', 'modify'):
        raise problem(422, 'report_invalid_argument', '未知复核 action')
    base_fields = {'action', 'reason', 'sentenceId'}
    if action in ('confirm', 'dismiss') and set(body) - base_fields:
        raise problem(422, 'report_review_field_not_allowed', '确认或驳回不得夹带新文本或新值字段')
    if action == 'modify' and set(body) - base_fields - {'textZh', 'textEn'}:
        raise problem(422, 'report_review_field_not_allowed', '复核包含不允许修改的字段')
    reason = body.get('reason')
    if reason is not None and not isinstance(reason, str):
        raise problem(422, 'report_invalid_argument', 'reason 须为字符串')
    if action in ('dismiss', 'modify') and not (reason or '').strip():
        raise problem(422, 'report_review_reason_required', '驳回或修改必须填写理由')
    changes = {k: body[k] for k in ('textZh', 'textEn') if k in body}
    if action == 'modify':
        if not changes or any(not isinstance(v, str) or not v.strip() for v in changes.values()):
            raise problem(422, 'report_review_text_required', '修改必须提供非空新文本')
        if all(v == target[k] for k, v in changes.items()):
            raise problem(422, 'report_review_no_change', '新文本与原值相同')
    if 'sentenceId' in body and (not isinstance(body['sentenceId'], str) or not body['sentenceId']):
        raise problem(422, 'report_invalid_argument', 'sentenceId 须为非空编号')
    return action, reason or '', changes


def review_section(s, ctx, report: dict, section_id: str, body: dict) -> dict:
    section = next((x for x in report['sections'] if x['sectionId'] == section_id), None)
    if section is None:
        raise problem(404, 'report_section_not_found', f'章节不存在：{section_id}')
    target = section
    sentence_id = body.get('sentenceId')
    if 'sentenceId' in body and (not isinstance(sentence_id, str) or not sentence_id):
        raise problem(422, 'report_invalid_argument', 'sentenceId 须为非空编号')
    if sentence_id is not None:
        target = next((x for x in section['sentences'] if x['sentenceId'] == sentence_id), None)
        if target is None:
            raise problem(404, 'report_sentence_not_found', f'句子不存在：{sentence_id}')
    action, reason, changes = validate_review(body, target)
    before = deepcopy(target)
    status = {'confirm': 'Confirmed', 'dismiss': 'Dismissed', 'modify': 'Modified'}[action]
    utc = iso(now_utc())
    if action == 'modify':
        target.update(changes)
        target['source'] = 'Investigator'
        if sentence_id is None:
            # 整节修改为调查员表述；生成原文保留在 generatedText 与完整审计快照。
            citations = []
            for sentence in section['sentences']:
                for citation in sentence['citations']:
                    if citation not in citations:
                        citations.append(deepcopy(citation))
            section['sentences'] = [{'sentenceId': section_id + '-investigator',
                                     'textZh': target['textZh'], 'textEn': target['textEn'],
                                     'generatedText': deepcopy(section['generatedText']),
                                     'source': 'Investigator', 'status': status, 'citations': citations,
                                     'missing': section['missing'], 'reviewedBy': ctx.operator, 'reviewedAt': utc,
                                     'reviews': [], 'sourceStatus': 'Investigator'}]
    target.update({'status': status, 'reviewedBy': ctx.operator, 'reviewedAt': utc})
    if sentence_id is None:
        for sentence in section['sentences']:
            sentence.update({'status': status, 'reviewedBy': ctx.operator, 'reviewedAt': utc})
    else:
        refresh_text(section)
        section['status'] = aggregate_status(section['sentences'])
        if action == 'modify':
            section['source'] = 'Investigator'
    report['status'] = aggregate_status(report['sections'])
    # 记录快照不含自身 history，避免递归增长，正文与原生成文本均完整保留。
    before_value = {k: deepcopy(v) for k, v in before.items() if k != 'reviews'}
    after_value = {k: deepcopy(v) for k, v in target.items() if k != 'reviews'}
    seq = append_operation(s, ctx, report['caseId'], action='report.review.' + action,
                           report_id=report['reportId'], section_id=section_id, sentence_id=sentence_id,
                           before=before_value, after=after_value, reason=reason)
    target['reviews'].append({'action': action, 'operator': ctx.operator, 'utc': utc, 'reason': reason,
                              'beforeValue': before_value, 'afterValue': after_value, 'auditSeq': seq})
    contracts.validate('report', report)
    put_doc(s, ReportRow, report['caseId'], report['reportId'], report)
    return section


def report_audit(s, case_id: str, report_id: str) -> list[dict]:
    entries = [d for d in list_docs(s, ReportAuditRow, case_id) if d['reportId'] == report_id]
    entries.sort(key=lambda d: d['auditSeq'])
    out = []
    for entry in entries:
        row = s.scalars(select(AuditEventRow).where(AuditEventRow.case_id == case_id, AuditEventRow.seq == entry['auditSeq'])).first()
        out.append({**{k: v for k, v in entry.items() if k != 'auditSeq'}, 'auditEvent': audit.to_doc(row)})
    return out
"""审计：所有写操作都调用 append()。行格式兼容 C# AuditRecord.ToJsonLine（7 个标准键）+ snake_case 扩展键。"""
from __future__ import annotations

from datetime import datetime
from typing import Any

from sqlalchemy import func, select
from sqlalchemy.orm import Session

from ..common.csjson import ZERO_HASH, flat_line, sha256_utf8
from ..common.timeutil import iso, now_utc, parse_iso
from ..db import WRITE_LOCK
from .models import AuditEventRow


def _summ(v: Any, limit: int = 400) -> str:
    if v is None:
        return ""
    s = v if isinstance(v, str) else str(v)
    return s if len(s) <= limit else s[: limit - 1] + "…"


def build_line(*, utc: str, operator: str, action: str, category: str, command: str, before: str, after: str,
               seq: int, role: str, entity_type: str, entity_id: str, prev: str, reason: str | None = None) -> str:
    pairs: list[tuple[str, object]] = [
        ("utc", utc), ("operator", operator), ("action", action), ("category", category),
        ("command", command), ("before", before), ("after", after),
        ("seq", seq), ("role", role), ("entity_type", entity_type), ("entity_id", entity_id), ("prev", prev),
    ]
    if reason is not None:
        # 扩展键：理由全文（不截断），进入哈希链；C# AuditLog.ReadAll 忽略扩展键
        pairs.append(("reason", reason))
    return flat_line(pairs)


def append(s: Session, *, case_id: str, operator: str, role: str, action: str, category: str, command: str,
           before: Any = "", after: Any = "", entity_type: str = "", entity_id: str = "",
           utc: datetime | str | None = None, reason: str | None = None) -> AuditEventRow:
    with WRITE_LOCK:
        last = s.scalars(select(AuditEventRow).where(AuditEventRow.case_id == case_id)
                         .order_by(AuditEventRow.seq.desc()).limit(1)).first()
        seq = (last.seq + 1) if last else 1
        prev = sha256_utf8(last.line) if last else ZERO_HASH
        if utc is None:
            utc_s = iso(now_utc())
        elif isinstance(utc, str):
            utc_s = iso(parse_iso(utc))
        else:
            utc_s = iso(utc)
        b, a = _summ(before), _summ(after)
        line = build_line(utc=utc_s, operator=operator, action=action, category=category, command=command,
                          before=b, after=a, seq=seq, role=role, entity_type=entity_type, entity_id=entity_id, prev=prev,
                          reason=reason)
        row = AuditEventRow(case_id=case_id, seq=seq, utc=utc_s, operator=operator, role=role, action=action,
                            category=category, command=command, before=b, after=a, entity_type=entity_type,
                            entity_id=entity_id, prev_hash=prev, line=line)
        s.add(row)
        s.flush()
        return row


def append_raw_line(s: Session, case_id: str, rec: dict[str, Any], line: str, seq: int, prev: str) -> None:
    """导入 .mcase 时按原文保留审计行。"""
    s.add(AuditEventRow(case_id=case_id, seq=seq, utc=rec.get("utc", ""), operator=rec.get("operator", ""),
                        role=rec.get("role", ""), action=rec.get("action", ""), category=rec.get("category", ""),
                        command=rec.get("command", ""), before=rec.get("before", ""), after=rec.get("after", ""),
                        entity_type=rec.get("entity_type", ""), entity_id=rec.get("entity_id", ""),
                        prev_hash=prev, line=line))
    s.flush()


def to_doc(r: AuditEventRow) -> dict[str, Any]:
    return {"seq": r.seq, "caseId": r.case_id, "utc": r.utc, "operator": r.operator, "role": r.role or "Investigator",
            "action": r.action, "category": r.category, "command": r.command, "before": r.before, "after": r.after,
            "entityType": r.entity_type, "entityId": r.entity_id, "prevHash": r.prev_hash, "line": r.line}


def list_events(s: Session, case_id: str, *, category: str | None = None, entity_id: str | None = None,
                action: str | None = None, entity_type: str | None = None, after_seq: int = 0, limit: int = 200, newest_first: bool = False) -> list[dict[str, Any]]:
    q = select(AuditEventRow).where(AuditEventRow.case_id == case_id, AuditEventRow.seq > after_seq)
    if category:
        q = q.where(AuditEventRow.category == category)
    if entity_id:
        q = q.where(AuditEventRow.entity_id == entity_id)
    if action:
        q = q.where(AuditEventRow.action == action)
    if entity_type:
        q = q.where(AuditEventRow.entity_type == entity_type)
    q = q.order_by(AuditEventRow.seq.desc() if newest_first else AuditEventRow.seq).limit(limit)
    return [to_doc(r) for r in s.scalars(q)]


def all_lines(s: Session, case_id: str) -> list[str]:
    return [r.line for r in s.scalars(select(AuditEventRow).where(AuditEventRow.case_id == case_id).order_by(AuditEventRow.seq))]


def verify_chain(lines: list[str]) -> dict[str, Any]:
    """校验 prev 链（适用于 audit.jsonl 与 custody.jsonl）。"""
    import json

    prev = ZERO_HASH
    for i, line in enumerate(lines):
        try:
            rec = json.loads(line)
        except ValueError:
            return {"valid": False, "count": len(lines), "brokenAt": i + 1, "reason": "bad json"}
        if rec.get("prev", prev) != prev:
            return {"valid": False, "count": len(lines), "brokenAt": i + 1, "reason": "prev hash mismatch"}
        if "seq" in rec and int(rec["seq"]) != i + 1:
            return {"valid": False, "count": len(lines), "brokenAt": i + 1, "reason": "seq gap"}
        prev = sha256_utf8(line)
    return {"valid": True, "count": len(lines), "brokenAt": None, "reason": "", "headHash": prev}


def count(s: Session, case_id: str) -> int:
    return s.scalar(select(func.count()).select_from(AuditEventRow).where(AuditEventRow.case_id == case_id)) or 0

