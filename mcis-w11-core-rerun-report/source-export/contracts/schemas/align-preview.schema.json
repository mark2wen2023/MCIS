{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mcis.local/contracts/v1/align-preview.schema.json",
  "title": "W4.1 inline-only transient alignment preview",
  "$defs": {
    "request": {
      "type": "object",
      "properties": {
        "sources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "object",
            "properties": {
              "sourceId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "\\S"
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 262144,
                "pattern": "\\S",
                "description": "Max262144 UTF8 bytes, not only characters; CSV times explicitly UTC, missing offset interpreted UTC."
              },
              "csvMapping": {
                "type": "object",
                "properties": {
                  "timeColumn": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "\\S"
                  },
                  "columns": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 16,
                    "items": {
                      "type": "object",
                      "properties": {
                        "column": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 128,
                          "pattern": "\\S"
                        },
                        "kind": {
                          "enum": [
                            "Heading",
                            "CourseOverGround",
                            "SpeedOverGround"
                          ]
                        }
                      },
                      "required": [
                        "column",
                        "kind"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "timeColumn",
                  "columns"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "sourceId",
              "text",
              "csvMapping"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "sources"
      ],
      "additionalProperties": false,
      "description": "Unique sourceId; total text <=1048576 UTF8 bytes. CSV only; comma, timezone0, scale1, offset0, calibrate=true. No file paths or server file lookup."
    },
    "response": {
      "type": "object",
      "properties": {
        "previewOnly": {
          "const": true
        },
        "persisted": {
          "const": false
        },
        "caseId": {
          "$ref": "common.schema.json#/$defs/caseId"
        },
        "caseEpochUtc": {
          "$ref": "common.schema.json#/$defs/utc"
        },
        "result": {
          "type": "object",
          "properties": {
            "caseId": {
              "type": "string"
            },
            "caseEpochUtc": {
              "type": "string",
              "format": "date-time"
            },
            "referenceSourceId": {
              "type": "string"
            },
            "conflicts": {
              "type": "array",
              "items": {
                "$ref": "conflict.schema.json"
              }
            },
            "clockOffsets": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "sourceId": {
                    "type": "string"
                  },
                  "referenceSourceId": {
                    "type": "string"
                  },
                  "offsetSeconds": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "uncertaintySeconds": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "anchorCount": {
                    "type": "integer"
                  },
                  "usedAnchorCount": {
                    "type": "integer"
                  },
                  "manualAnchorCount": {
                    "type": "integer"
                  },
                  "method": {
                    "type": "string"
                  },
                  "isReference": {
                    "type": "boolean"
                  },
                  "status": {
                    "type": "string"
                  },
                  "viaSourceId": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "rejectedAnchors": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "eventKey": {
                          "type": "string"
                        },
                        "differenceSeconds": {
                          "type": [
                            "number",
                            "null"
                          ]
                        },
                        "residualSeconds": {
                          "type": [
                            "number",
                            "null"
                          ]
                        },
                        "excludedFromFit": {
                          "type": "boolean"
                        },
                        "reason": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "eventKey",
                        "differenceSeconds",
                        "residualSeconds",
                        "excludedFromFit",
                        "reason"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "sourceId",
                  "referenceSourceId",
                  "offsetSeconds",
                  "uncertaintySeconds",
                  "anchorCount",
                  "usedAnchorCount",
                  "manualAnchorCount",
                  "method",
                  "isReference",
                  "status",
                  "viaSourceId",
                  "rejectedAnchors"
                ],
                "additionalProperties": false
              }
            },
            "calibration": {
              "type": "object",
              "properties": {
                "allCalibrated": {
                  "type": "boolean"
                },
                "uncalibratedSources": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "sources": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "sourceId": {
                        "type": "string"
                      },
                      "status": {
                        "type": "string"
                      },
                      "offsetSeconds": {
                        "type": [
                          "number",
                          "null"
                        ]
                      },
                      "uncertaintySeconds": {
                        "type": [
                          "number",
                          "null"
                        ]
                      },
                      "anchorCount": {
                        "type": "integer"
                      },
                      "manualAnchorCount": {
                        "type": "integer"
                      },
                      "viaSourceId": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "description": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "sourceId",
                      "status",
                      "offsetSeconds",
                      "uncertaintySeconds",
                      "anchorCount",
                      "manualAnchorCount",
                      "viaSourceId",
                      "description"
                    ],
                    "additionalProperties": false
                  }
                },
                "error": {
                  "type": "string"
                }
              },
              "required": [
                "allCalibrated",
                "uncalibratedSources",
                "sources"
              ],
              "additionalProperties": false
            },
            "importDiagnostics": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "sourceId": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "severity": {
                    "type": "string"
                  },
                  "lineNumber": {
                    "type": "integer"
                  },
                  "code": {
                    "type": "string"
                  },
                  "message": {
                    "type": "string"
                  }
                },
                "required": [
                  "sourceId",
                  "severity",
                  "lineNumber",
                  "code",
                  "message"
                ],
                "additionalProperties": false
              }
            },
            "conflictDiagnostics": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "code": {
                    "type": "string"
                  },
                  "trackKind": {
                    "type": "string"
                  },
                  "sourceId": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "trackId": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "message": {
                    "type": "string"
                  },
                  "reason": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "range": {
                    "type": "object",
                    "required": [
                      "startSec",
                      "endSec"
                    ],
                    "properties": {
                      "startSec": {
                        "type": "number"
                      },
                      "endSec": {
                        "type": "number"
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "required": [
                  "code",
                  "trackKind",
                  "sourceId",
                  "trackId",
                  "message",
                  "reason"
                ],
                "additionalProperties": false
              }
            },
            "stats": {
              "type": "object",
              "properties": {
                "sourcesImported": {
                  "type": "integer"
                },
                "tracks": {
                  "type": "integer"
                },
                "linesRead": {
                  "type": "integer"
                },
                "sentencesUsed": {
                  "type": "integer"
                },
                "anchorCount": {
                  "type": "integer"
                },
                "manualAnchorCount": {
                  "type": "integer"
                }
              },
              "required": [
                "sourcesImported",
                "tracks",
                "linesRead",
                "sentencesUsed",
                "anchorCount",
                "manualAnchorCount"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "caseId",
            "conflicts",
            "clockOffsets",
            "calibration",
            "importDiagnostics",
            "conflictDiagnostics",
            "stats"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "previewOnly",
        "persisted",
        "caseId",
        "caseEpochUtc",
        "result"
      ],
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "properties": {
        "caseId": {
          "type": "string"
        },
        "caseEpochUtc": {
          "type": "string",
          "format": "date-time"
        },
        "referenceSourceId": {
          "type": "string"
        },
        "conflicts": {
          "type": "array",
          "items": {
            "$ref": "conflict.schema.json"
          }
        },
        "clockOffsets": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "sourceId": {
                "type": "string"
              },
              "referenceSourceId": {
                "type": "string"
              },
              "offsetSeconds": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "uncertaintySeconds": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "anchorCount": {
                "type": "integer"
              },
              "usedAnchorCount": {
                "type": "integer"
              },
              "manualAnchorCount": {
                "type": "integer"
              },
              "method": {
                "type": "string"
              },
              "isReference": {
                "type": "boolean"
              },
              "status": {
                "type": "string"
              },
              "viaSourceId": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "rejectedAnchors": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "eventKey": {
                      "type": "string"
                    },
                    "differenceSeconds": {
                      "type": [
                        "number",
                        "null"
                      ]
                    },
                    "residualSeconds": {
                      "type": [
                        "number",
                        "null"
                      ]
                    },
                    "excludedFromFit": {
                      "type": "boolean"
                    },
                    "reason": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "eventKey",
                    "differenceSeconds",
                    "residualSeconds",
                    "excludedFromFit",
                    "reason"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "sourceId",
              "referenceSourceId",
              "offsetSeconds",
              "uncertaintySeconds",
              "anchorCount",
              "usedAnchorCount",
              "manualAnchorCount",
              "method",
              "isReference",
              "status",
              "viaSourceId",
              "rejectedAnchors"
            ],
            "additionalProperties": false
          }
        },
        "calibration": {
          "type": "object",
          "properties": {
            "allCalibrated": {
              "type": "boolean"
            },
            "uncalibratedSources": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "sources": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "sourceId": {
                    "type": "string"
                  },
                  "status": {
                    "type": "string"
                  },
                  "offsetSeconds": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "uncertaintySeconds": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "anchorCount": {
                    "type": "integer"
                  },
                  "manualAnchorCount": {
                    "type": "integer"
                  },
                  "viaSourceId": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "description": {
                    "type": "string"
                  }
                },
                "required": [
                  "sourceId",
                  "status",
                  "offsetSeconds",
                  "uncertaintySeconds",
                  "anchorCount",
                  "manualAnchorCount",
                  "viaSourceId",
                  "description"
                ],
                "additionalProperties": false
              }
            },
            "error": {
              "type": "string"
            }
          },
          "required": [
            "allCalibrated",
            "uncalibratedSources",
            "sources"
          ],
          "additionalProperties": false
        },
        "importDiagnostics": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "sourceId": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "severity": {
                "type": "string"
              },
              "lineNumber": {
                "type": "integer"
              },
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "sourceId",
              "severity",
              "lineNumber",
              "code",
              "message"
            ],
            "additionalProperties": false
          }
        },
        "conflictDiagnostics": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "trackKind": {
                "type": "string"
              },
              "sourceId": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "trackId": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "message": {
                "type": "string"
              },
              "reason": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "range": {
                "type": "object",
                "required": [
                  "startSec",
                  "endSec"
                ],
                "properties": {
                  "startSec": {
                    "type": "number"
                  },
                  "endSec": {
                    "type": "number"
                  }
                },
                "additionalProperties": false
              }
            },
            "required": [
              "code",
              "trackKind",
              "sourceId",
              "trackId",
              "message",
              "reason"
            ],
            "additionalProperties": false
          }
        },
        "stats": {
          "type": "object",
          "properties": {
            "sourcesImported": {
              "type": "integer"
            },
            "tracks": {
              "type": "integer"
            },
            "linesRead": {
              "type": "integer"
            },
            "sentencesUsed": {
              "type": "integer"
            },
            "anchorCount": {
              "type": "integer"
            },
            "manualAnchorCount": {
              "type": "integer"
            }
          },
          "required": [
            "sourcesImported",
            "tracks",
            "linesRead",
            "sentencesUsed",
            "anchorCount",
            "manualAnchorCount"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "caseId",
        "conflicts",
        "clockOffsets",
        "calibration",
        "importDiagnostics",
        "conflictDiagnostics",
        "stats"
      ],
      "additionalProperties": false
    }
  }
}
