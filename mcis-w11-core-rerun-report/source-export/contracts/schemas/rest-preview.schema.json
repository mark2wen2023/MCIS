{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mcis.local/contracts/v1/rest-preview.schema.json",
  "title": "W18.3 非持久化工休技术预览",
  "$defs": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recordStartUtc",
        "recordEndUtc",
        "intervals",
        "sourceEvidenceIds"
      ],
      "properties": {
        "recordStartUtc": {
          "type": "string",
          "pattern": "^(19[0-9]{2}|20[0-9]{2}|2100)-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
          "format": "date-time"
        },
        "recordEndUtc": {
          "type": "string",
          "pattern": "^(19[0-9]{2}|20[0-9]{2}|2100)-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
          "format": "date-time"
        },
        "intervals": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "startUtc",
              "endUtc",
              "kind"
            ],
            "properties": {
              "startUtc": {
                "type": "string",
                "pattern": "^(19[0-9]{2}|20[0-9]{2}|2100)-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
                "format": "date-time"
              },
              "endUtc": {
                "type": "string",
                "pattern": "^(19[0-9]{2}|20[0-9]{2}|2100)-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
                "format": "date-time"
              },
              "kind": {
                "enum": [
                  "Watch",
                  "OtherWork",
                  "Rest"
                ]
              }
            }
          }
        },
        "sourceEvidenceIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "sources": {
      "type": "object",
      "required": [
        "profile",
        "caseId",
        "sources",
        "sourceBinding"
      ],
      "properties": {
        "profile": {
          "const": "MCIS-REST-PREVIEW-1"
        },
        "caseId": {
          "type": "string"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "evidenceId",
              "title",
              "sha256"
            ],
            "properties": {
              "evidenceId": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        },
        "sourceBinding": {
          "const": "registered-metadata-only"
        },
        "identityMode": {
          "const": "local-role-header"
        }
      }
    },
    "preview": {
      "type": "object",
      "required": [
        "profile",
        "caseId",
        "inputSha256",
        "sources",
        "sourceBinding",
        "persisted",
        "assessment",
        "result",
        "limitations"
      ],
      "properties": {
        "profile": {
          "const": "MCIS-REST-PREVIEW-1"
        },
        "caseId": {
          "type": "string"
        },
        "inputSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "required": [
              "evidenceId",
              "title",
              "sha256"
            ],
            "properties": {
              "evidenceId": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        },
        "sourceBinding": {
          "const": "registered-metadata-only"
        },
        "persisted": {
          "const": false
        },
        "assessment": {
          "const": "technical-preview-only"
        },
        "result": {
          "$ref": "#/$defs/result"
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sourceRole": {
          "enum": [
            "Investigator",
            "LeadInvestigator"
          ]
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "coreVersion",
        "mode",
        "totals",
        "coverage",
        "findings",
        "insufficientData",
        "assumptions"
      ],
      "properties": {
        "coreVersion": {
          "const": "mcis-rest/1"
        },
        "mode": {
          "const": "rest-baseline-no-exceptions"
        },
        "totals": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "restHours",
            "workHours",
            "unknownHours"
          ],
          "properties": {
            "restHours": {
              "type": "number",
              "minimum": 0,
              "maximum": 336
            },
            "workHours": {
              "type": "number",
              "minimum": 0,
              "maximum": 336
            },
            "unknownHours": {
              "type": "number",
              "minimum": 0,
              "maximum": 336
            }
          }
        },
        "coverage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "recordHours",
            "has24hWindow",
            "has7dWindow",
            "unknownHours"
          ],
          "properties": {
            "recordHours": {
              "type": "number",
              "minimum": 0,
              "maximum": 336
            },
            "has24hWindow": {
              "type": "boolean"
            },
            "has7dWindow": {
              "type": "boolean"
            },
            "unknownHours": {
              "type": "number",
              "minimum": 0,
              "maximum": 336
            }
          }
        },
        "findings": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "rule",
              "windowStartUtc",
              "windowEndUtc",
              "actualHours",
              "limitHours",
              "violatingFromUtc",
              "violatingToUtc",
              "clause",
              "detail"
            ],
            "properties": {
              "rule": {
                "enum": [
                  "Rest24h",
                  "Rest7d",
                  "RestSplit",
                  "LongestRest",
                  "RestInterval"
                ]
              },
              "windowStartUtc": {
                "type": "string",
                "format": "date-time"
              },
              "windowEndUtc": {
                "type": "string",
                "format": "date-time"
              },
              "actualHours": {
                "type": "number",
                "minimum": 0,
                "maximum": 336
              },
              "limitHours": {
                "type": "number",
                "minimum": 0,
                "maximum": 336
              },
              "violatingFromUtc": {
                "type": "string",
                "format": "date-time"
              },
              "violatingToUtc": {
                "type": "string",
                "format": "date-time"
              },
              "clause": {
                "type": "string",
                "minLength": 1
              },
              "detail": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "insufficientData": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "rule",
              "windowStartUtc",
              "windowEndUtc",
              "actualHours",
              "limitHours",
              "violatingFromUtc",
              "violatingToUtc",
              "clause",
              "detail"
            ],
            "properties": {
              "rule": {
                "enum": [
                  "Rest24h",
                  "Rest7d",
                  "RestSplit",
                  "LongestRest",
                  "RestInterval"
                ]
              },
              "windowStartUtc": {
                "type": "string",
                "format": "date-time"
              },
              "windowEndUtc": {
                "type": "string",
                "format": "date-time"
              },
              "actualHours": {
                "type": "number",
                "minimum": 0,
                "maximum": 336
              },
              "limitHours": {
                "type": "number",
                "minimum": 0,
                "maximum": 336
              },
              "violatingFromUtc": {
                "type": "string",
                "format": "date-time"
              },
              "violatingToUtc": {
                "type": "string",
                "format": "date-time"
              },
              "clause": {
                "type": "string",
                "minLength": 1
              },
              "detail": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "assumptions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
