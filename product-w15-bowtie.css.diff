commit 912d96a39f1a68e98008a7317a211f5e29ed3845
Author: mark2wen2023 <mark2wen2023@users.noreply.github.com>
Date:   Thu Nov 26 16:50:55 2026 +0800

    fix(w15): contain the systemic page at 390 without hiding chrome
    
    A 390 viewport was still 873px wide because the 224px sidebar sat beside
    a 1fr column whose automatic minimum followed the nowrap topbar. Scope
    the change to the W15 page: minmax(0, 1fr), wrap the topbar, stack the
    sidebar, and keep diagram panning in its own scroller. Navigation, case
    id and role stay visible and focusable. Not a merge to main.

diff --git a/web/src/styles/w15-bowtie.css b/web/src/styles/w15-bowtie.css
index c76fa8d..b72261b 100644
--- a/web/src/styles/w15-bowtie.css
+++ b/web/src/styles/w15-bowtie.css
@@ -1,2 +1,23 @@
 .w153-page{padding:24px;color:#e2edf4}.w153-heading{display:flex;gap:20px;justify-content:space-between;align-items:center}.w153-page p{line-height:1.7}.w153-page a{color:#8ce4ef}.w153-warning{padding:18px;border:1px solid #a57d43;background:#342b1d;color:#ffe5b5;border-radius:9px;margin-bottom:20px}.w153-form{display:grid;gap:18px;margin-top:24px}.w153-form label{display:block}.w153-form textarea{display:block;width:100%;min-height:65px;box-sizing:border-box}.w153-page input:not([type=checkbox]),.w153-page select,.w153-page textarea{display:block;background:#102b37;color:#e1f4fa;padding:9px;border:1px solid #4b7180;border-radius:5px;margin-top:6px}.w153-page button{background:#183e4c;color:#e6faff;padding:9px 14px;border:1px solid #4c8f9e;border-radius:5px;cursor:pointer;width:fit-content}.w153-page button:disabled{opacity:.5}.w153-page :focus-visible{outline:2px solid #8de7f1;outline-offset:3px}.w153-page fieldset{border:1px solid #3c6275;padding:16px;border-radius:8px;min-width:0}.w153-row{display:flex;flex-wrap:wrap;gap:14px;align-items:end;margin:12px 0}.w153-diagram{overflow-x:auto}.w153-diagram svg{min-width:1100px;width:100%}.w153-source{margin:10px 0}.w153-source code{display:block}.w153-page code{overflow-wrap:anywhere}.w153-result{border-top:2px solid #509aa8;padding-top:20px}.w153-result article{border:1px solid #5d6871;padding:12px;margin:12px 0}.w153-page [role=alert]{color:#ffd19b}
 .w153-page input:not([type=checkbox]){width:28ch;max-width:100%;box-sizing:border-box}.w153-page fieldset>label{margin:10px 0}.w153-page fieldset>label input{width:min(60ch,100%)}
+
+/* Narrow W15 shell: shrink the 1fr column, wrap the topbar, stack the 224px
+ * sidebar. Navigation, case id and role remain visible and keyboard-usable.
+ * The diagram may pan inside .w153-diagram only. No page-level overflow:hidden.
+ */
+.app:has(.w153-page){grid-template-columns:var(--sidebar-w) minmax(0,1fr)}
+.app:has(.w153-page) .topbar{min-width:0}
+.w153-diagram{min-width:0;max-width:100%;overflow:auto}
+@media(max-width:1100px){
+  .app:has(.w153-page){grid-template-rows:auto minmax(0,1fr)}
+  .app:has(.w153-page) .topbar{flex-wrap:wrap;min-width:0;height:auto;padding:10px 12px}
+  .app:has(.w153-page) .topbar-left,.app:has(.w153-page) .topbar-right{min-width:0;max-width:100%;flex-wrap:wrap}
+  .app:has(.w153-page) .case-chip{white-space:normal;overflow-wrap:anywhere}
+  .app:has(.w153-page) .role-select{max-width:100%}
+}
+@media(max-width:600px){
+  .app:has(.w153-page){grid-template-columns:minmax(0,1fr);grid-template-rows:auto auto minmax(0,1fr);height:auto;min-height:100vh}
+  .app:has(.w153-page) .sidebar{grid-row:auto;max-height:220px;overflow-y:auto}
+  .app:has(.w153-page) .main{padding:10px}
+  .app:has(.w153-page) .role-select{max-width:100%}
+}
