{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mcis.local/contracts/v1/working-record-archive.schema.json",
  "title": "Bounded working record archive; runtime validates all cross-references and histories",
  "type": "object",
  "properties": {
    "format": {
      "const": "MCIS-WORKING-RECORDS"
    },
    "version": {
      "type": "integer",
      "const": 1
    },
    "caseId": {
      "type": "string"
    },
    "receiptPolicy": {
      "const": "archive-only-on-import"
    },
    "interviews": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "createdUtc": {
            "type": "string"
          },
          "updatedUtc": {
            "type": "string"
          },
          "doc": {
            "$ref": "interview.schema.json"
          }
        },
        "required": [
          "key",
          "createdUtc",
          "updatedUtc",
          "doc"
        ],
        "additionalProperties": false
      },
      "maxItems": 128
    },
    "reports": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "createdUtc": {
            "type": "string"
          },
          "updatedUtc": {
            "type": "string"
          },
          "doc": {
            "$ref": "report.schema.json"
          }
        },
        "required": [
          "key",
          "createdUtc",
          "updatedUtc",
          "doc"
        ],
        "additionalProperties": false
      },
      "maxItems": 256
    },
    "reportSnapshots": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "createdUtc": {
            "type": "string"
          },
          "updatedUtc": {
            "type": "string"
          },
          "doc": {
            "type": "object",
            "properties": {
              "reportId": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "sectionId": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "sentenceId": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "reason": {
                "type": "string"
              },
              "beforeValue": {},
              "afterValue": {},
              "summary": {
                "type": "string",
                "maxLength": 200
              },
              "auditSeq": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "reportId",
              "sectionId",
              "sentenceId",
              "reason",
              "beforeValue",
              "afterValue",
              "summary",
              "auditSeq"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "key",
          "createdUtc",
          "updatedUtc",
          "doc"
        ],
        "additionalProperties": false
      },
      "maxItems": 1024
    },
    "manualReceipts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "case_id": {
            "type": "string"
          },
          "request_id": {
            "type": "string",
            "format": "uuid"
          },
          "operation": {
            "enum": [
              "create",
              "append-turn"
            ]
          },
          "record_id": {
            "type": "string",
            "pattern": "^IR-[0-9]{2,}$"
          },
          "request_digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "operator": {
            "type": "string"
          },
          "role": {
            "enum": [
              "Investigator",
              "LeadInvestigator"
            ]
          },
          "receipt": {
            "type": "object",
            "properties": {
              "requestId": {
                "type": "string"
              },
              "operation": {
                "enum": [
                  "create",
                  "append-turn"
                ]
              },
              "recordId": {
                "type": "string"
              },
              "beforeDigest": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "afterDigest": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "turnRound": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1,
                "maximum": 256
              },
              "appliedUtc": {
                "type": "string"
              }
            },
            "required": [
              "requestId",
              "operation",
              "recordId",
              "beforeDigest",
              "afterDigest",
              "turnRound",
              "appliedUtc"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "case_id",
          "request_id",
          "operation",
          "record_id",
          "request_digest",
          "operator",
          "role",
          "receipt"
        ],
        "additionalProperties": false
      },
      "maxItems": 2048
    },
    "importHistory": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "enum": [
              "package-intake",
              "evidence-intake"
            ]
          },
          "caseId": {
            "type": "string"
          },
          "key": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "createdUtc": {
            "type": [
              "string",
              "null"
            ]
          },
          "updatedUtc": {
            "type": [
              "string",
              "null"
            ]
          },
          "metadata": {
            "type": "object"
          },
          "sourceArtifactSha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "kind",
          "caseId",
          "key",
          "createdUtc",
          "updatedUtc",
          "metadata",
          "sourceArtifactSha256"
        ],
        "additionalProperties": false
      },
      "maxItems": 2048
    },
    "historicalArtifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "sizeBytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 16777216
          },
          "relativePath": {
            "type": "string",
            "pattern": "^history/artifacts/[a-f0-9]{64}\\.bin$"
          },
          "mediaType": {
            "const": "application/octet-stream"
          }
        },
        "required": [
          "sha256",
          "sizeBytes",
          "relativePath",
          "mediaType"
        ],
        "additionalProperties": false
      },
      "maxItems": 32
    },
    "lineage": {
      "type": "object",
      "properties": {
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "artifactSha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "parentArtifactSha256s": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "maxItems": 32,
                "uniqueItems": true
              }
            },
            "required": [
              "artifactSha256",
              "parentArtifactSha256s"
            ],
            "additionalProperties": false
          },
          "maxItems": 32
        }
      },
      "required": [
        "nodes"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "format",
    "version",
    "caseId",
    "receiptPolicy",
    "interviews",
    "reports",
    "reportSnapshots",
    "manualReceipts",
    "importHistory",
    "historicalArtifacts",
    "lineage"
  ],
  "additionalProperties": false
}
