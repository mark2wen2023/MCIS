{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mcis.local/contracts/v1/case.schema.json",
  "title": "Case（案件元数据）",
  "description": "与 C# Mcis.Domain.Models.CaseMetadata 及 .mcase/case.json（CaseJson.ToJson）逐字段对齐。",
  "type": "object",
  "required": ["caseId", "schemaVersion", "title", "accidentType", "incidentTimeUtc", "caseEpochUtc", "displayTimeZoneOffsetMinutes", "incidentLocation", "isFictionalDemo"],
  "properties": {
    "caseId": { "$ref": "common.schema.json#/$defs/caseId" },
    "schemaVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "title": { "type": "string", "minLength": 1 },
    "accidentCode": { "type": "string" },
    "accidentType": { "type": "string", "description": "Collision / Grounding / Contact / Foundering / Capsizing / FireOrExplosion …（ARCHITECTURE §11.2）" },
    "accidentGrade": { "type": "string", "description": "如 VerySerious / Serious / LessSerious（MSC.255(84) 第 2 章）" },
    "incidentTimeUtc": { "$ref": "common.schema.json#/$defs/utc" },
    "caseEpochUtc": { "$ref": "common.schema.json#/$defs/utc", "description": "SimTime = 0 对应的 UTC 时刻" },
    "displayTimeZoneOffsetMinutes": { "type": "integer", "description": "界面显示时区，北京时间为 480" },
    "incidentLocation": { "$ref": "common.schema.json#/$defs/geoCoord" },
    "seaLevelOffsetM": { "type": "number", "default": 0 },
    "leadInvestigator": { "type": "string" },
    "agencyName": { "type": "string" },
    "isFictionalDemo": { "type": "boolean", "description": "虚构演示数据，界面与报告强制水印" },
    "summaryNotes": { "type": "string" },
    "durationSec": { "type": "number", "description": "（服务扩展）仿真总时长，秒" },
    "placeName": { "type": "string", "description": "（服务扩展）水域名称，如 星屿港（虚构）" }
  },
  "additionalProperties": false
}
