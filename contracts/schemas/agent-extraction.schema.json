{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mcis.local/contracts/v1/agent-extraction.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["recordId", "sourceDigest", "statements"],
  "properties": {
    "recordId": {"type": "string", "pattern": "^IR-[0-9]{2,}$"},
    "sourceDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "statements": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"$ref": "#/$defs/item"}}
  },
  "$defs": {
    "item": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "subject", "summary", "claim", "round", "field", "quote"],
      "properties": {
        "kind": {"enum": ["Time", "Position", "Operation", "Observation"]},
        "subject": {"type": "string", "minLength": 1, "maxLength": 200},
        "summary": {"type": "string", "minLength": 1, "maxLength": 2000},
        "claim": {"$ref": "interview.schema.json#/$defs/claim"},
        "round": {"type": "integer", "minimum": 1},
        "field": {"enum": ["Question", "Answer"]},
        "quote": {"type": "string", "minLength": 1, "maxLength": 4000}
      }
    }
  }
}
