{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mcis.local/contracts/v1/ship-reconstruction.schema.json",
  "title": "Ship reconstruction intake (draft v0.1)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "documents",
    "observations"
  ],
  "properties": {
    "version": {
      "const": "0.1"
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "sha256",
          "format",
          "kind",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "format": {
            "enum": [
              "dwg",
              "dxf",
              "pdf"
            ]
          },
          "kind": {
            "enum": [
              "lines",
              "general_arrangement",
              "basic_structure",
              "typical_section",
              "other",
              "unknown"
            ]
          },
          "status": {
            "enum": [
              "unparsed",
              "partial",
              "parsed",
              "failed"
            ]
          }
        }
      }
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "parameter",
          "value",
          "unit",
          "basis",
          "sources",
          "review"
        ],
        "properties": {
          "parameter": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": [
              "number",
              "null"
            ]
          },
          "unit": {
            "enum": [
              "m",
              "mm",
              "deg",
              "kg",
              "t",
              "m3",
              "unitless"
            ]
          },
          "basis": {
            "enum": [
              "direct",
              "calculated",
              "estimated",
              "unknown"
            ]
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "document_id",
                "locator"
              ],
              "properties": {
                "document_id": {
                  "type": "string",
                  "minLength": 1
                },
                "locator": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "review": {
            "enum": [
              "pending",
              "accepted",
              "rejected"
            ]
          },
          "method": {
            "type": "string",
            "minLength": 1
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "basis": {
                  "const": "unknown"
                }
              }
            },
            "then": {
              "properties": {
                "value": {
                  "type": "null"
                },
                "review": {
                  "const": "pending"
                }
              }
            },
            "else": {
              "properties": {
                "value": {
                  "type": "number"
                },
                "sources": {
                  "minItems": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "basis": {
                  "enum": [
                    "calculated",
                    "estimated"
                  ]
                }
              }
            },
            "then": {
              "required": [
                "method"
              ]
            }
          }
        ]
      }
    }
  }
}
