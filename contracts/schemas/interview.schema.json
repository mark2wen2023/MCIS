{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mcis.local/contracts/v1/interview.schema.json",
  "title": "InterviewRecord（询问笔录）+ Statement（陈述）+ CrossCheckResult（比对结果）",
  "description": "与 C# Mcis.Domain.Interview（W3）对齐：Interviewee / QaTurn / Statement / StatementClaim / SourceSpan / CrossCheckResult。枚举用 C# 枚举名字符串。落盘 .mcase/testimony/IR-xx.json。",
  "type": "object",
  "required": [
    "recordId",
    "caseId",
    "interviewee",
    "startUtc",
    "turns",
    "statements"
  ],
  "$defs": {
    "interviewee": {
      "type": "object",
      "required": [
        "intervieweeId",
        "name",
        "role",
        "affiliation"
      ],
      "properties": {
        "intervieweeId": {
          "type": "string"
        },
        "name": {
          "type": "string",
          "description": "个人信息：对外部角色按脱敏规则替换为角色代号"
        },
        "role": {
          "type": "string",
          "description": "职务，如 二副（OOW）"
        },
        "affiliation": {
          "type": "string"
        },
        "idNumber": {
          "type": "string",
          "description": "个人信息：除首席外全部遮盖"
        },
        "phone": {
          "type": "string",
          "description": "个人信息：除首席外全部遮盖"
        }
      },
      "additionalProperties": false
    },
    "qaTurn": {
      "type": "object",
      "required": [
        "round",
        "question",
        "answer"
      ],
      "properties": {
        "round": {
          "type": "integer",
          "minimum": 1
        },
        "question": {
          "type": "string"
        },
        "answer": {
          "type": "string"
        },
        "utc": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/utc"
            },
            {
              "type": "null"
            }
          ]
        },
        "sensitiveFragments": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "需对外遮盖的个人隐私片段（原文子串）"
        }
      },
      "additionalProperties": false
    },
    "sourceSpan": {
      "type": "object",
      "required": [
        "round",
        "field",
        "start",
        "length"
      ],
      "properties": {
        "round": {
          "type": "integer",
          "minimum": 1
        },
        "field": {
          "type": "string",
          "enum": [
            "Question",
            "Answer"
          ]
        },
        "start": {
          "type": "integer",
          "minimum": 0,
          "description": "UTF-16 下标（与 C# string 一致）"
        },
        "length": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "claim": {
      "type": "object",
      "required": [
        "valueType"
      ],
      "properties": {
        "valueType": {
          "type": "string",
          "enum": [
            "EventTime",
            "Scalar",
            "Position",
            "Occurrence"
          ]
        },
        "time": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/utc"
            },
            {
              "type": "null"
            }
          ]
        },
        "scalar": {
          "type": [
            "number",
            "null"
          ]
        },
        "unit": {
          "type": "string"
        },
        "position": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/geoCoord"
            },
            {
              "type": "null"
            }
          ]
        },
        "occurred": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "statement": {
      "type": "object",
      "required": [
        "statementId",
        "recordId",
        "kind",
        "subject",
        "summary",
        "claim",
        "span",
        "quote",
        "reviewStatus"
      ],
      "properties": {
        "statementId": {
          "type": "string"
        },
        "recordId": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "Time",
            "Position",
            "Operation",
            "Observation"
          ]
        },
        "subject": {
          "type": "string",
          "description": "数据源主题键，如 Mary.rudder_angle"
        },
        "summary": {
          "type": "string"
        },
        "claim": {
          "$ref": "#/$defs/claim"
        },
        "referenceUtc": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/utc"
            },
            {
              "type": "null"
            }
          ]
        },
        "span": {
          "$ref": "#/$defs/sourceSpan"
        },
        "quote": {
          "type": "string",
          "description": "由 span 从原文截取"
        },
        "reviewStatus": {
          "type": "string",
          "enum": [
            "Draft",
            "Confirmed",
            "Rejected",
            "Modified"
          ],
          "description": "智能体抽取为 Draft，调查员确认后生效"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "description": "陈述版本（= C# Statement.Revision）：登记为 1，每次 ModifyStatement 加 1；缺省视为 1（W5.1）"
        },
        "extractedBy": {
          "type": "string",
          "enum": [
            "Investigator",
            "Agent"
          ]
        }
      },
      "additionalProperties": false
    },
    "crossCheckResult": {
      "type": "object",
      "required": [
        "statementId",
        "recordId",
        "outcome",
        "claimedText",
        "observedText",
        "sourceLabel",
        "state"
      ],
      "properties": {
        "statementId": {
          "type": "string"
        },
        "recordId": {
          "type": "string"
        },
        "outcome": {
          "type": "string",
          "enum": [
            "Consistent",
            "Contradictory",
            "Unverifiable"
          ]
        },
        "delta": {
          "type": [
            "number",
            "null"
          ],
          "description": "陈述值 − 数据值"
        },
        "deltaUnit": {
          "type": "string"
        },
        "claimedText": {
          "type": "string"
        },
        "observedText": {
          "type": "string"
        },
        "sourceLabel": {
          "type": "string"
        },
        "rule": {
          "type": "string"
        },
        "state": {
          "type": "string",
          "enum": [
            "PendingConfirmation",
            "Confirmed",
            "Dismissed",
            "Superseded"
          ],
          "description": "CrossCheckState（= C# W3-D01）：只有 Confirmed 进入分析。Superseded（W5.1）= 已驳回的旧条目被 Resubmit 的新条目取代，只留痕不删除、不生效；Resubmit 只能从 Dismissed 发起"
        },
        "decidedBy": {
          "type": [
            "string",
            "null"
          ]
        },
        "decidedUtc": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/utc"
            },
            {
              "type": "null"
            }
          ]
        },
        "note": {
          "type": "string"
        },
        "confirmedInBatch": {
          "type": "boolean",
          "description": "CrossCheckEntry.ConfirmedInBatch：经一致项批量确认"
        },
        "statementVersion": {
          "type": "number",
          "multipleOf": 1,
          "minimum": 1,
          "description": "比对时的陈述版本（= C# CrossCheckResult.StatementVersion，取自 Statement.Revision；缺省视为 1）。与陈述当前 revision 不同即为过期结论（stale），视图须标「需重新比对」（W5.1，DEFECTS/W5.md 21:32 D01）。取值为整数（写作 number + multipleOf 1，与只区分 JSON number 的校验器兼容）"
        }
      },
      "additionalProperties": false,
      "description": "CrossCheckResult 字段 + CrossCheckEntry 的确认状态（state/decidedBy/decidedUtc/note/confirmedInBatch），与 C# CrossCheckRegister 一致：所有结论登记后均为 PendingConfirmation，须调查员确认才生效；一致项可批量确认，矛盾/无法核实逐条确认；驳回需写理由。W5.1：同一陈述可有多条记录——被重新提交取代的旧条目 state=Superseded 保留在 crossChecks 中，当前条目为该陈述最后一条非 Superseded 记录。"
    }
  },
  "properties": {
    "recordId": {
      "type": "string",
      "pattern": "^IR-[0-9]{2,}$"
    },
    "caseId": {
      "$ref": "common.schema.json#/$defs/caseId"
    },
    "interviewee": {
      "$ref": "#/$defs/interviewee"
    },
    "startUtc": {
      "$ref": "common.schema.json#/$defs/utc"
    },
    "durationMin": {
      "type": [
        "number",
        "null"
      ]
    },
    "location": {
      "type": "string"
    },
    "recorder": {
      "type": "string"
    },
    "interviewers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sourceSha256": {
      "type": "string",
      "description": "笔录原件哈希，可关联保管链证据"
    },
    "evidenceId": {
      "type": [
        "string",
        "null"
      ]
    },
    "signed": {
      "type": "boolean"
    },
    "turns": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/qaTurn"
      }
    },
    "statements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/statement"
      }
    },
    "crossChecks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/crossCheckResult"
      }
    }
  },
  "additionalProperties": false
}