{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mcis.local/contracts/v1/timeline-records-archive.schema.json",
  "title": "Bounded timeline rows for MCIS-MCASE 1.4.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "caseId",
    "events"
  ],
  "properties": {
    "format": {
      "const": "MCIS-TIMELINE-RECORDS"
    },
    "version": {
      "type": "integer",
      "const": 1
    },
    "caseId": {
      "type": "string"
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "createdUtc",
          "updatedUtc",
          "doc"
        ],
        "properties": {
          "key": {
            "type": "string"
          },
          "createdUtc": {
            "type": "string"
          },
          "updatedUtc": {
            "type": "string"
          },
          "doc": {
            "$ref": "timeline-event.schema.json"
          }
        }
      }
    }
  }
}
