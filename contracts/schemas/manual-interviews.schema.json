{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mcis.local/contracts/v1/manual-interviews.schema.json",
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "recordId": {
      "type": "string",
      "pattern": "^IR-[0-9]{2,}$",
      "maxLength": 64
    },
    "utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(19[0-9]{2}|20[0-9]{2}|2100)-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "sourceBinding": {
      "enum": [
        "none",
        "registered-metadata-only",
        "legacy-unverified"
      ]
    },
    "interviewee": {
      "type": "object",
      "properties": {
        "intervieweeId": {
          "type": "string",
          "maxLength": 200,
          "minLength": 1,
          "pattern": "\\S"
        },
        "name": {
          "type": "string",
          "maxLength": 200,
          "minLength": 1,
          "pattern": "\\S"
        },
        "role": {
          "type": "string",
          "maxLength": 200,
          "minLength": 1,
          "pattern": "\\S"
        },
        "affiliation": {
          "type": "string",
          "maxLength": 200,
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [
        "intervieweeId",
        "name",
        "role",
        "affiliation"
      ],
      "additionalProperties": false
    },
    "create": {
      "type": "object",
      "properties": {
        "requestId": {
          "$ref": "#/$defs/uuid"
        },
        "backupAcknowledged": {
          "const": true
        },
        "interviewee": {
          "$ref": "#/$defs/interviewee"
        },
        "startUtc": {
          "$ref": "#/$defs/utc"
        },
        "location": {
          "type": "string",
          "maxLength": 500
        },
        "recorder": {
          "type": "string",
          "maxLength": 500
        },
        "interviewers": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "sourceEvidenceId": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,64}$"
            }
          ]
        }
      },
      "required": [
        "requestId",
        "backupAcknowledged",
        "interviewee",
        "startUtc"
      ],
      "additionalProperties": false
    },
    "append": {
      "type": "object",
      "properties": {
        "requestId": {
          "$ref": "#/$defs/uuid"
        },
        "backupAcknowledged": {
          "const": true
        },
        "expectedDigest": {
          "$ref": "#/$defs/digest"
        },
        "question": {
          "type": "string",
          "maxLength": 16000,
          "minLength": 1,
          "pattern": "\\S"
        },
        "answer": {
          "type": "string",
          "maxLength": 16000,
          "minLength": 1,
          "pattern": "\\S"
        },
        "utc": {
          "anyOf": [
            {
              "$ref": "#/$defs/utc"
            },
            {
              "type": "null"
            }
          ]
        },
        "sensitiveFragments": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string",
            "maxLength": 16000,
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      },
      "required": [
        "requestId",
        "backupAcknowledged",
        "expectedDigest",
        "question",
        "answer"
      ],
      "additionalProperties": false
    },
    "receipt": {
      "type": "object",
      "properties": {
        "requestId": {
          "$ref": "#/$defs/uuid"
        },
        "operation": {
          "enum": [
            "create",
            "append-turn"
          ]
        },
        "recordId": {
          "$ref": "#/$defs/recordId"
        },
        "beforeDigest": {
          "anyOf": [
            {
              "$ref": "#/$defs/digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "afterDigest": {
          "$ref": "#/$defs/digest"
        },
        "turnRound": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "appliedUtc": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "requestId",
        "operation",
        "recordId",
        "beforeDigest",
        "afterDigest",
        "turnRound",
        "appliedUtc"
      ],
      "additionalProperties": false
    },
    "current": {
      "type": "object",
      "properties": {
        "profile": {
          "const": "MCIS-MANUAL-INTERVIEW-1"
        },
        "caseId": {
          "type": "string"
        },
        "identityMode": {
          "const": "local-role-header"
        },
        "sourceBinding": {
          "$ref": "#/$defs/sourceBinding"
        },
        "record": {
          "$ref": "interview.schema.json"
        },
        "documentDigest": {
          "$ref": "#/$defs/digest"
        },
        "signed": {
          "type": "boolean"
        }
      },
      "required": [
        "profile",
        "caseId",
        "identityMode",
        "sourceBinding",
        "record",
        "documentDigest",
        "signed"
      ],
      "additionalProperties": false
    },
    "response": {
      "type": "object",
      "properties": {
        "profile": {
          "const": "MCIS-MANUAL-INTERVIEW-1"
        },
        "caseId": {
          "type": "string"
        },
        "identityMode": {
          "const": "local-role-header"
        },
        "sourceBinding": {
          "$ref": "#/$defs/sourceBinding"
        },
        "receipt": {
          "$ref": "#/$defs/receipt"
        },
        "replayed": {
          "type": "boolean"
        },
        "currentDigest": {
          "$ref": "#/$defs/digest"
        }
      },
      "required": [
        "profile",
        "caseId",
        "identityMode",
        "sourceBinding",
        "receipt",
        "replayed",
        "currentDigest"
      ],
      "additionalProperties": false
    }
  }
}
