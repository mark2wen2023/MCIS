{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mcis.local/contracts/v1/knowledge-card.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "title",
    "summary",
    "body",
    "tags",
    "applicability",
    "source"
  ],
  "properties": {
    "kind": {
      "enum": [
        "Case",
        "Challenge",
        "Method"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 600
    },
    "body": {
      "type": "string",
      "minLength": 1,
      "maxLength": 6000
    },
    "applicability": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 40
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "title",
        "locator",
        "excerpt",
        "rightsNote"
      ],
      "properties": {
        "type": {
          "enum": [
            "Public",
            "Synthetic"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "locator": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "excerpt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "rightsNote": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      }
    }
  }
}
