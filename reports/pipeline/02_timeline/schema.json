{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TimelineExtraction",
  "type": "object",
  "required": ["timezoneAssumed", "events", "trackPoints", "conflicts", "gaps"],
  "properties": {
    "timezoneAssumed": { "type": "string", "description": "例如 Asia/Shanghai，正文未写时应说明推断依据" },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "time", "vesselId", "description", "category", "source"],
        "properties": {
          "id": { "type": "string" },
          "time": {
            "type": ["object", "null"],
            "properties": {
              "beijing": { "type": "string" },
              "utc": { "type": "string" },
              "approximate": { "type": "boolean" }
            }
          },
          "vesselId": { "type": ["string", "null"] },
          "description": { "type": "string" },
          "category": { "enum": ["操作", "设备", "通信", "位置", "后果", "认定"] },
          "location": { "type": ["object", "null"] },
          "courseDeg": { "type": ["number", "null"] },
          "speedKn": { "type": ["number", "null"] },
          "source": { "$ref": "../schemas/source.schema.json" }
        }
      }
    },
    "trackPoints": { "type": "array" },
    "conflicts": { "type": "array" },
    "gaps": { "type": "array", "items": { "type": "string" } }
  }
}
