{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "type":"object","required":["schema_version","inventory","tables","curves","alignment","issues","relationships","validation"],
  "$defs":{"sha":{"type":"string","pattern":"^[a-f0-9]{64}$"},"source":{"type":"object","required":["source_sha256"],"properties":{"source_sha256":{"$ref":"#/$defs/sha"}}}},
  "properties":{
    "schema_version":{"const":"2.0"},
    "inventory":{"type":"array","items":{"allOf":[{"$ref":"#/$defs/source"},{"required":["file","dxf_sha256","classes","regions"],"properties":{"dxf_sha256":{"$ref":"#/$defs/sha"},"classes":{"type":"array","uniqueItems":true,"items":{"enum":["offset_table","lines","arrangement","structure","section","capacity"]}}}}]}},
    "tables":{"type":"array","items":{"allOf":[{"$ref":"#/$defs/source"},{"required":["cells","representation","layout"],"properties":{"cells":{"type":"array","minItems":1,"items":{"type":"object","required":["station_label","field_label","group","raw_texts","handles","instances","source_wcs","row_header","field_header","value","value_m","status"],"properties":{"value":{"type":["number","null"]},"value_m":{"type":["number","null"]},"status":{"enum":["numeric","zero","blank_unknown","duplicate","conflict","non_numeric","merged_unknown","boundary_ambiguous"]}}}}}}]}},
    "curves":{"type":"array","items":{"allOf":[{"$ref":"#/$defs/source"},{"required":["handle","instance","geometry","type","kind","confidence","ship_coordinates","candidates"]}]}},
    "alignment":{"type":"array","items":{"allOf":[{"$ref":"#/$defs/source"},{"required":["frames","status"]}]}},
    "issues":{"type":"array"},"relationships":{"type":"array"},"validation":{"type":"object"}
  }
}
