 "citation": {"status": "exact", "location": true, "coordinates": "unicode_code_points", "sourceSha256": "415d9bea5d8262f4ffe69ed1b019a95caa27b8d6e8adb14749ae36836a6eca02", "start": 140, "length": 287, "quote": "   时间         航向     引航员舵令      舵角指令信号   实际反馈舵角\n2200 时 14 秒   109°    右满舵       左舵 29°   左舵 30°\n2200 时 45 秒   092°              左舵 35°   左舵 35°\n2201 时 09 秒   073°              左舵 35°   左舵 35°\n2201 时 21 秒   063°    左满舵       左舵 35°   左舵 35°\n2201 时 23 秒   062°              右舵 18°   左舵 33°", "meaning": "exact_text_location_only_not_semantic_support"}, "suggestedLabel": "insufficient", "suggestionRationale": "单行信号差异不足以判定液压故障及因果；需时序、设备检查等其他证据，不从本行给故障结论。", "suggestionStatus": "provisional_not_expert_certified", "opinions": [], "suggestedComparison": "same_provisional_label", "prediction": {"label": "insufficient", "rationale": "单行数据显示指令信号与反馈舵角不一致，但仅凭此一行无法认定原因是液压舵机故障；故障原因需额外测试或分析，本行记录不足以支持该因果结论。", "status": "external_proposed_unreviewed", "origin": "model_output_unverified", "modelIdentityVerified": false, "provenanceVerified": false}, "disagreementRecorded": false, "distinctReviewerRecords": 0, "unverifiedHumanSubmissionRecords": 0, "verifiedHumanReviewers": 0}, {"itemId": "system_normal_report", "claim": "调查报告经综合分析认定，事故发生前YANGZE 22轮操舵系统工况正常。", "sourceLocator": {"url": "https://www.sh.msa.gov.cn/u/cms/www/202505/191445221747637122775.pdf", "pdfSha256": "99084b8e672da6e2f8d9809bea25a92fe5fcf31c318554832e14339610015d7f", "pdfPage": 24, "printedPage": 22, "section": "第七节（四）结论"}, "sourceLocatorVerified": false, "citation": {"status": "exact", "location": true, "coordinates": "unicode_code_points", "sourceSha256": "eee26a474a11d788a476643415bb1eb6bb2b609f906e6fd8423712f3870d56bf", "start": 88, "length": 170, "quote": "  （四）结论。\n  本航次事故发生前，“YANGZE 22”轮操舵系统未出现\n异常和异常报警。经测试，自动舵反向报警、舵机液压锁报\n警以及操舵手轮至 MCU 单元、舵机间控制箱至舵机设备、\n舵角指令和反馈信号至 VDR 设备工作正常，无连接故障、\n异常松脱，报警正常。经综合分析，认定事故发生前\n“YANGZE 22”轮操舵系统工况正常。", "meaning": "exact_text_location_only_not_semantic_support"}, "suggestedLabel": "supported", "suggestionRationale": "保留报告归属及事故发生前范围；不是智能体独立认定全部时段正常。", "suggestionStatus": "provisional_not_expert_certified", "opinions": [], "suggestedComparison": "same_provisional_label", "prediction": {"label": "supported", "rationale": "来源结论部分明确写明'经综合分析，认定事故发生前YANGZE 22轮操舵系统工况正常'，与主张一致。", "status": "external_proposed_unreviewed", "origin": "model_output_unverified", "modelIdentityVerified": false, "provenanceVerified": false}, "disagreementRecorded": false, "distinctReviewerRecords": 0, "unverifiedHumanSubmissionRecords": 0, "verifiedHumanReviewers": 0}, {"itemId": "oil_quote_tampered", "claim": "报告认定，YANGZE 22轮泄漏燃油约171.503吨。", "sourceLocator": {"url": "https://www.sh.msa.gov.cn/u/cms/www/202505/191445221747637122775.pdf", "pdfSha256": "99084b8e672da6e2f8d9809bea25a92fe5fcf31c318554832e14339610015d7f", "pdfPage": 28, "printedPage": 26, "section": "第九节（一）溢油量认定"}, "sourceLocatorVerified": false, "citation": {"status": "not_exact", "location": false, "coordinates": "unicode_code_points", "sourceSha256": "a16617e590cfbc939bbe6344f209607fdf5cfb0a73bd0c9c5336266a9bdc2efd", "start": 434, "length": 77, "quote": "    综 上 ， “YANGZE 22” 轮 上 泄 漏 的 燃 油 量 约 为 ：\n267.197-83.4-8.5-4.244=171.503 吨。", "meaning": "exact_text_location_only_not_semantic_support"}, "suggestedLabel": null, "suggestionRationale": "引用内171.053被故意改为171.503，首先应在精确定位轴失败；不让建议语义标签替代引用核对。", "suggestionStatus": "provisional_not_expert_certified", "opinions": [], "suggestedComparison": "not_labeled", "prediction": {"label": "conflicted", "rationale": "来源写明泄漏燃油量约为171.053吨，主张却称约171.503吨，数值不符。", "status": "external_proposed_unreviewed", "origin": "model_output_unverified", "modelIdentityVerified": false, "provenanceVerified": false}, "disagreementRecorded": false, "distinctReviewerRecords": 0, "unverifiedHumanSubmissionRecords": 0, "verifiedHumanReviewers": 0}]}
